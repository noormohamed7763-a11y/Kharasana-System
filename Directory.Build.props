<Project>

  <!--
    Directory.Build.props — يُطبَّق تلقائياً على كل مشاريع الـ Solution.

    المشكلة: Microsoft.Identity.Client يجلب System.Security.Cryptography.Pkcs 9.0.4
    كـ transitive dependency، وهو يحمل ثغرتين معروفتين:
      - GHSA-2fmv-rv2c-59x7 (Moderate)
      - GHSA-846f-f764-76mx (High)

    الحل: <PackageReference Update> يُرقّي الحزمة إلى 10.0.13 (مُصلَح) في جميع
    المشاريع دون تغيير ملفات .csproj الفردية.

    المرجع: https://github.com/advisories/GHSA-846f-f764-76mx
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
