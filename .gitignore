# Visual Studio
.vs/

# Build
bin/
obj/

# Rider
.idea/

# VS Code
.vscode/

# User files
*.user
*.suo

# Secrets — env configs may contain real DB passwords & JWT keys.
# Production/Staging must be deploy-time-only, never committed.
appsettings.Production*.json
appsettings.Staging*.json

# Publish profiles — .pubxml.user stores machine-specific WebDeploy credentials
# (plaintext/encrypted password + destination connection strings), and .pubxml itself
# carries the deployment target (site URL, MSDeploy endpoint, IIS app path, user name).
# Neither belongs in the repository. Never commit.
*.pubxml
*.pubxml.user

# Logs
*.log

# Test results
TestResults/

# AppleDouble — ملفات macOS metadata
._*

# Factory uploads — صور المصانع المرفوعة (تُحفَظ محلياً فقط، لا تُرفع إلى المستودع)
# نستثني .gitkeep لنبقى المجلد موجوداً فارغاً بعد أي استنساخ جديد
Kharasana.API/wwwroot/Images/Factories/*
!Kharasana.API/wwwroot/Images/Factories/.gitkeep

# Temporary Agent & Review files
.claude/
.ua/
.kilo/
WEB_LAYER_CODE_REVIEW.md

# Documents folder
Documents/

# ملاحظة: لا تُضِف Kharasana.Tests/ هنا — المشروع مُتعقَّب في Git،
# وإضافته تُخفي أي ملف اختبار جديد بصمت فيتوقف CI عن تشغيله.