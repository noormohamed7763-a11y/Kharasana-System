{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_SERVER}; Database=${DB_NAME}; User Id=${DB_USER}; Password=${DB_PASSWORD}; Encrypt=False; MultipleActiveResultSets=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Cors": {
    "Origins": [
      "https://kharasana-api.runasp.net",
      "http://localhost:5126"
    ]
  },

  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "Kharasana.API",
    "Audience": "Kharasana.Client",
    "ExpirationInMinutes": 60
  },

  "AdminSeed": {
    "Email": "admin@kharasana.com",
    "Password": "${ADMIN_PASSWORD}"
  }
}
