@using Kharasana.Domain.Enums
@{
    var userName = ViewBag.UserName as string ?? "مستخدم";
    var userRole = ViewBag.UserRole as string ?? "";

    // ✅ اسم الدور بالعربية: `ViewBag.UserRole` يحمل مفتاح الجلسة الخام ("Admin"…)
    //    وكان يُعرض كما هو فتظهر كلمة إنجليزية في واجهة عربية. المصدر الوحيد للاسم
    //    العربي هو [Display] على UserRole (نفس نمط TransportMethod في Orders/Details)،
    //    فلا خريطة مكرّرة في الـ View. ودور غير معروف يبقى بنصّه الخام بدل أن يختفي.
    var userRoleName = Enum.TryParse<UserRole>(userRole, out var parsedRole)
        ? parsedRole.GetDisplayName()
        : userRole;

    var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م";

    // شعار المصنع (يُمرَّر من الـ Controller عبر ViewBag — يتحدَّث عند رفع/حذف الشعار)
    var factoryLogo = ViewBag.FactoryLogo as string;
    var hasFactoryLogo = !string.IsNullOrWhiteSpace(factoryLogo);
}

<nav class="navbar-top">

    <button class="navbar-toggle-btn" id="sidebarToggle" type="button" aria-label="طي القائمة الجانبية" aria-expanded="false">
        <i class="bi bi-list"></i>
    </button>

    @if (ViewData["Title"] != null)
    {
        <div class="navbar-page-title">@ViewData["Title"]</div>
    }

    <div class="navbar-user">

        <div class="navbar-user-info">
            <div class="navbar-user-name">@userName</div>
            @if (!string.IsNullOrEmpty(userRoleName))
            {
                <span class="navbar-user-role">@userRoleName</span>
            }
        </div>

        <div class="navbar-avatar">
            @* الحرف يبقى خلف الصورة كبديل تلقائي لو فشل تحميل الشعار *@
            <span class="navbar-avatar-letter">@initial</span>
            @if (hasFactoryLogo)
            {
                <img src="@factoryLogo"
                     class="navbar-avatar-img"
                     alt="شعار المصنع"
                     loading="lazy"
                     data-img-error="remove" />
            }
        </div>

    </div>

</nav>