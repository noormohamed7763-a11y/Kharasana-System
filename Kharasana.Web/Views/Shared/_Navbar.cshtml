@{
    var userName = ViewBag.UserName as string ?? "مستخدم";
    var userRole = ViewBag.UserRole as string ?? "";
    var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م";

    // شعار المصنع (يُخزَّن في الجلسة عند تسجيل الدخول ويتحدَّث عند رفع/حذف الشعار)
    var factoryLogo = Context.Session.GetString("FactoryLogo");
    var hasFactoryLogo = !string.IsNullOrWhiteSpace(factoryLogo);
}

<nav class="navbar-top">

    <button class="navbar-toggle-btn" id="sidebarToggle" type="button" aria-label="طي القائمة الجانبية" aria-expanded="false">
        <i class="bi bi-list"></i>
    </button>

    <div class="navbar-user">

        <div class="navbar-user-info">
            <div class="navbar-user-name">@userName</div>
            @if (!string.IsNullOrEmpty(userRole))
            {
                <span class="navbar-user-role">@userRole</span>
            }
        </div>

        <div class="navbar-avatar">
            @* الحرف يبقى خلف الصورة كبديل تلقائي لو فشل تحميل الشعار *@
            <span class="navbar-avatar-letter">@initial</span>
            @if (hasFactoryLogo)
            {
                <img src="@factoryLogo"
                     class="navbar-avatar-img"
                     alt="شعار المصنع"
                     loading="lazy"
                     onerror="this.remove();" />
            }
        </div>

    </div>

</nav>