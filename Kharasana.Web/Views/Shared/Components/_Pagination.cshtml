@model Kharasana.Web.ViewModels.Components.PaginationViewModel

@if (Model.TotalCount > 0)
{
    var currentPage = Model.CurrentPage;
    var pageCount = Model.TotalPages;

    <nav class="mt-4" aria-label="التنقل بين الصفحات">
        <ul class="pagination justify-content-center">
            @if (currentPage > 1)
            {
                var prevRouteData = new Dictionary<string, string>(Model.RouteValues);
                prevRouteData["pageNumber"] = (currentPage - 1).ToString();
                prevRouteData["pageSize"] = Model.PageSize.ToString();

                <li class="page-item">
                    <a class="page-link" asp-action="@Model.AspAction"
                       asp-all-route-data="prevRouteData"
                       aria-label="الصفحة السابقة">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }

            @{
                int startPage = Math.Max(1, currentPage - 2);
                int endPage = Math.Min(pageCount, currentPage + 2);

                if (startPage > 1)
                {
                    var firstRouteData = new Dictionary<string, string>(Model.RouteValues);
                    firstRouteData["pageNumber"] = "1";
                    firstRouteData["pageSize"] = Model.PageSize.ToString();

                    <li class="page-item">
                        <a class="page-link" asp-action="@Model.AspAction"
                           asp-all-route-data="firstRouteData">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                for (int p = startPage; p <= endPage; p++)
                {
                    var pRouteData = new Dictionary<string, string>(Model.RouteValues);
                    pRouteData["pageNumber"] = p.ToString();
                    pRouteData["pageSize"] = Model.PageSize.ToString();

                    <li class="page-item @(p == currentPage ? "active" : "")"
                        @(p == currentPage ? "aria-current=\"page\"" : "")>
                        <a class="page-link"
                           asp-action="@Model.AspAction"
                           asp-all-route-data="pRouteData">@p</a>
                    </li>
                }

                if (endPage < pageCount)
                {
                    if (endPage < pageCount - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    var lastRouteData = new Dictionary<string, string>(Model.RouteValues);
                    lastRouteData["pageNumber"] = pageCount.ToString();
                    lastRouteData["pageSize"] = Model.PageSize.ToString();

                    <li class="page-item">
                        <a class="page-link" asp-action="@Model.AspAction"
                           asp-all-route-data="lastRouteData">@pageCount</a>
                    </li>
                }
            }

            @if (currentPage < pageCount)
            {
                var nextRouteData = new Dictionary<string, string>(Model.RouteValues);
                nextRouteData["pageNumber"] = (currentPage + 1).ToString();
                nextRouteData["pageSize"] = Model.PageSize.ToString();

                <li class="page-item">
                    <a class="page-link" asp-action="@Model.AspAction"
                       asp-all-route-data="nextRouteData"
                       aria-label="الصفحة التالية">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="text-center text-muted mt-2 small">
        عرض @(((currentPage - 1) * Model.PageSize) + 1) - @(Math.Min(currentPage * Model.PageSize, Model.TotalCount))
        من إجمالي @Model.TotalCount طلب
    </div>
}
