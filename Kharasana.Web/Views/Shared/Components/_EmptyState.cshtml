@model Kharasana.Web.Models.Components.EmptyStateViewModel

<div class="empty-state text-center py-5">

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl"
             alt="@Model.Title"
             class="empty-state-image"
             loading="lazy"
             onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');" />
        <div class="empty-state-icon d-none">
            <i class="bi @Model.Icon"></i>
        </div>
    }
    else
    {
        <div class="empty-state-icon">
            <i class="bi @Model.Icon"></i>
        </div>
    }

    <h5 class="mt-3 fw-bold">
        @Model.Title
    </h5>

    <p class="text-muted">
        @Model.Message
    </p>

    @if (Model.ShowActionButton)
    {
        <a asp-controller="@Model.ActionController"
           asp-action="@Model.ActionAction"
           class="btn btn-primary mt-2">

            <i class="bi bi-plus-circle"></i>

            @Model.ActionText

        </a>
    }

</div>