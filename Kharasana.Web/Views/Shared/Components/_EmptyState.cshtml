@model Kharasana.Web.Models.Components.EmptyStateViewModel

<div class="empty-state text-center p-5 border rounded bg-light">

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl"
             alt="@Model.Title"
             class="empty-state-image mb-3"
             loading="lazy" />
    }
    else
    {
        <div class="empty-state-icon mb-3">
            <i class="bi @Model.Icon"></i>
        </div>
    }

    <h4 class="fw-bold text-dark">
        @Model.Title
    </h4>

    <p class="text-muted mb-4">
        @Model.Message
    </p>

    @if (Model.ShowActionButton)
    {
        <a asp-controller="@Model.ActionController"
           asp-action="@Model.ActionAction"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-1"></i>
            @Model.ActionText
        </a>
    }
</div>