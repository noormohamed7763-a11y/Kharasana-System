@model Kharasana.Web.Models.Components.PageHeaderViewModel

<div class="dashboard-header d-flex flex-wrap align-items-center justify-content-between mb-3">

    <div class="dashboard-title">
        @if (!string.IsNullOrWhiteSpace(Model.Icon))
        {
            <h1 class="fw-bold">
                <i class="bi @Model.Icon me-2"></i> @Model.Title
            </h1>
        }
        else
        {
            <h1 class="fw-bold">@Model.Title</h1>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0">@Model.Description</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ActionText) &&
        !string.IsNullOrWhiteSpace(Model.ActionController) &&
        !string.IsNullOrWhiteSpace(Model.ActionMethod))
    {
        <div>
            <a asp-controller="@Model.ActionController"
               asp-action="@Model.ActionMethod"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> @Model.ActionText
            </a>
        </div>
    }

</div>