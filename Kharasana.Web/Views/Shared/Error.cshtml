@model ErrorViewModel
@{
    Layout = null;

    var is404 = Model?.StatusCode == 404;
    var is403 = Model?.StatusCode == 403;

    var pageTitle = is404 ? "الصفحة غير موجودة" : is403 ? "غير مصرّح لك" : "حدث خطأ";
    var pageIcon = is404 ? "bi-compass" : is403 ? "bi-shield-lock" : "bi-exclamation-triangle-fill";
    var pageMessage = is404
        ? "عذراً، الصفحة التي تبحث عنها غير موجودة أو تم نقلها. تأكد من الرابط أو عد إلى الرئيسية."
        : is403
            ? "لا تملك صلاحية الوصول إلى هذه الصفحة. إذا كنت تعتقد أن هذا خطأ، تواصل مع مدير النظام."
            : "نعتذر، حدث خطأ أثناء معالجة طلبك. فريقنا يعمل على مثل هذه الحالات باستمرار، يمكنك المحاولة مجددًا أو العودة إلى الصفحة الرئيسية.";

    ViewData["Title"] = pageTitle;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Kharasana ERP | @pageTitle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/error.css" asp-append-version="true" />
</head>

<body class="error-page">
    <div class="error-card">
        <div class="error-icon @(is404 || is403 ? "error-icon-info" : "")">
            <i class="bi @pageIcon"></i>
        </div>

        <h1 class="error-title">@pageTitle</h1>

        @if (Model?.StatusCode.HasValue == true)
        {
            <div class="error-code">@Model.StatusCode</div>
        }

        <p class="error-message">
            @pageMessage
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="error-request-id">
                رقم مرجعي للدعم الفني: <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a href="/" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-house-door"></i>
                العودة إلى الرئيسية
            </a>
            @if (!is404)
            {
                <button type="button" class="btn btn-outline-secondary btn-lg px-4" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i>
                    إعادة المحاولة
                </button>
            }
        </div>
    </div>
</body>
</html>