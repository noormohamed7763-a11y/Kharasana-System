@model Kharasana.Web.Models.Factories.FactoryDetailsViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "حذف المصنع";
}

<div class="dashboard-page">

    <!-- 1. الترويسة -->
    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "حذف المصنع",
                 Description = "تأكيد عملية حذف المصنع من النظام نهائياً"
             }' />

    <!-- 2. بطاقة التأكيد -->
    <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4 border-danger-subtle">

        <!-- تنبيه خطير -->
        <div class="alert alert-danger d-flex align-items-center mb-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
            <div>
                <strong>تحذير هام!</strong> أنت على وشك حذف هذا المصنع نهائياً. لا يمكن التراجع عن هذا الإجراء بعد تأكيده.
            </div>
        </div>

        <!-- ملخص بيانات العنصر المراد حذفه مع الشعار -->
        <div class="p-4 bg-light rounded-3 border mb-4">
            <h5 class="fw-bold text-danger mb-3 border-bottom pb-2">بيانات المصنع المراد حذفه:</h5>
            <div class="row g-3">
                <div class="col-md-12 text-center mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="شعار المصنع"
                             data-name="@Model.FactoryName"
                             style="width:80px; height:80px; object-fit:cover; border-radius:50%; border:3px solid #dee2e6; background:#f8f9fa;"
                             onerror="handleLogoError(this);" />
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold rounded-circle border shadow-sm"
                             style="width:80px; height:80px; font-size:28px;">
                            @(string.IsNullOrWhiteSpace(Model.FactoryName) ? "--" : Model.FactoryName[..Math.Min(2, Model.FactoryName.Length)])
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">اسم المصنع</span>
                    <h5 class="fw-bold text-dark mt-1">@Model.FactoryName</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">المنطقة</span>
                    <h5 class="fw-bold text-dark mt-1">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">اسم المالك</span>
                    <h5 class="fw-bold text-dark mt-1">@(string.IsNullOrEmpty(Model.OwnerName) ? "-" : Model.OwnerName)</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">رقم الهاتف</span>
                    <h5 class="fw-bold text-dark mt-1" dir="ltr">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</h5>
                </div>
            </div>
        </div>

        <!-- نموذج التأكيد (ينفذ DeleteConfirmed في الكنترولر) -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.FactoryId" />

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i> تأكيد الحذف
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/factories.js" asp-append-version="true"></script>
}