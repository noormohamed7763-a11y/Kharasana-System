@model Kharasana.Web.ViewModels.Factories.FactoryDetailsViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "حذف المصنع";
}

<div class="dashboard-page dashboard-page--narrow">

    <!-- 1. الترويسة -->
    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "نقل المصنع إلى الأرشيف",
                 Description = "تأكيد نقل المصنع إلى الأرشيف وإخفاؤه من القوائم النشطة"
             }' />

    <!-- 2. بطاقة التأكيد -->
    <div class="erp-section-card border-danger-subtle">

        <!-- تنبيه: أرشفة (حذف ناعم) لا حذف نهائي — تُستعاد من صفحة الأرشيف -->
        <div class="alert alert-warning d-flex align-items-center mb-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
            <div>
                <strong>تنبيه!</strong> سيتم نقل هذا المصنع إلى الأرشيف ولن يظهر في القوائم النشطة.
                يمكنك استعادته في أي وقت من صفحة الأرشيف.
            </div>
        </div>

        <!-- ملخص بيانات العنصر المراد أرشفته مع الشعار -->
        <div class="p-4 bg-light rounded-3 border mb-4">
            <h5 class="fw-bold text-danger mb-3 border-bottom pb-2">بيانات المصنع المراد أرشفته:</h5>
            <div class="row g-3">
                <div class="col-md-12 text-center mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="شعار المصنع"
                             data-name="@Model.FactoryName"
                             class="logo-preview logo-size--md"
                              data-img-error="logo" />
                    }
                    else
                    {
                        @* fs-3 = 1.75rem = 28px، وهي القيمة التي كانت مكتوبة style مضمّناً *@
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold rounded-circle border shadow-sm fs-3 logo-size--md">
                            @(string.IsNullOrWhiteSpace(Model.FactoryName) ? "--" : Model.FactoryName[..Math.Min(2, Model.FactoryName.Length)])
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">اسم المصنع</span>
                    <h5 class="fw-bold text-dark mt-1">@Model.FactoryName</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">المنطقة</span>
                    <h5 class="fw-bold text-dark mt-1">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">اسم المالك</span>
                    <h5 class="fw-bold text-dark mt-1">@(string.IsNullOrEmpty(Model.OwnerName) ? "-" : Model.OwnerName)</h5>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block small">رقم الهاتف</span>
                    <h5 class="fw-bold text-dark mt-1" dir="ltr">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</h5>
                </div>
            </div>
        </div>

        <!-- نموذج التأكيد (ينفذ DeleteConfirmed في الكنترولر) -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.FactoryId" />

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-archive me-1"></i> نقل إلى الأرشيف
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/factories.js" asp-append-version="true"></script>
}