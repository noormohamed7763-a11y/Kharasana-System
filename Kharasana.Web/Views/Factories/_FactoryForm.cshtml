@model Kharasana.Web.Models.Factories.FactoryFormViewModel

<div class="row g-3">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <!-- 1. القسم الأول: المعلومات الأساسية -->
    <div class="col-12">
        <div class="form-section-title">
            <i class="bi bi-info-circle-fill"></i>
            <span>المعلومات الأساسية للمصنع</span>
        </div>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="FactoryName" class="form-label"></label>
        <input asp-for="FactoryName" class="form-control" placeholder="أدخل اسم المصنع الرسمي" />
        <span asp-validation-for="FactoryName" class="text-danger"></span>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="OwnerName" class="form-label"></label>
        <input asp-for="OwnerName" class="form-control" placeholder="أدخل اسم مالك المصنع أو المسؤول" />
        <span asp-validation-for="OwnerName" class="text-danger"></span>
    </div>

    <!-- 2. القسم الثاني: وسائل الاتصال -->
    <div class="col-12 mt-3">
        <div class="form-section-title">
            <i class="bi bi-headset"></i>
            <span>بيانات التواصل</span>
        </div>
    </div>

    <div class="col-xl-4 col-md-4">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control text-start" placeholder="01xxxxxx أو 7xxxxxxxx" dir="ltr" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="col-xl-4 col-md-4">
        <label asp-for="WhatsApp" class="form-label"></label>
        <input asp-for="WhatsApp" class="form-control text-start" placeholder="9677xxxxxxxx" dir="ltr" />
        <span asp-validation-for="WhatsApp" class="text-danger"></span>
    </div>

    <div class="col-xl-4 col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control text-start" placeholder="factory@domain.com" dir="ltr" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- 3. القسم الثالث: الموقع الجغرافي والعنوان -->
    <div class="col-12 mt-3">
        <div class="form-section-title">
            <i class="bi bi-geo-alt-fill"></i>
            <span>الموقع الجغرافي والعنوان</span>
        </div>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="Area" class="form-label"></label>
        <input asp-for="Area" class="form-control" placeholder="مثال: الحصبة، دار سلم، صناع..." />
        <span asp-validation-for="Area" class="text-danger"></span>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" placeholder="الشارع الرئيسي، بجوار..." />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="Latitude" class="form-label"></label>
        <input asp-for="Latitude" class="form-control text-start" placeholder="15.369411" dir="ltr" />
        <span asp-validation-for="Latitude" class="text-danger"></span>
    </div>

    <div class="col-xl-6 col-md-6">
        <label asp-for="Longitude" class="form-label"></label>
        <input asp-for="Longitude" class="form-control text-start" placeholder="44.191006" dir="ltr" />
        <span asp-validation-for="Longitude" class="text-danger"></span>
    </div>

    <!-- 4. القسم الرابع: شعار المصنع -->
    <div class="col-12 mt-3">
        <div class="form-section-title">
            <i class="bi bi-image"></i>
            <span>شعار المصنع</span>
        </div>
    </div>

    <div class="col-xl-12">
        <label asp-for="Logo" class="form-label"></label>
        <input asp-for="Logo" class="form-control text-start" placeholder="رابط أو مسار الشعار" dir="ltr" />
        <span asp-validation-for="Logo" class="text-danger"></span>
    </div>

    <!-- 5. القسم الخامس: الحالة التشغيلية -->
    <div class="col-12 mt-4 pt-3 border-top">
        <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
            <input class="form-check-input m-0" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
            <label class="form-check-label fw-bold cursor-pointer" for="isActiveSwitch">
                المصنع نشط وقيد التشغيل في النظام
            </label>
        </div>
    </div>
</div>