@model Kharasana.Web.Models.Factories.UpdateFactoryViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "تعديل بيانات المصنع";
}

<div class="dashboard-page">
    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "تعديل بيانات المصنع",
                 Description = $"تعديل بيانات المصنع: {Model.FactoryName}"
             }' />

    <!-- ✅ قسم إدارة الشعار -->
    <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-image text-primary me-2"></i>
                شعار المصنع
            </h5>
            <span class="badge bg-light text-muted">اختياري</span>
        </div>

        <div class="row g-3 align-items-end">
            <!-- معاينة الشعار الحالي -->
            <div class="col-md-3 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                {
                    <img src="@Model.Logo"
                         alt="شعار المصنع"
                         data-name="@Model.FactoryName"
                         id="logoPreview"
                         style="width:120px; height:120px; object-fit:cover; border-radius:50%; border:3px solid #dee2e6; background:#f8f9fa;"
                         onerror="handleLogoError(this);" />
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center bg-light rounded-circle border"
                         style="width:120px; height:120px; margin:0 auto;">
                        <i class="bi bi-building fs-1 text-muted"></i>
                        <span class="text-muted small mt-2">لا يوجد شعار</span>
                    </div>
                }
            </div>

            <!-- زر اختيار ملف جديد -->
            <div class="col-md-5">
                <form asp-action="UploadLogo" asp-route-id="@Model.FactoryId" method="post" enctype="multipart/form-data" id="uploadLogoForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="logoFile" class="form-label fw-bold">اختر ملف الشعار الجديد</label>
                        <input type="file"
                               class="form-control"
                               id="logoFile"
                               name="logoFile"
                               accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text text-muted small">
                            <i class="bi bi-info-circle me-1"></i>
                            الصيغ المدعومة: JPG, PNG, WEBP. الحد الأقصى: 5 ميجابايت.
                        </div>
                    </div>
                    <button type="submit"
                            class="btn btn-primary"
                            id="uploadLogoBtn"
                            disabled>
                        <i class="bi bi-upload me-1"></i>
                        رفع الشعار
                    </button>
                </form>
            </div>

            <!-- زر حذف الشعار -->
            <div class="col-md-4 text-md-end">
                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                {
                    <form asp-action="DeleteLogo" asp-route-id="@Model.FactoryId" method="post" id="deleteLogoForm">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-outline-danger"
                                onclick="return confirmDeleteLogo();">
                            <i class="bi bi-trash me-1"></i>
                            حذف الشعار الحالي
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="mt-3 text-muted small">
            <i class="bi bi-lightbulb me-1"></i>
            <span>عند رفع شعار جديد، سيتم حذف الشعار القديم تلقائياً.</span>
        </div>
    </div>

    <!-- ✅ نموذج تعديل بيانات المصنع -->
    <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FactoryId" />
            <input type="hidden" asp-for="Logo" />

            <partial name="_FactoryForm" model="Model" />

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> حفظ التعديلات
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/factories.js" asp-append-version="true"></script>
}