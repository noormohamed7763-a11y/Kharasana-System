@model Kharasana.Web.ViewModels.Factories.CreateFactoryViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إضافة مصنع جديد";
}

<div class="dashboard-page dashboard-page--narrow">
    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "إضافة مصنع جديد",
                 Description = "إدخال بيانات مصنع جديد لإضافته إلى النظام باحترافية"
             }' />

    <div class="erp-section-card shadow-sm">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <partial name="_FactoryForm" model="Model" />

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-check-circle me-1"></i> حفظ المصنع
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}