@model IEnumerable<Kharasana.Web.ViewModels.Factories.FactoryListItemViewModel>
@using Kharasana.Domain.Enums
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إدارة المصانع";

    var totalFactories = Model?.Count() ?? 0;
    var activeFactories = Model?.Count(f => f.IsActive) ?? 0;
    var inactiveFactories = totalFactories - activeFactories;
}

<div class="dashboard-page">

    <!-- 1. ترويسة الصفحة الاحترافية -->
    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "إدارة المصانع",
                 Description = "شاشة التحكم المركزية لعرض، تتبع، وإدارة جميع المصانع المسجلة في النظام.",
                 ActionText = "إضافة مصنع جديد",
                 ActionController = "Factories",
                 ActionMethod = "Create"
             }' />

    <!-- 2. بطاقات الملخصات الإحصائية (KPI Cards) -->
    <div class="summary-cards-grid mb-3">
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SummaryCard.cshtml",
        new SummaryCardViewModel
        {
            Title = "إجمالي المصانع",
            Value = totalFactories.ToString(),
            Icon = "bi-buildings",
            IconClass = "kpi-icon-primary",
            LinkUrl = Url.Action("Index", "Factories")
        })
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SummaryCard.cshtml",
        new SummaryCardViewModel
        {
            Title = "المصانع النشطة",
            Value = activeFactories.ToString(),
            Icon = "bi-building-check",
            IconClass = "kpi-icon-success",
            LinkUrl = Url.Action("Index", "Factories")
        })
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SummaryCard.cshtml",
        new SummaryCardViewModel
        {
            Title = "المصانع المتوقفة",
            Value = inactiveFactories.ToString(),
            Icon = "bi-building-dash",
            IconClass = "kpi-icon-danger",
            LinkUrl = Url.Action("Index", "Factories")
        })
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_SummaryCard.cshtml",
        new SummaryCardViewModel
        {
            Title = "معدل التشغيل",
            Value = totalFactories > 0 ? $"{(activeFactories * 100) / totalFactories}%" : "0%",
            Icon = "bi-activity",
            IconClass = "kpi-icon-info",
            LinkUrl = Url.Action("Index", "Factories")
        })
    </div>

    <!-- 3. شريط التحكم والبحث الموحد -->
    @* البحث والفلترة هنا يعملان داخل الصفحة الحالية (factories.js) لا على الخادم،
       فالبطاقة نفسها التي تستعملها صفحة أنواع الخرسانة — بلا نموذج إرسال.
       كانت البطاقة مركّبة يدوياً (`erp-toolbar` + `bg-white rounded-3 shadow-sm
       border`) وبأبعاد مكتوبة style مضمّناً على صندوق البحث. *@
    <div class="form-card mb-3 p-3">
        <div class="row g-2 align-items-center">

            <!-- أ. صندوق البحث -->
            <div class="col-lg-6">
                @{
                    var searchModel = new Kharasana.Web.Models.Components.Search.SearchBoxViewModel
                    {
                        InputId = "factorySearchInput",
                        Placeholder = "ابحث بالاسم، المالك، أو المنطقة..."
                    };
                }
                <partial name="Components/_SearchBox" model="searchModel" />
            </div>

            <!-- ب. قائمة الفلترة -->
            <div class="col-lg-3 col-md-6">
                @{
                    var filterModel = new Kharasana.Web.Models.Components.FilterDropdownViewModel
                    {
                        Id = "factoryStatusFilter",
                        OnChangeFunction = "filterByStatus",
                        Options = new List<Kharasana.Web.Models.Components.FilterOptionViewModel>
                                {
                                new() { Text = "جميع الحالات", Value = "all" },
                                new() { Text = "النشطة فقط", Value = "active" },
                                new() { Text = "المتوقفة فقط", Value = "inactive" }
                                }
                    };
                }
                <partial name="Components/_FilterDropdown" model="filterModel" />
            </div>

            <div class="col-auto ms-auto">
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    البحث والفلترة يعملان داخل الصفحة الحالية
                </span>
            </div>

        </div>
    </div>

    <!-- 4. جدول العرض الأساسي -->
    <partial name="_FactoryTable" model="Model" />

</div>

<!-- 5. Modal إنشاء حساب المصنع -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createAccountModalLabel">إنشاء حساب جديد للمصنع</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createAccountForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalFactoryId" name="FactoryId" />

                    <div class="mb-3">
                        <label for="modalFullName" class="form-label">الاسم الكامل</label>
                        <input type="text" class="form-control" id="modalFullName" name="FullName" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalEmail" class="form-label">البريد الإلكتروني</label>
                        <input type="email" class="form-control" id="modalEmail" name="Email" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalPhone" class="form-label">رقم الهاتف</label>
                        <input type="text" class="form-control" id="modalPhone" name="Phone" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalPassword" class="form-label">كلمة المرور</label>
                        <input type="password" class="form-control" id="modalPassword" name="Password" required minlength="8" />
                    </div>

                    <div class="mb-3">
                        <label for="modalConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                        <input type="password" class="form-control" id="modalConfirmPassword" name="ConfirmPassword" required minlength="8" />
                    </div>

                    @* ✅ الدور يُشتق من الـ enum لا من رقم مكتوب: كان value="1" بينما FactoryEmployee=2
                       (تغيّرت الأرقام في commit «إصلاح ثغرة Admin = 0») فكان النموذج يطلب إنشاء مدير
                       فترفضه الخدمة دائماً — أي أن إنشاء حساب المصنع كان معطلاً بالكامل. *@
                    <input type="hidden"
                           id="modalRole"
                           name="Role"
                           value="@((int)UserRole.FactoryEmployee)" />

                    <div id="modalErrorMessage" class="alert alert-danger d-none mb-3"></div>

                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-success" id="saveAccountBtn">حفظ الحساب</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/factories.js" asp-append-version="true"></script>
}