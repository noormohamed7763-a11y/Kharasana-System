@model IEnumerable<Kharasana.Web.ViewModels.Factories.FactoryListItemViewModel>
@using Kharasana.Web.Models.Components

<div class="form-card shadow-sm">
    <div class="table-responsive">
        @* بلا كلاسات Bootstrap للجداول: كان `table table-hover` و`table-light`
           يعيدان فرض خلفية رأس رمادية من Bootstrap على رأس الجدول، فتفوز على
           `--table-header-bg` في tables.css بخاصية الوراثة الأعلى — أي أن رأس هذا
           الجدول وحده كان خارج نظام الألوان. `form-card` وعناوين الجدول هنا هما
           نفس ما تستعمله بقية جداول القوائم. *@
        <table class="table table-hover align-middle erp-table erp-table--sticky-cols mb-0" id="factoriesTable">
            <thead>
                <tr>
                    <th class="col-index text-nowrap">#</th>
                    <th class="text-nowrap">الشعار</th>
                    <th class="text-nowrap">اسم المصنع</th>
                    <th class="text-nowrap">المالك</th>
                    <th class="text-nowrap">الهاتف</th>
                    <th class="text-nowrap">المنطقة</th>
                    <th class="text-nowrap">حساب المصنع</th>
                    <th class="text-nowrap">الحالة</th>
                    <th class="text-center col-actions col-actions--lg text-nowrap">الإجراءات</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    var index = 1;

                    foreach (var item in Model)
                    {
                        <tr data-status="@(item.IsActive ? "active" : "inactive")">

                            <td class="text-muted fw-bold">
                                @(index++)
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Logo))
                                {
                                    <img src="@item.Logo"
                                         alt="شعار @item.FactoryName"
                                         loading="lazy"
                                         data-name="@item.FactoryName"
                                         class="table-thumb"
                                         data-img-error="logo" />
                                }
                                else
                                {
                                    <div class="table-thumb-fallback"
                                         aria-label="شعار @item.FactoryName">
                                        @(string.IsNullOrWhiteSpace(item.FactoryName)
                                                                    ? "--"
                                                                    : item.FactoryName[..Math.Min(2, item.FactoryName.Length)])
                                    </div>
                                }
                            </td>

                            <td class="fw-bold text-dark">
                                @item.FactoryName
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.OwnerName) ? "-" : item.OwnerName)
                            </td>

                            <td dir="ltr" class="text-end">
                                @(string.IsNullOrWhiteSpace(item.Phone) ? "-" : item.Phone)
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrWhiteSpace(item.Area) ? "-" : item.Area)
                                </span>
                            </td>

                            <td>
                                @if (item.HasAccount)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        يوجد حساب
                                    </span>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-factory-id="@item.FactoryId"
                                            data-factory-name="@item.FactoryName">
                                        <i class="bi bi-person-plus"></i>
                                        إنشاء حساب
                                    </button>
                                }
                            </td>

                            <td>
                                <partial name="Components/_StatusBadge"
                                         model='new StatusBadgeViewModel
                                         {
                                             Text = item.IsActive ? "نشط" : "متوقف",
                                             CssClass = item.IsActive ? "status-success" : "status-danger"
                                         }' />
                            </td>

                            <td class="text-center">
                                <partial name="Components/_ActionButtons"
                                         model='new ActionButtonsViewModel
                                         {
                                             Id = item.FactoryId,
                                             ControllerName = "Factories",
                                             ShowDelete = true
                                         }' />
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="p-0 border-0">
                            <partial name="Components/_EmptyState"
                                     model='new EmptyStateViewModel
                                     {
                                         Title = "لا توجد مصانع مسجلة حالياً",
                                         Message = "قم بإضافة أول مصنع لبدء إدارة عمليات النظام.",
                                         ShowActionButton = true,
                                         ActionText = "إضافة مصنع جديد",
                                         ActionController = "Factories",
                                         ActionAction = "Create"
                                     }' />
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>