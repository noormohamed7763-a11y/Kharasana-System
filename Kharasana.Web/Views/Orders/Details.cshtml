@model Kharasana.Web.ViewModels.Orders.OrderDto
@using Kharasana.Domain.Enums
@using Kharasana.Domain.Common
@using Kharasana.Web.Models.Components
@using Kharasana.Web.ViewModels.Shared

@{
    ViewData["Title"] = $"تفاصيل الطلب - {Model.OrderNumber}";

    // نِسَب شريط التقدّم وألوانه من طبقة العرض الوحيدة OrderStatusExtensions
    // (كانت هنا خريطتا switch محليّتان مكرّرتان — أُلغيتا)
    var progressPercentage = Model.Status.GetProgressPercent();
    var progressColor = Model.Status.GetProgressBgClass();
    // الحركة والتخطيط للطلبات الجارية فقط — الحالات المنتهية شريط ساكن
    var progressMotion = Model.Status.GetProgressMotionClasses();

    var statusArabic = Model.Status.GetArabicName();
    var statusCssClass = Model.Status.GetCssClass();

    var factoryId = ViewBag.FactoryId ?? 0;
    var isOrderFactory = ViewBag.UserRole == Roles.FactoryEmployee && factoryId == Model.FactoryId;
    var isAdmin = ViewBag.UserRole == Roles.Admin;
    var canManage = isOrderFactory || isAdmin;

    var slabName = Enum.IsDefined(typeof(SlabType), Model.SlabType)
        ? ((SlabType)Model.SlabType).GetDisplayName()
        : "غير محدد";

    var transportName = Model.TransportMethod.GetDisplayName();

    // تجهيز رسالة ورابط واتساب لمشاركة ملخص الصبة
    var normalizedPhone = !string.IsNullOrWhiteSpace(Model.ClientPhone)
        ? YemeniPhoneHelper.Normalize(Model.ClientPhone) ?? Model.ClientPhone.Replace("+", "").Replace(" ", "").Trim()
        : string.Empty;
    var waMessage = $"*أمر صب خرسانة جاهزة - {Model.OrderNumber}*\n" +
                    $"• العميل: {Model.ClientName}\n" +
                    $"• المشروع: {Model.ProjectName ?? "-"}\n" +
                    $"• المنطقة: {Model.SiteArea ?? "-"}\n" +
                    $"• صنف الخرسانة: {Model.ConcreteTypeName}\n" +
                    $"• الكمية: {Model.Quantity} م³\n" +
                    $"• تاريخ الصب: {Model.PouringDate:yyyy-MM-dd}\n" +
                    (Model.UnitPrice.HasValue ? $"• سعر المتر: {Model.UnitPrice.Value:N0} ر.ي\n" : "") +
                    (Model.TotalPrice.HasValue ? $"• الإجمالي: {Model.TotalPrice.Value:N0} ر.ي\n" : "") +
                    $"• الحالة: {statusArabic}\n" +
                    $"شكراً لتعاملكم معنا.";
    var whatsAppSummaryUrl = string.IsNullOrWhiteSpace(normalizedPhone)
        ? $"https://wa.me/?text={Uri.EscapeDataString(waMessage)}"
        : $"https://wa.me/{normalizedPhone}?text={Uri.EscapeDataString(waMessage)}";
}

<div class="dashboard-page dashboard-page--print-ticket">

    <!-- ============================================================
    HEADER - رأس الصفحة
    ============================================================ -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>
                <i class="bi bi-clipboard-check text-primary"></i>
                تفاصيل الطلب
                <span class="order-number-chip order-number-chip--lg" title="@Model.OrderNumber">
                    <span class="order-number-seq">#@Model.OrderNumberSeq</span>
                    <span class="order-number-date">@Model.OrderNumberDate</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 ms-2 btn-copy" data-copy="@Model.OrderNumber" title="نسخ رقم الطلب" aria-label="نسخ رقم الطلب">
                    <i class="bi bi-clipboard"></i>
                </button>
            </h1>
            <p>إدارة ومتابعة الطلب من البداية إلى النهاية</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (canManage)
            {
                <a asp-action="Create" asp-route-fromOrderId="@Model.OrderId" class="btn btn-outline-success btn-lg" title="تكرار وإنشاء صبة جديدة لنفس هذا المشروع والموقع">
                    <i class="bi bi-arrow-repeat"></i> صبة جديدة لنفس الموقع
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ClientPhone))
            {
                <a href="@whatsAppSummaryUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success btn-lg" title="مشاركة ملخص أمر الصب مع العميل عبر واتساب">
                    <i class="bi bi-whatsapp"></i> مشاركة بالواتساب
                </a>
            }
            @* ✅ data-print بدل onclick="window.print()": سياسة CSP في
               SecurityHeadersMiddleware تسمح بـ script-src 'self' + nonce فقط،
               فالمعالجات المضمّنة (inline handlers) تُحجب صامتةً في المتصفح
               ويصبح الزر بلا أثر. المعالج المُفوَّض في site.js هو نفس أسلوب data-copy. *@
            <button type="button" class="btn btn-outline-primary btn-lg" data-print title="طباعة أمر التوريد والصب">
                <i class="bi bi-printer"></i> طباعة أمر التوريد
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-right"></i> العودة إلى القائمة
            </a>
        </div>
    </div>

    <!-- ============================================================
    STATUS BADGE - حالة الطلب
    ============================================================ -->
    <div class="mb-3">
        <span class="status-badge @statusCssClass fs-6 p-3">
            @statusArabic
        </span>
        <span class="text-muted ms-3">
            <i class="bi bi-clock"></i>
            آخر تحديث: @((Model.UpdatedAt ?? Model.CreatedAt).FormatDateTime())
        </span>
    </div>

    <!-- ============================================================
    PROGRESS BAR - شريط التقدم
    ============================================================ -->
    <div class="erp-section-card mb-4">
        <div class="erp-section-title">
            <i class="bi bi-graph-up-arrow"></i>
            تقدم الطلب
        </div>
        <div class="erp-section-content">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold">تقدم الطلب</span>
                <span class="fw-bold">@progressPercentage%</span>
            </div>
            <div class="progress progress--order">
                <div class="progress-bar @progressColor @progressMotion"
                     role="progressbar"
                     style="width: @progressPercentage%;"
                     aria-valuenow="@progressPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    OPERATIONAL FAST ACTION BAR - شريط الإجراءات والقرارات السريعة
    ============================================================ -->
    @if (canManage && (Model.Status == OrderStatus.New || Model.Status == OrderStatus.Pending))
    {
        <div class="alert alert-primary border-primary shadow-sm rounded-3 p-3 mb-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary text-white p-2 px-3 fs-4">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-primary">المراجعة والاعتماد الفوري لموظف المصنع</h6>
                    <span class="small text-muted">يمكنك تحديد سعر المتر واعتماد الطلب فورياً في خطوة واحدة أثناء مكالمة العميل:</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group" style="max-width: 220px;">
                    <input type="number" step="0.01" min="0.01" class="form-control fw-bold" id="quickQuotePriceInput" placeholder="سعر المتر" value="@(Model.UnitPrice > 0 ? Model.UnitPrice : "")" />
                    <span class="input-group-text bg-light small fw-bold">ر.ي/م³</span>
                </div>
                <button type="button" class="btn btn-primary fw-bold px-3 d-flex align-items-center gap-2" id="quickQuoteAndApproveBtn" data-order-id="@Model.OrderId">
                    <i class="bi bi-check2-all fs-5"></i> تسعير واعتماد فوري
                </button>
            </div>
        </div>
    }
    else if (canManage && Model.Status == OrderStatus.Approved)
    {
        <div class="alert alert-success border-success shadow-sm rounded-3 p-3 mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success text-white p-2 px-3 fs-4">
                    <i class="bi bi-truck"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-success">الطلب معتمد ومؤكد للصب!</h6>
                    <span class="small text-muted">تم الاتفاق على السعر وتأكيد الطلب. انتقل إلى لوحة العمليات والتوزيع لجدولة وتعيين شاحنات الخلاطات.</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <a asp-controller="Dispatch" asp-action="Index" class="btn btn-success fw-bold px-4">
                    <i class="bi bi-kanban me-1"></i> فتح غرفة العمليات والجدولة (Dispatch)
                </a>
            </div>
        </div>
    }

    <!-- ============================================================
    MAIN INFO - معلومات العميل والمشروع
    ============================================================ -->
    <div class="row g-3 mb-3">

        <!-- CLIENT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-person-circle text-primary"></i>
                    معلومات العميل
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">الاسم</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.ClientName ?? "غير معروف")</dd>

                        <dt class="col-sm-4 text-muted">رقم الهاتف</dt>
                        <dd class="col-sm-8" dir="ltr">
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_PhoneActions.cshtml",
                                new PhoneActionsViewModel
                                {
                                    Phone = Model.ClientPhone ?? string.Empty,
                                    // بلا اسم: البطاقة تعرض اسم العميل في السطر أعلاه
                                    ContactLabel = "العميل",
                                    Variant = PhoneActionsVariant.Outline,
                                    AlignEnd = false,
                                    WhatsAppMessage = $"السلام عليكم، بخصوص طلب الخرسانة رقم {Model.OrderNumber}"
                                })
                        </dd>

                        <dt class="col-sm-4 text-muted">عدد الطلبات</dt>
                        <dd class="col-sm-8 d-flex align-items-center gap-2">
                            <span>@(Model.ClientOrdersCount ?? 0)</span>
                            @if ((Model.ClientOrdersCount ?? 0) > 3)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>عميل مستمر</span>
                            }
                            else if ((Model.ClientOrdersCount ?? 0) <= 1)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-person-plus me-1"></i>زبون جديد</span>
                            }
                        </dd>

                        @if (Model.Notes != null && Model.Notes.Contains("[طلب سعر تفضيلي"))
                        {
                            <dt class="col-sm-4 text-warning">طلب خاص</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                    <i class="bi bi-tag-fill me-1"></i> يطلب مراعاة في السعر ("اكسبوني زبون")
                                </span>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- PROJECT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-building text-success"></i>
                    معلومات المشروع
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">اسم المشروع</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.ProjectName ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">مالك المشروع</dt>
                        <dd class="col-sm-8">@(Model.ProjectOwnerName ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">المنطقة</dt>
                        <dd class="col-sm-8 d-flex align-items-center justify-content-between">
                            <span>@(Model.SiteArea ?? "-")</span>
                            @if (!string.IsNullOrEmpty(Model.SiteArea))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-copy" data-copy="@Model.SiteArea" title="نسخ المنطقة" aria-label="نسخ منطقة الموقع">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">الوصف</dt>
                        <dd class="col-sm-8 d-flex align-items-center justify-content-between">
                            <span>@(Model.SiteDescription ?? "-")</span>
                            @if (!string.IsNullOrEmpty(Model.SiteDescription))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-copy" data-copy="@Model.SiteDescription" title="نسخ وصف الموقع" aria-label="نسخ وصف الموقع">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.SupervisorName))
                        {
                            <dt class="col-sm-4 text-muted">المشرف بالموقع</dt>
                            <dd class="col-sm-8 fw-bold">@Model.SupervisorName</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.SupervisorPhone))
                        {
                            <dt class="col-sm-4 text-muted">هاتف المشرف</dt>
                            <dd class="col-sm-8" dir="ltr">
                                @await Html.PartialAsync(
                                    "~/Views/Shared/Components/_PhoneActions.cshtml",
                                    new PhoneActionsViewModel
                                    {
                                        Phone = Model.SupervisorPhone,
                                        ContactLabel = "مشرف الموقع",
                                        Variant = PhoneActionsVariant.Outline,
                                        AlignEnd = false,
                                        WhatsAppMessage = $"السلام عليكم مهندس، بخصوص صبة طلب الخرسانة رقم {Model.OrderNumber}"
                                    })
                            </dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Landmarks))
                        {
                            <dt class="col-sm-4 text-muted">معالم بارزة</dt>
                            <dd class="col-sm-8"><i class="bi bi-pin-map text-primary me-1"></i>@Model.Landmarks</dd>
                        }

                        <dt class="col-sm-4 text-muted">نوع البلاطة</dt>
                        <dd class="col-sm-8">@slabName</dd>

                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <dt class="col-sm-4 text-muted">موقع الصب</dt>
                            <dd class="col-sm-8">
                                <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude"
                                   target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-geo-alt"></i> فتح في الخرائط
                                </a>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    CONCRETE & TRANSPORT - الخرسانة والنقل
    ============================================================ -->
    <div class="row g-3 mb-3">

        <!-- CONCRETE INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-box-seam text-warning"></i>
                    الخرسانة
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">النوع</dt>
                        <dd class="col-sm-8 fw-bold">@Model.ConcreteTypeName</dd>

                        <dt class="col-sm-4 text-muted">المقاومة</dt>
                        <dd class="col-sm-8">@Model.ConcreteStrength MPa</dd>

                        <dt class="col-sm-4 text-muted">الكمية</dt>
                        <dd class="col-sm-8">@Model.Quantity م³</dd>

                        <dt class="col-sm-4 text-muted">سعر المتر</dt>
                        <dd class="col-sm-8">@Model.UnitPrice.FormatPrice()</dd>

                        <dt class="col-sm-4 text-muted">نوع الإسمنت</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary-subtle text-secondary-emphasis">@Model.CementType.GetDisplayName()</span></dd>

                        <dt class="col-sm-4 text-muted">مقاس الكري</dt>
                        <dd class="col-sm-8">@Model.AggregateSize.GetDisplayName()</dd>

                        <dt class="col-sm-4 text-muted">الإضافات</dt>
                        <dd class="col-sm-8">@Model.Admixture.GetDisplayName()</dd>

                        <dt class="col-sm-4 text-muted">الإجمالي</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Model.TotalPrice.FormatPrice()</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- TRANSPORT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-truck text-info"></i>
                    النقل
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">طريقة النقل</dt>
                        <dd class="col-sm-8">@transportName</dd>

                        <dt class="col-sm-4 text-muted">بحاجة مضخة</dt>
                        <dd class="col-sm-8">@(Model.NeedPump ? "نعم" : "لا")</dd>

                        <dt class="col-sm-4 text-muted">رقم الطابق</dt>
                        <dd class="col-sm-8">@(Model.FloorNumber?.ToString() ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">تاريخ الصب</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-calendar3 text-muted me-1"></i>@Model.PouringDateDisplay
                            @if (Model.IsPouringDateToday)
                            {
                                <span class="badge bg-info ms-1">اليوم</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    PAYMENTS & LEDGER - الدفعات والسجل المالي
    ============================================================ -->
    <div class="erp-section-card border-info mb-3">
        <div class="erp-section-title text-info">
            <i class="bi bi-wallet2"></i>
            الدفعات والسجل المالي
        </div>
        <div class="erp-section-content">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="text-muted">صافي المبلغ</label>
                    <div class="h5">@Model.NetAmount.FormatPrice()</div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted">المبلغ المدفوع</label>
                    <div class="h5 text-success">@Model.TotalPaid.FormatPrice()</div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted">المبلغ المتبقي</label>
                    <div class="h5 text-danger">@Model.RemainingAmount.FormatPrice()</div>
                </div>
            </div>

            @if (ViewBag.UserRole == Roles.Admin || ViewBag.UserRole == Roles.FactoryEmployee)
            {
                <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                    <i class="bi bi-plus-circle"></i> تسجيل دفعة جديدة
                </button>
            }

            <!-- Print payment receipts -->
            @if (Model.Payments?.Any() == true)
            {
                <div class="table-responsive mt-3">
                    <table class="erp-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>تاريخ الدفعة</th>
                                <th>المبلغ</th>
                                <th>طريقة الدفع</th>
                                <th>المرجع</th>
                                <th class="text-center">المستند</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.Id))
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-bold">@payment.Amount.FormatPrice()</td>
                                    <td>@PaymentMethodHelper.GetArabicName(payment.PaymentMethod)</td>
                                    <td>@(string.IsNullOrWhiteSpace(payment.ReferenceNo) ? "-" : payment.ReferenceNo)</td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-outline-success btn-sm"
                                                data-print-receipt
                                                data-print-receipt-order-id="@Model.OrderId"
                                                data-print-receipt-payment-id="@payment.Id">
                                            <i class="bi bi-printer"></i> طباعة السند
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ============================================================
    PRICING - التسعير
    ============================================================ -->
    @if (((ViewBag.UserRole == Roles.FactoryEmployee && factoryId == Model.FactoryId) || ViewBag.UserRole == Roles.Admin) &&
         (Model.Status == OrderStatus.New || Model.Status == OrderStatus.Pending))
    {
        <!-- متاح للتحرير فقط في حالتي "جديد" و"قيد الانتظار" -->
        <div class="erp-section-card border-primary">
            <div class="erp-section-title text-primary">
                <i class="bi bi-currency-dollar"></i>
                التسعير
            </div>
            <div class="erp-section-content">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="unitPriceInput">سعر المتر (ر.ي)</label>
                        <input type="number"
                               id="unitPriceInput"
                               class="form-control"
                               value="@(Model.UnitPrice ?? 0)"
                               step="0.01"
                               min="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="quantityDisplay">الكمية (م³)</label>
                        <input type="text"
                               id="quantityDisplay"
                               class="form-control"
                               value="@Model.Quantity"
                               readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="totalPriceDisplay">الإجمالي (ر.ي)</label>
                        <input type="text"
                               id="totalPriceDisplay"
                               class="form-control text-primary fw-bold"
                               value="@(Model.UnitPrice.HasValue ? (Model.UnitPrice.Value * Model.Quantity).ToString("N0") : "0")"
                               readonly />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-lg" id="savePriceBtn" data-order-id="@Model.OrderId">
                        <i class="bi bi-save"></i> حفظ السعر
                    </button>
                    <span id="priceMessage" class="ms-3" role="status" aria-live="polite"></span>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- عرض قراءة فقط لبقية الحالات والأدوار -->
        <div class="erp-section-card">
            <div class="erp-section-title">
                <i class="bi bi-currency-dollar text-primary"></i>
                التسعير
            </div>
            <div class="erp-section-content">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label text-muted">سعر المتر</label>
                        <div class="fw-bold">@(Model.UnitPrice?.ToString("N0") ?? "-") ر.ي</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">الكمية</label>
                        <div class="fw-bold">@Model.Quantity م³</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">الإجمالي</label>
                        <div class="fw-bold text-primary">@(Model.TotalPrice?.ToString("N0") ?? "-") ر.ي</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================================
    ACTIONS - الإجراءات (مرتبة هرمياً) — مُقسَّم إلى Partial
    ============================================================ -->
    <div class="erp-section-card border-2 border-warning">
        <div class="erp-section-title text-warning">
            <i class="bi bi-gear"></i>
            الإجراءات
        </div>
        <div class="erp-section-content">
            @await Html.PartialAsync("~/Views/Orders/_OrderActions.cshtml", Model)
        </div>
    </div>

    <!-- ============================================================
    TIMELINE - دورة حياة الطلب — مُقسَّم إلى Partial
    ============================================================ -->
    <div class="erp-section-card">
        <div class="erp-section-title">
            <i class="bi bi-clock-history"></i>
            دورة حياة الطلب
        </div>
        <div class="erp-section-content">
            @await Html.PartialAsync("~/Views/Orders/_OrderTimeline.cshtml", Model)
        </div>
    </div>

    <!-- ============================================================
    NOTES - الملاحظات
    ============================================================ -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="erp-section-card">
            <div class="erp-section-title">
                <i class="bi bi-chat-left-text"></i>
                الملاحظات
            </div>
            <div class="erp-section-content">
                <p class="mb-0">@Model.Notes</p>
            </div>
        </div>
    }

    <!-- ============================================================
    MODAL - إضافة دفعة — مُقسَّم إلى Partial
    ============================================================ -->
    @await Html.PartialAsync("~/Views/Orders/_AddPaymentModal.cshtml", Model)

    <!-- ============================================================
    MODAL - تعيين سائق — مُقسَّم إلى Partial
    ============================================================ -->
    @await Html.PartialAsync("~/Views/Orders/_AssignDriverModal.cshtml", Model)

    <!-- ============================================================
    PRINTABLE DELIVERY TICKET - بوليصة الصب والتسليم — مُقسَّم إلى Partial
    ============================================================ -->
    @await Html.PartialAsync("~/Views/Orders/_DeliveryTicket.cshtml", Model)

</div>

<!-- ============================================================
SCRIPTS
============================================================ -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/orders.js" asp-append-version="true"></script>

    <script nonce="@ViewBag.CspNonce">
        function calculateTotal() {
            const unitPrice = parseFloat(document.getElementById('unitPriceInput')?.value) || 0;
            const quantity = Number('@Model.Quantity') || 0;
            const total = unitPrice * quantity;

            const totalDisplay = document.getElementById('totalPriceDisplay');
            if (totalDisplay) {
                totalDisplay.value = total.toLocaleString();
            }
        }

        document.getElementById('unitPriceInput')?.addEventListener('input', calculateTotal);
        document.addEventListener('DOMContentLoaded', calculateTotal);
    </script>
}
