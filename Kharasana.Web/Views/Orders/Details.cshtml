@model Kharasana.Web.ViewModels.Orders.OrderDto
@using Kharasana.Domain.Enums
@using Kharasana.Web.Models.Components
@using Kharasana.Web.ViewModels.Shared

@{
    ViewData["Title"] = $"تفاصيل الطلب - {Model.OrderNumber}";

    // نِسَب شريط التقدّم وألوانه من طبقة العرض الوحيدة OrderStatusExtensions
    // (كانت هنا خريطتا switch محليّتان مكرّرتان — أُلغيتا)
    var progressPercentage = Model.Status.GetProgressPercent();
    var progressColor = Model.Status.GetProgressBgClass();
    // الحركة والتخطيط للطلبات الجارية فقط — الحالات المنتهية شريط ساكن
    var progressMotion = Model.Status.GetProgressMotionClasses();

    var statusArabic = Model.Status.GetArabicName();
    var statusCssClass = Model.Status.GetCssClass();

    var factoryId = ViewBag.FactoryId ?? 0;

    var slabName = Enum.IsDefined(typeof(SlabType), Model.SlabType)
        ? ((SlabType)Model.SlabType).GetDisplayName()
        : "غير محدد";

    var transportName = Model.TransportMethod.GetDisplayName();
}

<div class="dashboard-page dashboard-page--print-ticket">

    <!-- ============================================================
    HEADER - رأس الصفحة
    ============================================================ -->
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>
                <i class="bi bi-clipboard-check text-primary"></i>
                تفاصيل الطلب
                <span class="order-number-chip order-number-chip--lg" title="@Model.OrderNumber">
                    <span class="order-number-seq">#@Model.OrderNumberSeq</span>
                    <span class="order-number-date">@Model.OrderNumberDate</span>
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 ms-2 btn-copy" data-copy="@Model.OrderNumber" title="نسخ رقم الطلب" aria-label="نسخ رقم الطلب">
                    <i class="bi bi-clipboard"></i>
                </button>
            </h1>
            <p>إدارة ومتابعة الطلب من البداية إلى النهاية</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @* ✅ data-print بدل onclick="window.print()": سياسة CSP في
               SecurityHeadersMiddleware تسمح بـ script-src 'self' + nonce فقط،
               فالمعالجات المضمّنة (inline handlers) تُحجب صامتةً في المتصفح
               ويصبح الزر بلا أثر. المعالج المُفوَّض في site.js هو نفس أسلوب data-copy. *@
            <button type="button" class="btn btn-outline-primary btn-lg" data-print title="طباعة بوليصة / أمر الصب والتسليم">
                <i class="bi bi-printer"></i> طباعة بوليصة الصب
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-right"></i> العودة إلى القائمة
            </a>
        </div>
    </div>

    <!-- ============================================================
    STATUS BADGE - حالة الطلب
    ============================================================ -->
    <div class="mb-3">
        <span class="status-badge @statusCssClass fs-6 p-3">
            @statusArabic
        </span>
        <span class="text-muted ms-3">
            <i class="bi bi-clock"></i>
            آخر تحديث: @((Model.UpdatedAt ?? Model.CreatedAt).FormatDateTime())
        </span>
    </div>

    <!-- ============================================================
    PROGRESS BAR - شريط التقدم
    ============================================================ -->
    <div class="erp-section-card">
        <div class="erp-section-title">
            <i class="bi bi-graph-up-arrow"></i>
            تقدم الطلب
        </div>
        <div class="erp-section-content">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-bold">تقدم الطلب</span>
                <span class="fw-bold">@progressPercentage%</span>
            </div>
            <div class="progress progress--order">
                <div class="progress-bar @progressColor @progressMotion"
                     role="progressbar"
                     style="width: @progressPercentage%;"
                     aria-valuenow="@progressPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    MAIN INFO - معلومات العميل والمشروع
    ============================================================ -->
    <div class="row g-3 mb-3">

        <!-- CLIENT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-person-circle text-primary"></i>
                    معلومات العميل
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">الاسم</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.ClientName ?? "غير معروف")</dd>

                        <dt class="col-sm-4 text-muted">رقم الهاتف</dt>
                        <dd class="col-sm-8" dir="ltr">
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_PhoneActions.cshtml",
                                new PhoneActionsViewModel
                                {
                                    Phone = Model.ClientPhone ?? string.Empty,
                                    // بلا اسم: البطاقة تعرض اسم العميل في السطر أعلاه
                                    ContactLabel = "العميل",
                                    Variant = PhoneActionsVariant.Outline,
                                    AlignEnd = false,
                                    WhatsAppMessage = $"السلام عليكم، بخصوص طلب الخرسانة رقم {Model.OrderNumber}"
                                })
                        </dd>

                        <dt class="col-sm-4 text-muted">عدد الطلبات</dt>
                        <dd class="col-sm-8">@(Model.ClientOrdersCount ?? 0)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- PROJECT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-building text-success"></i>
                    معلومات المشروع
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">اسم المشروع</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.ProjectName ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">مالك المشروع</dt>
                        <dd class="col-sm-8">@(Model.ProjectOwnerName ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">المنطقة</dt>
                        <dd class="col-sm-8 d-flex align-items-center justify-content-between">
                            <span>@(Model.SiteArea ?? "-")</span>
                            @if (!string.IsNullOrEmpty(Model.SiteArea))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-copy" data-copy="@Model.SiteArea" title="نسخ المنطقة" aria-label="نسخ منطقة الموقع">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">الوصف</dt>
                        <dd class="col-sm-8 d-flex align-items-center justify-content-between">
                            <span>@(Model.SiteDescription ?? "-")</span>
                            @if (!string.IsNullOrEmpty(Model.SiteDescription))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 btn-copy" data-copy="@Model.SiteDescription" title="نسخ وصف الموقع" aria-label="نسخ وصف الموقع">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">نوع البلاطة</dt>
                        <dd class="col-sm-8">@slabName</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    CONCRETE & TRANSPORT - الخرسانة والنقل
    ============================================================ -->
    <div class="row g-3 mb-3">

        <!-- CONCRETE INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-box-seam text-warning"></i>
                    الخرسانة
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">النوع</dt>
                        <dd class="col-sm-8 fw-bold">@Model.ConcreteTypeName</dd>

                        <dt class="col-sm-4 text-muted">المقاومة</dt>
                        <dd class="col-sm-8">@Model.ConcreteStrength MPa</dd>

                        <dt class="col-sm-4 text-muted">الكمية</dt>
                        <dd class="col-sm-8">@Model.Quantity م³</dd>

                        <dt class="col-sm-4 text-muted">سعر المتر</dt>
                        <dd class="col-sm-8">@Model.UnitPrice.FormatPrice()</dd>

                        <dt class="col-sm-4 text-muted">الإجمالي</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Model.TotalPrice.FormatPrice()</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- TRANSPORT INFO -->
        <div class="col-md-6">
            <div class="erp-section-card h-100">
                <div class="erp-section-title">
                    <i class="bi bi-truck text-info"></i>
                    النقل
                </div>
                <div class="erp-section-content">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">طريقة النقل</dt>
                        <dd class="col-sm-8">@transportName</dd>

                        <dt class="col-sm-4 text-muted">بحاجة مضخة</dt>
                        <dd class="col-sm-8">@(Model.NeedPump ? "نعم" : "لا")</dd>

                        <dt class="col-sm-4 text-muted">رقم الطابق</dt>
                        <dd class="col-sm-8">@(Model.FloorNumber?.ToString() ?? "-")</dd>

                        <dt class="col-sm-4 text-muted">تاريخ الصب</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-calendar3 text-muted me-1"></i>@Model.PouringDateDisplay
                            @if (Model.IsPouringDateToday)
                            {
                                <span class="badge bg-info ms-1">اليوم</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    PRICING - التسعير
    ============================================================ -->
    @if (((ViewBag.UserRole == Roles.FactoryEmployee && factoryId == Model.FactoryId) || ViewBag.UserRole == Roles.Admin) &&
         (Model.Status == OrderStatus.New || Model.Status == OrderStatus.Pending))
    {
        <!-- متاح للتحرير فقط في حالتي "جديد" و"قيد الانتظار" -->
        <div class="erp-section-card border-primary">
            <div class="erp-section-title text-primary">
                <i class="bi bi-currency-dollar"></i>
                التسعير
            </div>
            <div class="erp-section-content">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="unitPriceInput">سعر المتر (ر.ي)</label>
                        <input type="number"
                               id="unitPriceInput"
                               class="form-control"
                               value="@(Model.UnitPrice ?? 0)"
                               step="0.01"
                               min="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="quantityDisplay">الكمية (م³)</label>
                        <input type="text"
                               id="quantityDisplay"
                               class="form-control"
                               value="@Model.Quantity"
                               readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="totalPriceDisplay">الإجمالي (ر.ي)</label>
                        <input type="text"
                               id="totalPriceDisplay"
                               class="form-control text-primary fw-bold"
                               value="@(Model.UnitPrice.HasValue ? (Model.UnitPrice.Value * Model.Quantity).ToString("N0") : "0")"
                               readonly />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary btn-lg" id="savePriceBtn" data-order-id="@Model.OrderId">
                        <i class="bi bi-save"></i> حفظ السعر
                    </button>
                    <span id="priceMessage" class="ms-3" role="status" aria-live="polite"></span>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- عرض قراءة فقط لبقية الحالات والأدوار -->
        <div class="erp-section-card">
            <div class="erp-section-title">
                <i class="bi bi-currency-dollar text-primary"></i>
                التسعير
            </div>
            <div class="erp-section-content">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label text-muted">سعر المتر</label>
                        <div class="fw-bold">@(Model.UnitPrice?.ToString("N0") ?? "-") ر.ي</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">الكمية</label>
                        <div class="fw-bold">@Model.Quantity م³</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">الإجمالي</label>
                        <div class="fw-bold text-primary">@(Model.TotalPrice?.ToString("N0") ?? "-") ر.ي</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================================
    ACTIONS - الإجراءات (مرتبة هرمياً) — مُقسَّم إلى Partial
    ============================================================ -->
    <div class="erp-section-card border-2 border-warning">
        <div class="erp-section-title text-warning">
            <i class="bi bi-gear"></i>
            الإجراءات
        </div>
        <div class="erp-section-content">
            @await Html.PartialAsync("~/Views/Orders/_OrderActions.cshtml", Model)
        </div>
    </div>

    <!-- ============================================================
    TIMELINE - دورة حياة الطلب — مُقسَّم إلى Partial
    ============================================================ -->
    <div class="erp-section-card">
        <div class="erp-section-title">
            <i class="bi bi-clock-history"></i>
            دورة حياة الطلب
        </div>
        <div class="erp-section-content">
            @await Html.PartialAsync("~/Views/Orders/_OrderTimeline.cshtml", Model)
        </div>
    </div>

    <!-- ============================================================
    NOTES - الملاحظات
    ============================================================ -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="erp-section-card">
            <div class="erp-section-title">
                <i class="bi bi-chat-left-text"></i>
                الملاحظات
            </div>
            <div class="erp-section-content">
                <p class="mb-0">@Model.Notes</p>
            </div>
        </div>
    }

    <!-- ============================================================
    MODAL - تعيين سائق — مُقسَّم إلى Partial
    ============================================================ -->
    @await Html.PartialAsync("~/Views/Orders/_AssignDriverModal.cshtml", Model)

    <!-- ============================================================
    PRINTABLE DELIVERY TICKET - بوليصة الصب والتسليم — مُقسَّم إلى Partial
    ============================================================ -->
    @await Html.PartialAsync("~/Views/Orders/_DeliveryTicket.cshtml", Model)

</div>

<!-- ============================================================
SCRIPTS
============================================================ -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/orders.js" asp-append-version="true"></script>

    <script nonce="@ViewBag.CspNonce">
        function calculateTotal() {
            const unitPrice = parseFloat(document.getElementById('unitPriceInput')?.value) || 0;
            const quantity = Number('@Model.Quantity') || 0;
            const total = unitPrice * quantity;

            const totalDisplay = document.getElementById('totalPriceDisplay');
            if (totalDisplay) {
                totalDisplay.value = total.toLocaleString();
            }
        }

        document.getElementById('unitPriceInput')?.addEventListener('input', calculateTotal);
        document.addEventListener('DOMContentLoaded', calculateTotal);
    </script>
}
