@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel
@using Kharasana.Web.ViewModels.Shared
@using Kharasana.Web.Models.Components
@using Kharasana.Domain.Enums

@{
    ViewData["Title"] = "إنشاء طلب جديد";

    var concreteTypes = ViewBag.ConcreteTypes as List<LookupDto> ?? new List<LookupDto>();
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-plus-circle",
            Title = "إنشاء طلب جديد",
            Description = "إنشاء طلب خرسانة جديد للعميل"
        })

    <!-- ============================================================
    FORM - نموذج إنشاء الطلب لشاشات الكمبيوتر
    ============================================================ -->
    <form asp-action="Create" method="post" id="createOrderForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="row g-4 align-items-start">

            <!-- العمود الرئيسي: مدخلات النموذج وبيانات الطلب -->
            <div class="col-lg-8 col-xl-8">
                <div class="form-card">

                    <!-- ============================================================
                    1. CLIENT INFO - معلومات العميل
                    ============================================================ -->
                    <div class="form-section-title">
                <i class="bi bi-person-circle"></i>
                <span>معلومات العميل</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClientPhone" class="form-label fw-bold">
                        <i class="bi bi-telephone"></i> رقم الهاتف
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="ClientPhone" class="form-control form-control-lg" placeholder="مثال: 771234567" dir="ltr" />
                    <span asp-validation-for="ClientPhone" class="text-danger"></span>
                    <small class="text-muted">رقم هاتف العميل (إلزامي)</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ClientFullName" class="form-label fw-bold">
                        <i class="bi bi-person"></i> الاسم الكامل للعميل
                    </label>
                    <input asp-for="ClientFullName" class="form-control form-control-lg" placeholder="اختياري - يُملأ إذا كان العميل جديداً" />
                    <span asp-validation-for="ClientFullName" class="text-danger"></span>
                    <small class="text-muted">مطلوب فقط عند إنشاء عميل جديد</small>
                </div>
            </div>

            <!-- ============================================================
            2. ORDER INFO - معلومات الطلب الأساسية
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-box-seam"></i>
                <span>معلومات الطلب</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FactoryId" class="form-label fw-bold">
                        <i class="bi bi-building"></i> المصنع
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FactoryId" class="form-control form-control-lg" readonly />
                    <span asp-validation-for="FactoryId" class="text-danger"></span>
                    <small class="text-muted">يتم تحديد المصنع تلقائياً حسب حسابك</small>
                </div>

                <!-- ✅ نوع الخرسانة: اختيار من الأنواع القائمة فقط.
                     حُذف زر «إنشاء نوع مخصص» ونافذته: لم يكن لأي منهما معالج في أي ملف
                     (لا JS ولا asp-for ولا form)، فكان الزر لا يفعل شيئاً. والنوع الجديد
                     يُنشأ فعلاً من صفحة «أنواع الخرسانة» (ConcreteTypes/_CreateForm). -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ConcreteTypeId" class="form-label fw-bold">
                        <i class="bi bi-box-seam"></i> نوع الخرسانة
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="ConcreteTypeId" class="form-select form-select-lg" id="concreteTypeSelect">
                        <option value="">-- اختر نوع الخرسانة --</option>
                        @foreach (var item in concreteTypes)
                        {
                            <option value="@item.Id" data-unit-price="@item.UnitPrice">@item.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ConcreteTypeId" class="text-danger"></span>
                    <small class="text-muted">اختر النوع المطلوب من القائمة، ولإضافة نوع جديد استخدم صفحة «أنواع الخرسانة».</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Quantity" class="form-label fw-bold">
                        <i class="bi bi-rulers"></i> الكمية (م³)
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Quantity" class="form-control form-control-lg" type="number" step="0.01" min="0.1" placeholder="مثال: 25" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                    <small class="text-muted">الكمية بالمتر المكعب</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PouringDate" class="form-label fw-bold">
                        <i class="bi bi-calendar-event"></i> تاريخ الصب
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="PouringDate" class="form-control form-control-lg" type="date" />
                    <span asp-validation-for="PouringDate" class="text-danger"></span>
                    <small class="text-muted">تاريخ صب الخرسانة</small>
                </div>

                <!-- ✅ نوع البلاطة -->
                <div class="col-md-6 mb-3">
                    <label asp-for="SlabType" class="form-label fw-bold">
                        <i class="bi bi-grid"></i> نوع البلاطة
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="SlabType" class="form-select form-select-lg" asp-items="EnumHelper.GetSlabTypeSelectList()">
                    </select>
                    <span asp-validation-for="SlabType" class="text-danger"></span>
                    <small class="text-muted">اختر نوع البلاطة المناسب</small>
                </div>

                <!-- ✅ طريقة النقل - Radio Buttons محسنة -->
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">
                        <i class="bi bi-truck"></i> طريقة النقل
                        <span class="text-danger">*</span>
                    </label>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="transport-option p-3 border rounded-3 h-100">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           asp-for="TransportMethod"
                                           value="@((int)TransportMethod.FactoryTransport)"
                                           id="transportFactory" />
                                    <label class="form-check-label fw-bold" for="transportFactory">
                                        <i class="bi bi-truck text-primary fs-4 d-block"></i>
                                        <span>نقل بواسطة المصنع</span>
                                    </label>
                                    <small class="text-muted d-block">يقوم المصنع بتوفير سيارات النقل</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="transport-option p-3 border rounded-3 h-100">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           asp-for="TransportMethod"
                                           value="@((int)TransportMethod.ClientOwnTransport)"
                                           id="transportClient" />
                                    <label class="form-check-label fw-bold" for="transportClient">
                                        <i class="bi bi-car-front text-success fs-4 d-block"></i>
                                        <span>نقل ذاتي (العميل)</span>
                                    </label>
                                    <small class="text-muted d-block">العميل لديه وسيلة نقل خاصة</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="TransportMethod" class="text-danger"></span>
                </div>

                <!-- ✅ بحاجة مضخة - مع تفعيل/تعطيل رقم الطابق -->
                <div class="col-md-6 mb-3" id="pumpSection">
                    <div class="form-check form-switch mt-3 pt-2">
                        <input asp-for="NeedPump" class="form-check-input" type="checkbox" role="switch" id="needPumpSwitch" />
                        <label asp-for="NeedPump" class="form-check-label fw-bold" for="needPumpSwitch">
                            <i class="bi bi-water"></i> بحاجة مضخة
                        </label>
                        <small class="text-muted d-block">اختر إذا كان الطلب يحتاج إلى مضخة</small>
                    </div>
                </div>

                <div class="col-md-6 mb-3" id="floorNumberContainer">
                    <label asp-for="FloorNumber" class="form-label fw-bold">
                        <i class="bi bi-building"></i> رقم الطابق
                        <span class="text-danger" id="floorRequired">*</span>
                    </label>
                    <input asp-for="FloorNumber" class="form-control form-control-lg" type="number" min="0" placeholder="مثال: 6" />
                    <span asp-validation-for="FloorNumber" class="text-danger"></span>
                    <small class="text-muted">مطلوب عند اختيار مضخة</small>
                </div>
            </div>

            <!-- ============================================================
            3. PROJECT INFO - معلومات المشروع
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-building"></i>
                <span>معلومات المشروع</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectName" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> اسم المشروع
                    </label>
                    <input asp-for="ProjectName" class="form-control form-control-lg" placeholder="اسم المشروع (اختياري)" />
                    <span asp-validation-for="ProjectName" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectOwnerName" class="form-label fw-bold">
                        <i class="bi bi-person-badge"></i> اسم مالك المشروع
                    </label>
                    <input asp-for="ProjectOwnerName" class="form-control form-control-lg" placeholder="اسم المالك (اختياري)" />
                    <span asp-validation-for="ProjectOwnerName" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="SiteArea" class="form-label fw-bold">
                        <i class="bi bi-geo-alt"></i> المنطقة
                    </label>
                    <input asp-for="SiteArea" class="form-control form-control-lg" placeholder="المنطقة (اختياري)" />
                    <span asp-validation-for="SiteArea" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="SiteDescription" class="form-label fw-bold">
                        <i class="bi bi-file-text"></i> وصف الموقع
                    </label>
                    <input asp-for="SiteDescription" class="form-control form-control-lg" placeholder="وصف الموقع (اختياري)" />
                    <span asp-validation-for="SiteDescription" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>
            </div>

            <!-- ============================================================
            4. NOTES - ملاحظات
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-chat-left-text"></i>
                <span>ملاحظات إضافية</span>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label asp-for="Notes" class="form-label fw-bold">
                        <i class="bi bi-pencil"></i> ملاحظات
                    </label>
                    <textarea asp-for="Notes" rows="4" class="form-control form-control-lg" placeholder="أي ملاحظات إضافية حول الطلب..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>
            </div>

            <!-- ============================================================
            5. SUBMIT - أزرار الإرسال السفلية
            ============================================================ -->
            <div class="d-flex flex-wrap gap-3 mt-4 pt-3 border-top justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg px-4" id="submitBtn">
                        <i class="bi bi-check-circle"></i> إنشاء الطلب
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="bi bi-x-circle"></i> إلغاء
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <span class="text-muted small d-block">سعر المتر:</span>
                        <div id="selectedUnitPrice" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">الإجمالي التقديري:</span>
                        <div id="calculatedTotal" class="fw-bold text-primary fs-5">-</div>
                    </div>
                </div>
            </div>

        </div><!-- /.form-card -->
    </div><!-- /.col-lg-8 -->

    <!-- ============================================================
    DESKTOP STICKY ESTIMATOR PANEL - حاسبة وملخص التكلفة لشاشات الكمبيوتر
    ============================================================ -->
    <div class="col-lg-4 col-xl-4">
        <div class="order-estimator-sticky">
            <div class="estimator-header">
                <h5 class="estimator-title">
                    <i class="bi bi-calculator-fill"></i>
                    ملخص وتكلفة الطلب
                </h5>
                <span class="estimator-badge">حساب فوري</span>
            </div>

            <div class="estimator-body">
                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-person me-1"></i> العميل:</span>
                    <span class="estimator-value estimator-value--clamp text-truncate" id="summaryClientName">لم يُحدد بعد</span>
                </div>

                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-box-seam me-1"></i> الصنف:</span>
                    <span class="estimator-value estimator-value--clamp text-truncate" id="summaryConcreteName">-- اختر النوع --</span>
                </div>

                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-tag me-1"></i> سعر المتر:</span>
                    <span class="estimator-value" id="summaryUnitPrice">-</span>
                </div>

                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-rulers me-1"></i> الكمية:</span>
                    <span class="estimator-value" id="summaryQuantity">-</span>
                </div>

                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-truck me-1"></i> النقل:</span>
                    <span class="estimator-value" id="summaryTransport">نقل المصنع</span>
                </div>

                <div class="estimator-row">
                    <span class="estimator-label"><i class="bi bi-water me-1"></i> المضخة:</span>
                    <span class="estimator-value" id="summaryPump">لا</span>
                </div>
            </div>

            <!-- إجمالي التكلفة التقديرية للخرسانة -->
            <div class="estimator-total-box">
                <div class="estimator-total-label">تكلفة الخرسانة التقديرية</div>
                <div class="estimator-total-amount" id="summaryTotalAmount">0 <small style="font-size: 0.9rem; font-weight: normal;">ر.ي</small></div>
            </div>

            <div class="estimator-note">
                <i class="bi bi-info-circle me-1"></i>
                الحساب فوري ومبني على سعر المتر للصنف والكمية المحددة. قد تُضاف تكلفة النقل أو المضخة بالاتفاق.
            </div>

            <!-- أزرار الإجراء السريع في اللوحة الثابتة -->
            <div class="estimator-actions">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm" id="stickySubmitBtn">
                    <i class="bi bi-check-circle"></i> إنشاء الطلب الآن
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right"></i> إلغاء والعودة
                </a>
            </div>
        </div>
    </div><!-- /.col-lg-4 -->

</div><!-- /.row -->

</form>

</div><!-- /.dashboard-page -->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@ViewBag.CspNonce">
        (function () {
            const concreteSelect = document.getElementById('concreteTypeSelect');
            const qtyInput = document.querySelector('input[name="Quantity"]');
            const unitPriceEl = document.getElementById('selectedUnitPrice');
            const totalEl = document.getElementById('calculatedTotal');

            // عناصر اللوحة الثابتة لشاشات الكمبيوتر
            const summaryClientName = document.getElementById('summaryClientName');
            const summaryConcreteName = document.getElementById('summaryConcreteName');
            const summaryUnitPrice = document.getElementById('summaryUnitPrice');
            const summaryQuantity = document.getElementById('summaryQuantity');
            const summaryTransport = document.getElementById('summaryTransport');
            const summaryPump = document.getElementById('summaryPump');
            const summaryTotalAmount = document.getElementById('summaryTotalAmount');

            const clientNameInput = document.querySelector('input[name="ClientFullName"]');
            const clientPhoneInput = document.querySelector('input[name="ClientPhone"]');
            const transportRadios = document.querySelectorAll('input[name="TransportMethod"]');
            const needPumpSwitch = document.getElementById('needPumpSwitch');
            const floorNumberInput = document.querySelector('input[name="FloorNumber"]');
            const floorNumberContainer = document.getElementById('floorNumberContainer');

            function formatNumber(n) {
                if (n == null || isNaN(n) || n === 0) return '0';
                // 'en-US' عمداً: بقية التطبيق يعرض الأرقام لاتينية — عدّادات لوحة
                // المعلومات والتقارير (dashboard.js/reports.js) وأسعار الخادم كلها
                // كذلك. 'ar-EG' كانت تُخرج أرقاماً عربية-هندية (١٢٬٥٠٠) فيرى
                // المستخدم نظامين للأرقام في نفس النظام.
                return Number(n).toLocaleString('en-US', { maximumFractionDigits: 2 });
            }

            function recalc() {
                // 1. النوع والسعر والكمية
                const sel = concreteSelect ? concreteSelect.options[concreteSelect.selectedIndex] : null;
                const hasConcrete = sel && sel.value !== "";
                const concreteName = hasConcrete ? sel.text : 'لم يُحدد';
                const unit = hasConcrete ? parseFloat(sel.dataset.unitPrice || '0') : 0;
                const qty = qtyInput ? parseFloat(qtyInput.value || '0') : 0;

                const formattedUnit = unit > 0 ? formatNumber(unit) + ' ر.ي' : '-';
                const total = unit * qty;
                const formattedTotal = total > 0 ? formatNumber(total) + ' ر.ي' : '-';

                // الشريط السفلي
                if (unitPriceEl) unitPriceEl.textContent = formattedUnit;
                if (totalEl) totalEl.textContent = formattedTotal;

                // اللوحة الثابتة الجانبية
                if (summaryConcreteName) summaryConcreteName.textContent = concreteName;
                if (summaryUnitPrice) summaryUnitPrice.textContent = formattedUnit;
                if (summaryQuantity) summaryQuantity.textContent = qty > 0 ? qty + ' م³' : '-';
                if (summaryTotalAmount) {
                    summaryTotalAmount.innerHTML = (total > 0 ? formatNumber(total) : '0') + ' <small style="font-size:0.9rem; font-weight:normal;">ر.ي</small>';
                }

                // 2. العميل
                const cName = clientNameInput ? clientNameInput.value.trim() : '';
                const cPhone = clientPhoneInput ? clientPhoneInput.value.trim() : '';
                if (summaryClientName) {
                    if (cName) {
                        summaryClientName.textContent = cName;
                    } else if (cPhone) {
                        summaryClientName.textContent = cPhone;
                    } else {
                        summaryClientName.textContent = 'لم يُحدد بعد';
                    }
                }

                // 3. النقل
                let transportText = 'نقل المصنع';
                transportRadios.forEach(r => {
                    if (r.checked) {
                        transportText = r.value === '1' ? 'نقل المصنع' : 'نقل ذاتي';
                    }
                });
                if (summaryTransport) summaryTransport.textContent = transportText;

                // 4. المضخة والطابق
                const needPump = needPumpSwitch ? needPumpSwitch.checked : false;
                if (floorNumberContainer) {
                    floorNumberContainer.style.opacity = needPump ? '1' : '0.45';
                    if (!needPump && floorNumberInput) {
                        floorNumberInput.setAttribute('disabled', 'disabled');
                    } else if (floorNumberInput) {
                        floorNumberInput.removeAttribute('disabled');
                    }
                }
                if (summaryPump) {
                    if (needPump) {
                        const floor = floorNumberInput && floorNumberInput.value ? ' (طابق ' + floorNumberInput.value + ')' : '';
                        summaryPump.textContent = 'نعم' + floor;
                    } else {
                        summaryPump.textContent = 'لا';
                    }
                }
            }

            concreteSelect?.addEventListener('change', recalc);
            qtyInput?.addEventListener('input', recalc);
            clientNameInput?.addEventListener('input', recalc);
            clientPhoneInput?.addEventListener('input', recalc);
            needPumpSwitch?.addEventListener('change', recalc);
            floorNumberInput?.addEventListener('input', recalc);
            transportRadios.forEach(r => r.addEventListener('change', recalc));

            document.addEventListener('DOMContentLoaded', recalc);
            recalc();
        })();
    </script>
}