@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel
@using Kharasana.Web.ViewModels.Shared
@using Kharasana.Web.Models.Components
@using Kharasana.Domain.Enums

@{
    ViewData["Title"] = "إنشاء طلب جديد";

    var concreteTypes = ViewBag.ConcreteTypes as List<LookupDto> ?? new List<LookupDto>();
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-plus-circle",
            Title = "إنشاء طلب جديد",
            Description = "إنشاء طلب خرسانة جديد للعميل"
        })

    <!-- ============================================================
    FORM - نموذج إنشاء الطلب
    ============================================================ -->
    <div class="form-card">
        <form asp-action="Create" method="post" id="createOrderForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <!-- ============================================================
            1. CLIENT INFO - معلومات العميل
            ============================================================ -->
            <div class="form-section-title">
                <i class="bi bi-person-circle"></i>
                <span>معلومات العميل</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClientPhone" class="form-label fw-bold">
                        <i class="bi bi-telephone"></i> رقم الهاتف
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="ClientPhone" class="form-control form-control-lg" placeholder="مثال: 771234567" dir="ltr" />
                    <span asp-validation-for="ClientPhone" class="text-danger"></span>
                    <small class="text-muted">رقم هاتف العميل (إلزامي)</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ClientFullName" class="form-label fw-bold">
                        <i class="bi bi-person"></i> الاسم الكامل للعميل
                    </label>
                    <input asp-for="ClientFullName" class="form-control form-control-lg" placeholder="اختياري - يُملأ إذا كان العميل جديداً" />
                    <span asp-validation-for="ClientFullName" class="text-danger"></span>
                    <small class="text-muted">مطلوب فقط عند إنشاء عميل جديد</small>
                </div>
            </div>

            <!-- ============================================================
            2. ORDER INFO - معلومات الطلب الأساسية
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-box-seam"></i>
                <span>معلومات الطلب</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FactoryId" class="form-label fw-bold">
                        <i class="bi bi-building"></i> المصنع
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FactoryId" class="form-control form-control-lg" readonly />
                    <span asp-validation-for="FactoryId" class="text-danger"></span>
                    <small class="text-muted">يتم تحديد المصنع تلقائياً حسب حسابك</small>
                </div>

                <!-- ✅ نوع الخرسانة مع زر إضافة -->
                <div class="col-md-6 mb-3">
                    <label asp-for="ConcreteTypeId" class="form-label fw-bold">
                        <i class="bi bi-box-seam"></i> نوع الخرسانة
                        <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-2">
                        <select asp-for="ConcreteTypeId" class="form-select form-select-lg" id="concreteTypeSelect">
                            <option value="">-- اختر نوع الخرسانة --</option>
                            @foreach (var item in concreteTypes)
                            {
                                <option value="@item.Id" data-unit-price="@item.UnitPrice">@item.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-primary btn-lg"
                                data-bs-toggle="modal" data-bs-target="#customConcreteModal"
                                title="إنشاء نوع خرسانة مخصص">
                            <i class="bi bi-plus-circle"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConcreteTypeId" class="text-danger"></span>
                    <small class="text-muted">اختر نوع الخرسانة المطلوب أو أضف نوعاً مخصصاً</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Quantity" class="form-label fw-bold">
                        <i class="bi bi-rulers"></i> الكمية (م³)
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Quantity" class="form-control form-control-lg" type="number" step="0.01" min="0.1" placeholder="مثال: 25" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                    <small class="text-muted">الكمية بالمتر المكعب</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PouringDate" class="form-label fw-bold">
                        <i class="bi bi-calendar-event"></i> تاريخ الصب
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="PouringDate" class="form-control form-control-lg" type="date" />
                    <span asp-validation-for="PouringDate" class="text-danger"></span>
                    <small class="text-muted">تاريخ صب الخرسانة</small>
                </div>

                <!-- ✅ نوع البلاطة -->
                <div class="col-md-6 mb-3">
                    <label asp-for="SlabType" class="form-label fw-bold">
                        <i class="bi bi-grid"></i> نوع البلاطة
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="SlabType" class="form-select form-select-lg">
                        <option value="">-- اختر نوع البلاطة --</option>
                        <option value="@((int)SlabType.Foundation)">أساسات</option>
                        <option value="@((int)SlabType.Columns)">أعمدة</option>
                        <option value="@((int)SlabType.Beams)">كمرات</option>
                        <option value="@((int)SlabType.Roof)">سقف</option>
                        <option value="@((int)SlabType.Other)">أخرى</option>
                    </select>
                    <span asp-validation-for="SlabType" class="text-danger"></span>
                    <small class="text-muted">اختر نوع البلاطة المناسب</small>
                </div>

                <!-- ✅ طريقة النقل - Radio Buttons محسنة -->
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">
                        <i class="bi bi-truck"></i> طريقة النقل
                        <span class="text-danger">*</span>
                    </label>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="transport-option p-3 border rounded-3 h-100">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           asp-for="TransportMethod"
                                           value="@((int)TransportMethod.FactoryTransport)"
                                           id="transportFactory" />
                                    <label class="form-check-label fw-bold" for="transportFactory">
                                        <i class="bi bi-truck text-primary fs-4 d-block"></i>
                                        <span>نقل بواسطة المصنع</span>
                                    </label>
                                    <small class="text-muted d-block">يقوم المصنع بتوفير سيارات النقل</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="transport-option p-3 border rounded-3 h-100">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           asp-for="TransportMethod"
                                           value="@((int)TransportMethod.ClientOwnTransport)"
                                           id="transportClient" />
                                    <label class="form-check-label fw-bold" for="transportClient">
                                        <i class="bi bi-car-front text-success fs-4 d-block"></i>
                                        <span>نقل ذاتي (العميل)</span>
                                    </label>
                                    <small class="text-muted d-block">العميل لديه وسيلة نقل خاصة</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <span asp-validation-for="TransportMethod" class="text-danger"></span>
                </div>

                <!-- ✅ بحاجة مضخة - مع تفعيل/تعطيل رقم الطابق -->
                <div class="col-md-6 mb-3" id="pumpSection">
                    <div class="form-check form-switch mt-3 pt-2">
                        <input asp-for="NeedPump" class="form-check-input" type="checkbox" role="switch" id="needPumpSwitch" />
                        <label asp-for="NeedPump" class="form-check-label fw-bold" for="needPumpSwitch">
                            <i class="bi bi-water"></i> بحاجة مضخة
                        </label>
                        <small class="text-muted d-block">اختر إذا كان الطلب يحتاج إلى مضخة</small>
                    </div>
                </div>

                <div class="col-md-6 mb-3" id="floorNumberContainer">
                    <label asp-for="FloorNumber" class="form-label fw-bold">
                        <i class="bi bi-building"></i> رقم الطابق
                        <span class="text-danger" id="floorRequired">*</span>
                    </label>
                    <input asp-for="FloorNumber" class="form-control form-control-lg" type="number" min="0" placeholder="مثال: 6" />
                    <span asp-validation-for="FloorNumber" class="text-danger"></span>
                    <small class="text-muted">مطلوب عند اختيار مضخة</small>
                </div>
            </div>

            <!-- ============================================================
            3. PROJECT INFO - معلومات المشروع
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-building"></i>
                <span>معلومات المشروع</span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectName" class="form-label fw-bold">
                        <i class="bi bi-tag"></i> اسم المشروع
                    </label>
                    <input asp-for="ProjectName" class="form-control form-control-lg" placeholder="اسم المشروع (اختياري)" />
                    <span asp-validation-for="ProjectName" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ProjectOwnerName" class="form-label fw-bold">
                        <i class="bi bi-person-badge"></i> اسم مالك المشروع
                    </label>
                    <input asp-for="ProjectOwnerName" class="form-control form-control-lg" placeholder="اسم المالك (اختياري)" />
                    <span asp-validation-for="ProjectOwnerName" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="SiteArea" class="form-label fw-bold">
                        <i class="bi bi-geo-alt"></i> المنطقة
                    </label>
                    <input asp-for="SiteArea" class="form-control form-control-lg" placeholder="المنطقة (اختياري)" />
                    <span asp-validation-for="SiteArea" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="SiteDescription" class="form-label fw-bold">
                        <i class="bi bi-file-text"></i> وصف الموقع
                    </label>
                    <input asp-for="SiteDescription" class="form-control form-control-lg" placeholder="وصف الموقع (اختياري)" />
                    <span asp-validation-for="SiteDescription" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>
            </div>

            <!-- ============================================================
            4. NOTES - ملاحظات
            ============================================================ -->
            <div class="form-section-title mt-3">
                <i class="bi bi-chat-left-text"></i>
                <span>ملاحظات إضافية</span>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label asp-for="Notes" class="form-label fw-bold">
                        <i class="bi bi-pencil"></i> ملاحظات
                    </label>
                    <textarea asp-for="Notes" rows="4" class="form-control form-control-lg" placeholder="أي ملاحظات إضافية حول الطلب..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                    <small class="text-muted">حقل اختياري</small>
                </div>
            </div>

            <!-- ============================================================
            5. SUBMIT - أزرار الإرسال
            ============================================================ -->
            <div class="d-flex flex-wrap gap-3 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary btn-lg px-5" id="submitBtn">
                    <i class="bi bi-check-circle"></i> إنشاء الطلب
                </button>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <div>
                        <label class="form-label text-muted mb-0">سعر المتر</label>
                        <div id="selectedUnitPrice" class="fw-bold">-</div>
                    </div>
                    <div>
                        <label class="form-label text-muted mb-0">الإجمالي المتوقع</label>
                        <div id="calculatedTotal" class="fw-bold text-primary">-</div>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                    <i class="bi bi-x-circle"></i> إلغاء
                </a>
            </div>

        </form>
    </div>

</div>

<!-- ============================================================
MODAL - إنشاء نوع خرسانة مخصص
============================================================ -->
<div class="modal fade" id="customConcreteModal" tabindex="-1" aria-labelledby="customConcreteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="customConcreteModalLabel">
                    <i class="bi bi-plus-circle"></i> إنشاء نوع خرسانة مخصص
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="customConcreteMessage" class="alert d-none"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        اسم النوع <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="customConcreteName" class="form-control form-control-lg"
                           placeholder="مثال: خرسانة مقاومة للأملاح" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        المقاومة (MPa) <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="customConcreteStrength" class="form-control form-control-lg"
                           placeholder="مثال: 35" min="1" max="100" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <textarea id="customConcreteDescription" class="form-control" rows="3"
                              placeholder="أي ملاحظات إضافية عن النوع المطلوب..."></textarea>
                </div>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    سيتم إرسال طلبك إلى المصنع لمراجعته. سيتم إشعارك عند اعتماد النوع.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-lg" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> إلغاء
                </button>
                <button type="button" class="btn btn-primary btn-lg" id="saveCustomConcreteBtn">
                    <i class="bi bi-save"></i> حفظ وإضافة
                </button>
            </div>
        </div>
    </div>
</div>

<!-- تم نقل تنسيقات هذه الصفحة إلى wwwroot/css/orders.css (ملف مركزي موحّد) -->
@section Scripts {
    <script>
        (function(){
            const concreteSelect = document.getElementById('concreteTypeSelect');
            const qtyInput = document.querySelector('input[name="Quantity"]');
            const unitPriceEl = document.getElementById('selectedUnitPrice');
            const totalEl = document.getElementById('calculatedTotal');

            function formatNumber(n){
                if (n == null) return '-';
                return Number(n).toLocaleString(undefined, {maximumFractionDigits:2});
            }

            function recalc(){
                const sel = concreteSelect.options[concreteSelect.selectedIndex];
                const unit = sel ? parseFloat(sel.dataset.unitPrice || '0') : 0;
                const qty = qtyInput ? parseFloat(qtyInput.value || '0') : 0;
                unitPriceEl.textContent = unit > 0 ? formatNumber(unit) + ' ر.ي' : '-';
                const total = unit * qty;
                totalEl.textContent = total > 0 ? formatNumber(total) + ' ر.ي' : '-';
            }

            concreteSelect?.addEventListener('change', recalc);
            qtyInput?.addEventListener('input', recalc);
            document.addEventListener('DOMContentLoaded', recalc);
        })();
    </script>
}