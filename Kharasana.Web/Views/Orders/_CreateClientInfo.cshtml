@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel

<!-- ============================================================
1. CLIENT INFO - بطاقة معلومات العميل
============================================================ -->
<div class="card border-0 shadow-sm rounded-3 mb-4 order-form-card">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary rounded-circle p-2 px-3 fw-bold">1</span>
            <h6 class="mb-0 fw-bold text-dark fs-6">
                <i class="bi bi-person-circle text-primary me-1"></i> معلومات العميل والاتصال
            </h6>
        </div>
        <span class="badge bg-light text-secondary border">بيانات الاتصال</span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ClientPhone" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-telephone text-primary me-1"></i> رقم هاتف العميل
                    <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="ClientPhone" class="form-control form-control-lg fs-6" placeholder="مثال: 771234567" dir="ltr" autocomplete="tel" />
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-phone"></i></span>
                </div>
                <span asp-validation-for="ClientPhone" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">يُستخدم للبحث الفوري عن حساب العميل وتأكيد الطلب</small>
            </div>

            <div class="col-md-6">
                <label asp-for="ClientFullName" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-person text-primary me-1"></i> الاسم الكامل للعميل
                </label>
                <div class="input-group">
                    <input asp-for="ClientFullName" class="form-control form-control-lg fs-6" placeholder="اختياري - يُملأ إذا كان العميل جديداً" />
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                </div>
                <span asp-validation-for="ClientFullName" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">مطلوب فقط عند إنشاء حساب لعميل جديد لأول مرة</small>
            </div>
        </div>
    </div>
</div>
