@model Kharasana.Web.ViewModels.Orders.OrdersIndexViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Domain.Enums
@using Kharasana.Web.Helpers
@using Kharasana.Web.ViewModels.Components

@{
    ViewData["Title"] = "إدارة الطلبات";
    var totalOrders = Model.PagedOrders?.TotalCount ?? 0;

    var completedCount = Model.ClosedCount;
    var cancelledCount = Model.CancelledCount + Model.RejectedCount;
}

<div class="dashboard-page">

    <!-- PAGE HEADER -->
    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-box-seam",
            Title = "إدارة الطلبات",
            Description = "إدارة ومتابعة جميع طلبات الخرسانة داخل النظام.",
            ActionText = "طلب جديد",
            ActionController = "Orders",
            ActionMethod = "Create"
        })

    <!-- SUMMARY CARDS (قابلة للنقر → قائمة الطلبات مفيتَرة بالحالة) -->
    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
            "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي الطلبات",
                            Value = totalOrders.ToString(),
                            Icon = "bi-box-seam",
                            IconClass = "kpi-icon-primary",
                            LinkUrl = Url.Action("Index", "Orders")
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "قيد الانتظار",
                            Value = Model.PendingCount.ToString(),
                            Icon = "bi-hourglass-split",
                            IconClass = "kpi-icon-warning",
                            LinkUrl = Url.Action("Index", "Orders", new { status = (int)OrderStatus.Pending })
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "مكتملة",
                            Value = completedCount.ToString(),
                            Icon = "bi-check-circle",
                            IconClass = "kpi-icon-success",
                            LinkUrl = Url.Action("Index", "Orders", new { status = (int)OrderStatus.Closed })
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "ملغاة/مرفوضة",
                            Value = cancelledCount.ToString(),
                            Icon = "bi-x-circle",
                            IconClass = "kpi-icon-danger",
                            LinkUrl = Url.Action("Index", "Orders", new { status = (int)OrderStatus.Cancelled })
                        })
    </div>

    <!-- UNIFIED DESKTOP ERP TOOLBAR & FILTERS -->
    @{
        var showFactoryFilter = ViewBag.ShowFactoryFilter == true;

        // فلتر الحالة: القائمة تحمل name="status" فتُرسل مع النموذج مباشرة.
        // سابقاً كانت القائمة بلا name، ويُنسخ اختيارها إلى حقل مخفي بدالة JS
        // (applyFilters) ثم يُرسل النموذج — أي مساران لقيمة واحدة يفترقان بأول تعديل.
        var statusFilter = new ListToolbarFilterViewModel
        {
            Id = "statusFilter",
            Name = "status",
            AriaLabel = "تصفية حسب حالة الطلب",
            ColumnClass = "col-xl-3 col-lg-3",
            EmptyOptionText = "جميع الحالات"
        };
        foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
        {
            statusFilter.Options.Add(new ListToolbarOptionViewModel
            {
                Value = ((int)status).ToString(),
                Text = status.GetArabicName(),
                Selected = Model.StatusFilter.HasValue && Model.StatusFilter.Value == (int)status
            });
        }

        var toolbarFilters = new List<ListToolbarFilterViewModel> { statusFilter };

        if (showFactoryFilter)
        {
            var factoryFilter = new ListToolbarFilterViewModel
            {
                Id = "factoryFilter",
                Name = "factoryId",
                AriaLabel = "تصفية حسب المصنع",
                ColumnClass = "col-xl-2 col-lg-2",
                EmptyOptionText = "جميع المصانع"
            };

            var factories = ViewBag.Factories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                            ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

            foreach (var factory in factories)
            {
                factoryFilter.Options.Add(new ListToolbarOptionViewModel
                {
                    Value = factory.Value ?? string.Empty,
                    Text = factory.Text ?? string.Empty,
                    Selected = Model.FactoryIdFilter.HasValue && Model.FactoryIdFilter.Value.ToString() == factory.Value
                });
            }

            toolbarFilters.Add(factoryFilter);
        }

        var toolbar = new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            // للأدمن ثلاثة أعمدة فلترة فيضيق عمود البحث، ولغيره عمودان
            SearchColumnClass = showFactoryFilter ? "col-xl-4 col-lg-3" : "col-xl-5 col-lg-4",
            ActionsColumnClass = showFactoryFilter ? "col-xl-3 col-lg-4" : "col-xl-4 col-lg-5",
            Filters = toolbarFilters,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث بالاسم، رقم الطلب، أو رقم الهاتف...",
                Value = Model.Search ?? string.Empty
            }
        };
    }

    @await Html.PartialAsync("~/Views/Shared/Components/_ListToolbar.cshtml", toolbar)

    <!-- ORDERS TABLE -->
    @if (Model.PagedOrders == null || !Model.PagedOrders.Items.Any())
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_EmptyState.cshtml",
        new EmptyStateViewModel
        {
            ImageUrl = "/images/empty-orders.png",
            Title = "لا توجد طلبات لعرضها",
            Message = "قم بإنشاء طلب جديد للبدء",
            ShowActionButton = true,
            ActionController = "Orders",
            ActionAction = "Create",
            ActionText = "إنشاء طلب جديد"
        })
    }
    else
    {
        <div class="form-card">
            <div class="table-responsive">
                @Html.AntiForgeryToken()
                <table class="erp-table erp-table--sticky-head" id="ordersTable">
                    <caption class="visually-hidden">قائمة طلبات الخرسانة — الرقم، العميل، النوع، الكمية، السعر، الحالة، السائق</caption>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th class="text-nowrap">رقم الطلب</th>
                            <th class="text-nowrap">العميل</th>
                            <th class="text-nowrap">نوع الخرسانة</th>
                            <th class="text-nowrap">الكمية</th>
                            <th class="text-nowrap">السعر</th>
                            <th class="text-nowrap">الحالة</th>
                            <th class="text-nowrap">السائق</th>
                            <th class="text-nowrap">تاريخ الصب</th>
                            <th class="text-center text-nowrap">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var order in Model.PagedOrders.Items)
                        {
                            var statusClass = order.Status.GetCssClass();
                            var statusText = order.Status.GetArabicName();

                            <tr id="order-@order.OrderId">
                                <td class="text-muted fw-bold">@(index++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@order.OrderId"
                                           class="order-number-chip" title="@order.OrderNumber">
                                            <span class="order-number-seq">#@order.OrderNumberSeq</span>
                                            <span class="order-number-date">@order.OrderNumberDate</span>
                                        </a>
                                        <button type="button" class="btn btn-link p-0 text-muted btn-copy" data-copy="@order.OrderNumber" title="نسخ رقم الطلب" aria-label="نسخ رقم الطلب @order.OrderNumber">
                                            <i class="bi bi-clipboard small"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@order.ClientName</div>
                                    @if (!string.IsNullOrEmpty(order.ClientPhone))
                                    {
                                        <small class="text-muted" dir="ltr">@order.ClientPhone</small>
                                    }
                                </td>
                                <td>@order.ConcreteTypeName</td>
                                <td><span class="fw-bold">@order.Quantity</span> <small class="text-muted">م³</small></td>
                                <td><span class="text-primary fw-bold">@order.TotalPrice.FormatPrice()</span></td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="driver-name">
                                    @(string.IsNullOrWhiteSpace(order.DriverName) ? "-" : order.DriverName)
                                </td>
                                <td>
                                    <i class="bi bi-calendar3 text-muted me-1"></i>@order.PouringDateDisplay
                                    @if (order.IsPouringDateToday)
                                    {
                                        <span class="badge bg-info ms-1">اليوم</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @* إجراءات سريعة - مشغلة من orders.js عبر data-action *@
                                    @* الدور يُقرأ من الجلسة عبر ViewBag (لا يوجد ClaimsPrincipal في هذا التطبيق) *@
                                    @if (order.Status == OrderStatus.Pending &&
                                         (ViewBag.UserRole == Roles.Admin || ViewBag.UserRole == Roles.FactoryEmployee))
                                    {
                                        <button type="button" class="btn btn-light border text-success"
                                                data-action="approve" data-order-id="@order.OrderId"
                                                data-confirm="هل أنت متأكد من موافقة العميل على هذا الطلب؟"
                                                aria-label="اعتماد الطلب" data-bs-toggle="tooltip">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    }
                                    @if (order.Status is OrderStatus.New or OrderStatus.Pending)
                                    {
                                        <button type="button" class="btn btn-light border text-warning"
                                                data-action="cancel" data-order-id="@order.OrderId"
                                                data-confirm="⚠️ هل أنت متأكد من إلغاء هذا الطلب؟"
                                                aria-label="إلغاء الطلب" data-bs-toggle="tooltip">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                    @await Html.PartialAsync(
                                        "~/Views/Shared/Components/_ActionButtons.cshtml",
                                        new ActionButtonsViewModel
                                        {
                                            Id = order.OrderId,
                                            ControllerName = "Orders",
                                            ShowDetails = true,
                                            ShowEdit = order.Status == OrderStatus.New || order.Status == OrderStatus.Pending,
                                            ShowDelete = ViewBag.UserRole == Roles.Admin && (order.Status == OrderStatus.New || order.Status == OrderStatus.Pending)
                                        })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- PAGINATION -->
    @await Html.PartialAsync("~/Views/Shared/Components/_Pagination.cshtml", new PaginationViewModel
    {
        CurrentPage = Model.PageNumber,
        TotalPages = (int)Math.Ceiling(Model.PagedOrders.TotalCount / (double)Model.PageSize),
        PageSize = Model.PageSize,
        TotalCount = Model.PagedOrders.TotalCount,
        RouteValues = new Dictionary<string, string>
        {
            { "search", Model.Search ?? string.Empty },
            { "status", ((int?)Model.StatusFilter)?.ToString() ?? string.Empty },
            { "factoryId", Model.FactoryIdFilter?.ToString() ?? string.Empty }
        }
    })

</div>

<!-- تم نقل تنسيقات هذه الصفحة إلى wwwroot/css/orders.css (ملف مركزي موحّد) -->
@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}