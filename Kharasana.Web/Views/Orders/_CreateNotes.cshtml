@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel

<!-- ============================================================
4. NOTES - ملاحظات
============================================================ -->
<div class="form-section-title">
    <i class="bi bi-chat-left-text"></i>
    <span>ملاحظات إضافية</span>
</div>

<div class="row">
    <div class="col-12 mb-3">
        <div class="p-3 bg-light rounded-3 border mb-3">
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" role="switch" asp-for="RequestSpecialPrice" id="requestSpecialPriceSwitch">
                <label class="form-check-label fw-bold text-dark" for="requestSpecialPriceSwitch">
                    <i class="bi bi-tag-fill text-warning me-1"></i> طلب سعر تفضيلي / مراعاة بالكمية ("اكسبوني زبون")
                </label>
            </div>
            <small class="text-muted d-block ms-4">
                تفعيل هذا الخيار ينبه إدارة المصنع لدراسة تقديم خصم تشجيعي على سعر المتر لهذا الطلب لكسب تعاملك المستمر.
            </small>
        </div>

        <label asp-for="Notes" class="form-label fw-bold">
            <i class="bi bi-pencil"></i> ملاحظات
        </label>
        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="أي ملاحظات إضافية حول موقع الصب أو تفاصيل الطلب..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
        <small class="text-muted">حقل اختياري</small>
    </div>
</div>
