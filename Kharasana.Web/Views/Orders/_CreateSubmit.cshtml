@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel

<!-- ============================================================
5. SUBMIT - أزرار الإرسال السفلية
============================================================ -->
<div class="d-flex flex-wrap gap-3 mt-4 pt-3 border-top justify-content-between align-items-center">
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg px-4 d-lg-none" id="submitBtn"
                onclick="this.disabled=true; this.form.submit(); this.innerHTML='<span class=\'spinner-border spinner-border-sm\' aria-hidden=\'true\'></span> <span role=\'status\'>جاري الحفظ...</span>';">
            <i class="bi bi-check-circle"></i> إنشاء الطلب
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
            <i class="bi bi-x-circle"></i> إلغاء
        </a>
    </div>
    <!-- رسالة إرشادية لشاشات الكمبيوتر لأن الحاسبة تظهر بجانب النموذج مباشرة -->
    <div class="d-none d-lg-flex align-items-center text-muted small">
        <i class="bi bi-info-circle me-1 text-primary"></i>
        <span>تفاصيل الحساب والتكلفة التقديرية تُحدَّث فورياً في اللوحة الجانبية المقابلة</span>
    </div>

    <!-- ملخص مالي يظهر فقط على الشاشات المتوسطة والصغيرة (عندما تكون الحاسبة أسفل النموذج) -->
    <div class="d-flex d-lg-none align-items-center gap-3">
        <div class="text-end">
            <span class="text-muted small d-block">سعر المتر:</span>
            <div id="selectedUnitPrice" class="fw-bold text-dark">-</div>
        </div>
        <div class="text-end">
            <span class="text-muted small d-block">الإجمالي التقديري:</span>
            <div id="calculatedTotal" class="fw-bold text-primary fs-5">-</div>
        </div>
    </div>
</div>
