@model Kharasana.Web.ViewModels.Orders.OrderDto

@{
    // بوليصة الصب والتسليم الرسمية — تُطبع فقط (d-none d-print-block).
    var factoryId = ViewBag.FactoryId ?? 0;
    var slabName = Enum.IsDefined(typeof(Kharasana.Domain.Enums.SlabType), Model.SlabType)
        ? ((Kharasana.Domain.Enums.SlabType)Model.SlabType).GetDisplayName()
        : "غير محدد";
    var transportName = Model.TransportMethod.GetDisplayName();
}

<div class="print-delivery-ticket d-none d-print-block">
    <div class="ticket-header text-center">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-start">
                @* اسم المصنع الحقيقي من الطلب — كانت لافتة عامة ثابتة
                   ("مصنع خرسانة جاهزة") فتخرج البوليصة بلا هوية مصدرها. *@
                <h5 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(Model.FactoryName) ? "مصنع خرسانة جاهزة" : Model.FactoryName)</h5>
                <div class="text-muted small">سند توريد وبوليصة صب</div>
            </div>
            <div>
                <h2 class="ticket-title">بوليصة صب وتسليم خرسانة</h2>
                <div class="mt-1">
                    <strong>رقم الطلب:</strong> #@Model.OrderNumber
                </div>
            </div>
            <div class="text-end">
                <div class="small"><strong>تاريخ الصب:</strong> @(Model.PouringDate?.ToString("yyyy-MM-dd") ?? Model.CreatedAt.ToString("yyyy-MM-dd"))</div>
                <div class="small"><strong>وقت الطباعة:</strong> @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6">
            <table class="ticket-table">
                <tbody>
                    <tr><th>اسم العميل</th><td>@(Model.ClientName ?? "غير محدد")</td></tr>
                    <tr><th>رقم الهاتف</th><td dir="ltr">@(Model.ClientPhone ?? "-")</td></tr>
                    <tr><th>اسم المشروع</th><td>@(Model.ProjectName ?? "-")</td></tr>
                    <tr><th>مالك المشروع</th><td>@(Model.ProjectOwnerName ?? "-")</td></tr>
                    <tr><th>منطقة الموقع</th><td>@(Model.SiteArea ?? "-")</td></tr>
                    <tr><th>وصف الموقع</th><td>@(Model.SiteDescription ?? "-")</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-6">
            <table class="ticket-table">
                <tbody>
                    <tr><th>صنف الخرسانة</th><td class="fw-bold">@Model.ConcreteTypeName</td></tr>
                    <tr><th>الكمية المصرحة</th><td class="fw-bold">@Model.Quantity م³</td></tr>
                    <tr><th>العنصر الإنشائي</th><td>@slabName</td></tr>
                    <tr><th>مضخة خرسانية</th><td>@(Model.NeedPump ? $"نعم (طابق {Model.FloorNumber})" : "بدون مضخة")</td></tr>
                    <tr><th>طريقة النقل</th><td>@transportName</td></tr>
                    <tr><th>السائق والشاحنة</th><td>@(Model.DriverName ?? "غير معين") @(string.IsNullOrEmpty(Model.TruckPlate) ? "" : $"({Model.TruckPlate})")</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="p-2 border mb-3 small">
            <strong>ملاحظات إضافية:</strong> @Model.Notes
        </div>
    }

    <div class="ticket-signatures">
        <div class="row text-center">
            <div class="col-4 ticket-sig-box">
                <div class="fw-bold">مسؤول محطة الخلط</div>
                <div class="ticket-sig-line"></div>
                <small class="text-muted d-block mt-1">الاسم والختم</small>
            </div>
            <div class="col-4 ticket-sig-box">
                <div class="fw-bold">سائق الشاحنة</div>
                <div class="ticket-sig-line"></div>
                <small class="text-muted d-block mt-1">توقيع السائق</small>
            </div>
            <div class="col-4 ticket-sig-box">
                <div class="fw-bold">المستلم / مهندس الموقع</div>
                <div class="ticket-sig-line"></div>
                <small class="text-muted d-block mt-1">توقيع استلام الكمية</small>
            </div>
        </div>
    </div>
</div>
