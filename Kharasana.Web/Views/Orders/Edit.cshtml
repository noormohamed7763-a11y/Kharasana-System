@model Kharasana.Web.ViewModels.Orders.EditOrderViewModel
@using Kharasana.Domain.Enums

@{
    ViewData["Title"] = "تعديل الطلب";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new Kharasana.Web.Models.Components.PageHeaderViewModel
        {
            Icon = "bi-pencil-square",
            Title = "تعديل الطلب",
            Description = $"تعديل بيانات الطلب: @Model.OrderNumber"
        })

    <!-- ============================================================
    INFO ALERT - رسالة توضيحية
    ============================================================ -->
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill fs-5"></i>
            <span>يمكن تعديل الطلب فقط إذا كان في حالة <strong>جديد</strong> أو <strong>قيد الانتظار</strong></span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>

    <!-- ============================================================
    ORDER INFO - معلومات الطلب (للقراءة فقط)
    ============================================================ -->
    <div class="card mb-3 shadow-sm border-info">
        <div class="card-header bg-info bg-opacity-10">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-info-circle text-info"></i>
                معلومات الطلب (للقراءة فقط)
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <span class="text-muted">رقم الطلب</span>
                    <p class="fw-bold">@Model.OrderNumber</p>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">العميل</span>
                    <p class="fw-bold">@Model.ClientName</p>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">الحالة</span>
                    <p class="fw-bold">
                        <span class="status-badge @Model.StatusCssClass">
                            @Model.StatusArabicName
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
    FORM - نموذج التعديل (الأقسام في Partials مستقلة)
    ============================================================ -->
    <div class="form-card">
        <form method="post" id="editOrderForm" asp-action="Edit" asp-route-id="@Model.OrderId"
              data-quantity-id="@Html.IdFor(m => m.Quantity)"
              data-unit-price="@Model.UnitPrice">


            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="OrderId" />

            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            @* الأقسام السبعة للنموذج — كل قسم في Partial مستقل *@
            @await Html.PartialAsync("~/Views/Orders/_EditConcreteType.cshtml", Model)
            @await Html.PartialAsync("~/Views/Orders/_EditQuantityDate.cshtml", Model)
            @await Html.PartialAsync("~/Views/Orders/_EditTransport.cshtml", Model)
            @await Html.PartialAsync("~/Views/Orders/_EditProjectInfo.cshtml", Model)
            @await Html.PartialAsync("~/Views/Orders/_EditNotes.cshtml", Model)
            @await Html.PartialAsync("~/Views/Orders/_EditPricePreview.cshtml")
            @await Html.PartialAsync("~/Views/Orders/_EditSubmit.cshtml", Model)

        </form>

        @* منطقة الحذف — Partial مستقل *@
        @await Html.PartialAsync("~/Views/Orders/_EditDelete.cshtml")
    </div>

</div>

<!-- تم نقل تنسيقات هذه الصفحة إلى wwwroot/css/orders.css (ملف مركزي موحّد) -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/orders.js" asp-append-version="true"></script>
}

