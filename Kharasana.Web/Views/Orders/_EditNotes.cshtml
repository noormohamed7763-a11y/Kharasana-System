@model Kharasana.Web.ViewModels.Orders.EditOrderViewModel

<!-- ============================================================
5. NOTES - ملاحظات
============================================================ -->
<div class="form-section-title mt-3">
    <i class="bi bi-chat-left-text"></i>
    <span>ملاحظات إضافية</span>
</div>

<div class="row">
    <div class="col-12 mb-3">
        <label asp-for="Notes" class="form-label fw-bold">
            <i class="bi bi-pencil"></i> ملاحظات
        </label>
        <textarea asp-for="Notes" rows="4" class="form-control" placeholder="أي ملاحظات إضافية حول الطلب..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
        <small class="text-muted">حقل اختياري</small>
    </div>
</div>
