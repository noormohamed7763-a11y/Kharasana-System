@model Kharasana.Web.ViewModels.Orders.CreatePhoneOrderViewModel
@using Kharasana.Domain.Enums
@using Kharasana.Application.Common

@{
    var concreteTypes = ViewBag.ConcreteTypes as List<Kharasana.Web.ViewModels.Shared.LookupDto>
        ?? new List<Kharasana.Web.ViewModels.Shared.LookupDto>();
}

<!-- ============================================================
2. ORDER INFO - بطاقة مواصفات الخرسانة والتوريد
============================================================ -->
<div class="card border-0 shadow-sm rounded-3 mb-4 order-form-card">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary rounded-circle p-2 px-3 fw-bold">2</span>
            <h6 class="mb-0 fw-bold text-dark fs-6">
                <i class="bi bi-box-seam text-primary me-1"></i> مواصفات الخرسانة والتوريد
            </h6>
        </div>
        <span class="badge bg-light text-secondary border">المواصفات الفنية</span>
    </div>
    <div class="card-body p-4">

        @if (ViewBag.UserRole == Roles.Admin)
        {
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label asp-for="FactoryId" class="form-label fw-bold small text-secondary">
                        <i class="bi bi-building text-primary me-1"></i> المصنع
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FactoryId" class="form-control" />
                    <span asp-validation-for="FactoryId" class="text-danger small"></span>
                    <small class="text-muted">أدخل معرّف المصنع الذي سيتم إنشاء الطلب لصالحه</small>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="FactoryId" />
        }

        <!-- الصف 1: نوع الخرسانة + الكمية + تاريخ الصب (تنسيق ثلاثي متكامل على الديسكتوب) -->
        <div class="row g-3 mb-3">
            <div class="col-lg-5 col-md-12">
                <label asp-for="ConcreteTypeId" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-layers text-primary me-1"></i> صنف الخرسانة المطلوبة
                    <span class="text-danger">*</span>
                </label>
                <select asp-for="ConcreteTypeId" class="form-select form-select-lg fs-6" id="concreteTypeSelect">
                    <option value="">-- اختر نوع الخرسانة --</option>
                    @foreach (var item in concreteTypes)
                    {
                        <option value="@item.Id" data-unit-price="@item.UnitPrice">@item.Name</option>
                    }
                </select>
                <span asp-validation-for="ConcreteTypeId" class="text-danger small"></span>
            </div>

            <div class="col-lg-3 col-md-6">
                <label asp-for="Quantity" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-rulers text-primary me-1"></i> الكمية (م³)
                    <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="Quantity" class="form-control form-control-lg fs-6" type="number" step="0.01" min="0.1" placeholder="25" />
                    <span class="input-group-text bg-light fw-bold text-muted">م³</span>
                </div>
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>

            <div class="col-lg-4 col-md-6">
                <label asp-for="PouringDate" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-calendar-event text-primary me-1"></i> تاريخ الصب
                    <span class="text-danger">*</span>
                </label>
                <input asp-for="PouringDate" class="form-control form-control-lg fs-6" type="date" />
                <span asp-validation-for="PouringDate" class="text-danger small"></span>
            </div>
        </div>

        <!-- الصف 2: المواصفات الفنية للخلطة (السوق اليمني): الإسمنت، الكري، الإضافات -->
        <div class="p-3 bg-light rounded-3 mb-3 border">
            <div class="fw-bold small text-dark mb-2">
                <i class="bi bi-sliders text-primary me-1"></i> المواصفات الهندسية الخاصة (السوق اليمني):
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CementType" class="form-label fw-bold small text-secondary">نوع الإسمنت</label>
                    <select asp-for="CementType" class="form-select fs-6">
                        <option value="@((int)CementType.Ordinary)">عادي (بورتلاندي عادي - OPC)</option>
                        <option value="@((int)CementType.SulphateResistant)">مقاوم للملوحة (بورتلاندي مقاوم - SRC)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AggregateSize" class="form-label fw-bold small text-secondary">مقاس الكري (الركام)</label>
                    <select asp-for="AggregateSize" class="form-select fs-6">
                        <option value="@((int)AggregateSize.Size20mm)">حد أقصى 20 ملم (صبات عامة)</option>
                        <option value="@((int)AggregateSize.Size12mm)">حد أقصى 12 ملم (أعمدة وكثافة تسليح)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Admixture" class="form-label fw-bold small text-secondary">الإضافات الكيميائية</label>
                    <select asp-for="Admixture" class="form-select fs-6">
                        <option value="@((int)Admixture.Plasticizer)">لدانة (تسهيل الضخ والتشغيل)</option>
                        <option value="@((int)Admixture.Retarder)">مؤخر شك (تأخير التصلب للأجواء الحارة)</option>
                        <option value="@((int)Admixture.None)">بدون إضافات</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- الصف 3: نوع البلاطة + خدمة المضخة ورقم الطابق -->
        <div class="row g-3 mb-4">
            <div class="col-lg-5 col-md-12">
                <label asp-for="SlabType" class="form-label fw-bold small text-secondary">
                    <i class="bi bi-grid-3x3 text-primary me-1"></i> نوع البلاطة / الهيكل
                    <span class="text-danger">*</span>
                </label>
                <select asp-for="SlabType" class="form-select form-select-lg fs-6" asp-items="EnumHelper.GetSlabTypeSelectList()">
                </select>
                <span asp-validation-for="SlabType" class="text-danger small"></span>
            </div>

            <div class="col-lg-7 col-md-12">
                <div class="row g-2 align-items-end h-100">
                    <div class="col-sm-7">
                        <label class="form-label fw-bold small text-secondary">
                            <i class="bi bi-water text-primary me-1"></i> خدمة المضخة
                        </label>
                        <div class="border rounded-3 p-2 px-3 bg-white d-flex align-items-center justify-content-between" style="min-height: 48px;">
                            <label asp-for="NeedPump" class="form-check-label fw-bold small mb-0" for="needPumpSwitch" style="cursor: pointer;">
                                طلب مضخة خرسانية
                            </label>
                            <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
                                <input asp-for="NeedPump" class="form-check-input m-0" type="checkbox" role="switch" id="needPumpSwitch" style="cursor: pointer; width: 2.75em; height: 1.4em;" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5" id="floorNumberContainer">
                        <label asp-for="FloorNumber" class="form-label fw-bold small text-secondary">
                            <i class="bi bi-building text-primary me-1"></i> رقم الطابق
                        </label>
                        <input asp-for="FloorNumber" class="form-control form-control-lg fs-6" type="number" min="0" placeholder="مثال: 4" />
                        <span asp-validation-for="FloorNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- الصف 4: طريقة النقل -->
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-bold small text-secondary mb-2">
                    <i class="bi bi-truck text-primary me-1"></i> وسيلة النقل والتوريد
                    <span class="text-danger">*</span>
                </label>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="transport-option p-3 border rounded-3 bg-white h-100 shadow-sm position-relative">
                            <div class="form-check d-flex align-items-start gap-3">
                                <input class="form-check-input mt-1" type="radio"
                                       asp-for="TransportMethod"
                                       value="@((int)TransportMethod.FactoryTransport)"
                                       id="transportFactory" />
                                <label class="form-check-label w-100" for="transportFactory" style="cursor: pointer;">
                                    <span class="fw-bold text-dark d-block mb-1">
                                        <i class="bi bi-truck text-primary me-1"></i> توريد عبر شاحنات المصنع
                                    </span>
                                    <small class="text-muted d-block">يقوم المصنع بجدولة شاحنات الخلاطة وتوصيل الخرسانة للموقع</small>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="transport-option p-3 border rounded-3 bg-white h-100 shadow-sm position-relative">
                            <div class="form-check d-flex align-items-start gap-3">
                                <input class="form-check-input mt-1" type="radio"
                                       asp-for="TransportMethod"
                                       value="@((int)TransportMethod.ClientOwnTransport)"
                                       id="transportClient" />
                                <label class="form-check-label w-100" for="transportClient" style="cursor: pointer;">
                                    <span class="fw-bold text-dark d-block mb-1">
                                        <i class="bi bi-car-front text-success me-1"></i> نقل ذاتي (بمعرفة العميل)
                                    </span>
                                    <small class="text-muted d-block">يتولى العميل توفير سيارات النقل واستلام الخرسانة من المصنع</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="TransportMethod" class="text-danger small"></span>
            </div>
        </div>

    </div>
</div>
