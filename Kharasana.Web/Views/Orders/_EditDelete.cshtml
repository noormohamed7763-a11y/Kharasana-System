@using Kharasana.Domain.Enums

@* الدور يُقرأ من الجلسة عبر ViewBag (لا يوجد ClaimsPrincipal في هذا التطبيق) *@
@if (ViewBag.ShowDeleteButton == true && ViewBag.UserRole == Roles.Admin)
{
    <!-- ============================================================
    DANGER ZONE - منطقة الحذف (للمدير فقط)
    ============================================================ -->
    <div class="mt-4 pt-3 border-top">
        <p class="text-muted small mb-2"><i class="bi bi-exclamation-triangle me-1"></i> منطقة خطرة — لا يمكن التراجع عن الحذف.</p>
        <form asp-action="Delete" method="post"
              data-ajax-delete="true"
              data-confirm="⚠️ هل أنت متأكد من حذف هذا الطلب؟">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ViewBag.OrderId" />
            <button type="submit" class="btn btn-outline-danger btn-lg">
                <i class="bi bi-trash"></i> حذف الطلب
            </button>
        </form>
    </div>
}
