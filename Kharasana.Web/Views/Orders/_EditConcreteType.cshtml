@model Kharasana.Web.ViewModels.Orders.EditOrderViewModel

<!-- ============================================================
1. CONCRETE TYPE - نوع الخرسانة
============================================================ -->
<div class="form-section-title">
    <i class="bi bi-box-seam"></i>
    <span>نوع الخرسانة</span>
</div>

<div class="row">
    <div class="col-md-12 mb-3">
        <label asp-for="ConcreteTypeId" class="form-label fw-bold">
            <i class="bi bi-box-seam me-2"></i>@Html.DisplayNameFor(m => m.ConcreteTypeId)
            <span class="text-danger">*</span>
        </label>
        <select asp-for="ConcreteTypeId" class="form-select" asp-items="ViewBag.ConcreteTypes">
            <option value="">-- اختر نوع الخرسانة --</option>
        </select>
        <span asp-validation-for="ConcreteTypeId" class="text-danger"></span>
        <small class="text-muted">تغيير نوع الخرسانة سيؤثر على السعر الإجمالي</small>
    </div>
</div>
