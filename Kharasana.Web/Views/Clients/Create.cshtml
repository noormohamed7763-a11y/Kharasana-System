@model Kharasana.Web.ViewModels.Clients.CreateClientViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إضافة عميل جديد";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-person-plus",
            Title = "إضافة عميل جديد",
            Description = "إنشاء حساب عميل جديد في النظام."
        })

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FullName" class="form-label fw-bold"><i class="bi bi-person me-2"></i>الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-bold"><i class="bi bi-telephone me-2"></i>رقم الهاتف</label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="WhatsApp" class="form-label fw-bold"><i class="bi bi-whatsapp me-2"></i>رقم الواتساب</label>
                    <input asp-for="WhatsApp" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="WhatsApp" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-bold"><i class="bi bi-lock me-2"></i>كلمة المرور</label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-save me-1"></i> حفظ العميل
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}