@model Kharasana.Web.ViewModels.Clients.ClientsIndexViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.ViewModels.Clients

@{
    ViewData["Title"] = "إدارة العملاء";
    var stats = Model.Stats ?? new ClientStatsViewModel();
}

<div class="dashboard-page">

    <!-- رأس الصفحة -->
    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-people-fill",
            Title = "إدارة العملاء",
            Description = "عرض العملاء الذين لديهم تعاملات فعلية مع المصنع، مستخرجين من سجل الطلبات.",
            ActionText = "إضافة عميل",
            ActionController = "Clients",
            ActionMethod = "Create"
        })

    <!-- بطاقات الإحصائيات -->
    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
            "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي العملاء",
                            Value = stats.TotalClients.ToString(),
                            Icon = "bi-people",
                            IconClass = "kpi-icon-primary"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "عملاء لديهم طلبات",
                            Value = stats.ActiveClientsCount.ToString(),
                            Icon = "bi-person-check",
                            IconClass = "kpi-icon-success"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي الطلبات",
                            Value = stats.TotalOrders.ToString(),
                            Icon = "bi-box-seam",
                            IconClass = "kpi-icon-info"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي الكمية",
                            Value = stats.TotalQuantity.ToString("N0") + " م³",
                            Icon = "bi-truck",
                            IconClass = "kpi-icon-warning"
                        })
    </div>

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث بالاسم أو رقم الهاتف",
                Value = Model.Search ?? string.Empty
            }
        })

    <!-- جدول العملاء -->
    @if (Model.PagedClients == null || !Model.PagedClients.Items.Any())
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_EmptyState.cshtml",
        new EmptyStateViewModel
        {
            ImageUrl = "/images/empty-clients.png",
            Title = "لا يوجد عملاء لعرضهم حاليًا."
        })
    }
    else
    {
        <partial name="_ClientTable" model="Model.PagedClients.Items" />
    }

    <!-- الترقيم -->
    @await Html.PartialAsync("~/Views/Shared/Components/_Pagination.cshtml", new PaginationViewModel
    {
        CurrentPage = Model.PageNumber,
        TotalPages = (int)Math.Ceiling(Model.PagedClients.TotalCount / (double)Model.PageSize),
        PageSize = Model.PageSize,
        TotalCount = Model.PagedClients.TotalCount,
        RouteValues = new Dictionary<string, string>
        {
            { "search", Model.Search ?? string.Empty }
        }
    })

</div>
