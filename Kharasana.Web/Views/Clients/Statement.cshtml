@model Kharasana.Web.ViewModels.Clients.ClientStatementViewModel
@using Kharasana.Web.Helpers
@using Kharasana.Domain.Enums

@{
    ViewData["Title"] = $"كشف حساب صبات - {Model.ClientName}";

    var whatsappText = System.Net.WebUtility.UrlEncode(
        $"الأخ/ {Model.ClientName} المحترم،\n" +
        $"تحية طيبة، إليكم ملخص صباتكم مع {Model.FactoryName} حتى تاريخ {Model.StatementDate:yyyy/MM/dd}:\n" +
        $"• عدد الصبات: {Model.TotalOrders} صبة\n" +
        $"• إجمالي الكمية: {Model.TotalQuantity:N2} م³\n" +
        $"• إجمالي المبلغ: {Model.TotalAmount:N0} ر.ي\n" +
        $"شاكرين تعاملكم معنا."
    );
    var whatsappUrl = $"https://wa.me/{(Model.WhatsApp ?? Model.Phone ?? string.Empty).Replace("+", "").Replace(" ", "")}?text={whatsappText}";
}

<div class="dashboard-page">

    <!-- شريط الأدوات: يظهر على الشاشة فقط ويختفي عند الطباعة -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-right"></i>
                العودة لبيانات العميل
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                قائمة العملاء
            </a>
        </div>

        <div class="d-flex gap-2">
            @if (!string.IsNullOrWhiteSpace(Model.Phone) || !string.IsNullOrWhiteSpace(Model.WhatsApp))
            {
                <a href="@whatsappUrl" target="_blank" class="btn btn-success btn-sm">
                    <i class="bi bi-whatsapp me-1"></i>
                    إرسال الملخص عبر واتساب
                </a>
            }

            <button type="button" class="btn btn-primary btn-sm" data-print>
                <i class="bi bi-printer me-1"></i>
                طباعة كشف الحساب
            </button>
        </div>
    </div>

    <!-- وثيقة كشف الحساب الرسمية -->
    <div class="erp-section-card p-4 bg-white shadow-sm print-delivery-ticket">

        <!-- ترويسة الكشف -->
        <div class="border-bottom pb-4 mb-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h3 class="fw-bold mb-1 text-primary">@Model.FactoryName</h3>
                    <div class="text-muted small">نظام إدارة مصانع الخرسانة الجاهزة (Kharasana ERP)</div>
                    <div class="fw-bold fs-5 mt-3 text-dark">
                        <i class="bi bi-file-earmark-spreadsheet me-2 text-primary"></i>
                        كشف حساب ومطابقة الصبات الموردة
                    </div>
                </div>

                <div class="text-start">
                    <div class="badge bg-light text-dark border p-2 mb-2">
                        <span class="text-muted">تاريخ الإصدار: </span>
                        <strong>@Model.StatementDate.ToString("yyyy/MM/dd HH:mm")</strong>
                    </div>
                    <div class="text-muted small">مرجع الوثيقة: #STMT-@Model.ClientId-@DateTime.Now.ToString("yyMMdd")</div>
                </div>
            </div>

            <!-- بيانات العميل والمشروع -->
            <div class="row g-3 mt-3 pt-3 border-top">
                <div class="col-md-4">
                    <span class="text-muted small d-block">اسم العميل / المقاول:</span>
                    <strong class="fs-6 text-dark">@Model.ClientName</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">رقم الهاتف:</span>
                    <strong class="fs-6 text-dark" dir="ltr">@(Model.Phone ?? "-")</strong>
                </div>
                <div class="col-md-4">
                    <span class="text-muted small d-block">حساب العميل:</span>
                    <strong class="fs-6 text-dark">#@Model.ClientId</strong>
                </div>
            </div>
        </div>

        <!-- ملخص أرقام الكشف (KPIs) -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <span class="text-muted d-block small mb-1">إجمالي الصبات المنفذة</span>
                    <h4 class="fw-bold mb-0 text-primary">@Model.TotalOrders <small class="fs-6">صبة</small></h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <span class="text-muted d-block small mb-1">إجمالي الخرسانة الموردة</span>
                    <h4 class="fw-bold mb-0 text-success">@Model.TotalQuantity.ToString("N2") <small class="fs-6">م³</small></h4>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border text-center">
                    <span class="text-muted d-block small mb-1">إجمالي القيمة المستحقة</span>
                    <h4 class="fw-bold mb-0 text-dark">@Model.TotalAmount.ToString("N0") <small class="fs-6">ر.ي</small></h4>
                </div>
            </div>
        </div>

        <!-- جدول تفريغ الصبات -->
        <div class="table-responsive mb-4">
            <table class="erp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="col-index text-nowrap">#</th>
                        <th class="text-nowrap">رقم الطلب</th>
                        <th class="col-date text-nowrap">تاريخ الصب</th>
                        <th class="text-nowrap">المشروع والموقع</th>
                        <th class="text-nowrap">نوع الخرسانة</th>
                        <th class="text-center text-nowrap">الكمية (م³)</th>
                        <th class="text-center text-nowrap">سعر المتر</th>
                        <th class="text-center text-nowrap">الإجمالي (ر.ي)</th>
                        <th class="text-center text-nowrap">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders.Any())
                    {
                        var index = 1;
                        foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="text-muted fw-bold">@(index++)</td>
                                <td>
                                    <span class="fw-bold">@order.OrderNumber</span>
                                </td>
                                <td>
                                    @((order.PouringDate ?? order.CreatedAt).ToString("yyyy/MM/dd"))
                                </td>
                                <td>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(order.ProjectName) ? "مشروع رئيسي" : order.ProjectName)</div>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(order.SiteArea) ? "-" : order.SiteArea)</small>
                                </td>
                                <td>
                                    <span class="fw-semibold">@order.ConcreteTypeName</span>
                                    <small class="text-muted d-block">@order.ConcreteStrength MPa</small>
                                </td>
                                <td class="text-center fw-bold">
                                    @order.Quantity.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @(order.UnitPrice.HasValue ? order.UnitPrice.Value.ToString("N0") : "-")
                                </td>
                                <td class="text-center fw-bold text-dark">
                                    @(order.TotalPrice.HasValue ? order.TotalPrice.Value.ToString("N0") : "0")
                                </td>
                                <td class="text-center">
                                    <span class="status-badge @order.Status.GetCssClass()">
                                        @order.Status.GetArabicName()
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                لا توجد صبات مسجلة لهذا العميل حتى الآن.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- تذييل الكشف والتوقيعات الرسمية -->
        <div class="border-top pt-4 mt-4">
            <div class="text-muted small mb-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>إقرار ومطابقة:</strong> يعتبر هذا الكشف كشف حساب ومطابقة أعمال صب معتمدة ومطابقة لجميع بوالص الصب وأوامر التوريد الموقعة في موقع العمل.
            </div>

            <div class="row text-center mt-5 pt-3">
                <div class="col-4">
                    <div class="fw-bold mb-4">المحاسب المسؤول</div>
                    <div class="border-bottom border-2 w-75 mx-auto"></div>
                </div>
                <div class="col-4">
                    <div class="fw-bold mb-4">مدير المصنع / الإدارة</div>
                    <div class="border-bottom border-2 w-75 mx-auto"></div>
                </div>
                <div class="col-4">
                    <div class="fw-bold mb-4">استلام ومطابقة العميل / المقاول</div>
                    <div class="border-bottom border-2 w-75 mx-auto"></div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver-report.css" asp-append-version="true" />
}
