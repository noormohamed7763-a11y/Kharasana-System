@model Kharasana.Web.ViewModels.Clients.ClientStatementViewModel
@using Kharasana.Web.Localization

@{
    ViewData["Title"] = "كشف حساب العميل";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">كشف حساب العميل: @Model.ClientName</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>العميل:</strong> @Model.ClientName</p>
                    <p><strong>الهاتف:</strong> @Model.Phone</p>
                </div>
                <div class="col-md-6">
                    <p><strong>تاريخ الكشف:</strong> @Model.StatementDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>رقم الطلب</th>
                        <th>التاريخ</th>
                        <th>الكمية</th>
                        <th>الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.OrderNumberSeq</td>
                            <td>@(order.PouringDate?.ToString("yyyy-MM-dd") ?? order.CreatedAt.ToString("yyyy-MM-dd"))</td>
                            <td>@order.Quantity</td>
                            <td>@order.TotalPrice?.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row mt-3">
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6>إجمالي الطلبات</h6>
                            <p class="h4">@Model.TotalOrders</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6>إجمالي الكمية</h6>
                            <p class="h4">@Model.TotalQuantity.ToString("N2")</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6>إجمالي المبالغ</h6>
                            <p class="h4">@Model.TotalAmount.ToString("N2") ر.ي</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6>إجمالي المدفوع</h6>
                            <p class="h4">@Model.TotalPaid.ToString("N2") ر.ي</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h6>الرصيد المتبقي</h6>
                            <p class="h4">@Model.Balance.ToString("N2") ر.ي</p>
                        </div>
                    </div>
                </div>
            </div>

            <h5 class="mt-4">سجل الحركات المالية</h5>
            <table class="table table-bordered table-striped mt-2">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الوصف</th>
                        <th>المرجع</th>
                        <th>مدين</th>
                        <th>دائن</th>
                        <th>الرصيد</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LedgerItems)
                    {
                        <tr>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                @item.Description
                                @if (item.OrderId.HasValue)
                                {
                                    <br/><small class="text-muted">طلب رقم: @item.OrderNumber</small>
                                }
                            </td>
                            <td>@item.Reference</td>
                            <td class="text-danger">@(item.Debit != 0 ? item.Debit.ToString("N2") : "-")</td>
                            <td class="text-success">@(item.Credit != 0 ? item.Credit.ToString("N2") : "-")</td>
                            <td><strong>@item.RunningBalance.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
