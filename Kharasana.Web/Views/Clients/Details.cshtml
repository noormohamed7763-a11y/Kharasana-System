@model Kharasana.Web.ViewModels.Clients.ClientDetailsViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = $"تفاصيل العميل - {Model.FullName}";
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-person-circle",
            Title = "تفاصيل العميل",
            Description = Model.FullName
        })

    <div class="row g-3">
        <!-- معلومات العميل الأساسية -->
        <div class="col-lg-7">
            <div class="erp-section-card h-100">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="erp-section-title">
                        <i class="bi bi-person"></i>
                        معلومات العميل
                    </h5>

                    <a asp-action="Edit"
                       asp-route-id="@Model.UserId"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil"></i>
                        تعديل
                    </a>
                </div>

                <!-- الاسم والهاتف -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="detail-label">الاسم</div>
                        <div class="detail-value fw-bold">@Model.FullName</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">رقم الهاتف</div>
                        <div class="detail-value" dir="ltr">@(Model.Phone ?? "-")</div>
                    </div>
                </div>

                <div class="detail-divider"></div>

                <!-- البريد والواتساب -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="detail-label">البريد الإلكتروني</div>
                        <div class="detail-value" dir="ltr">@(Model.Email ?? "-")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">واتساب</div>
                        <div class="detail-value" dir="ltr">@(Model.WhatsApp ?? "-")</div>
                    </div>
                </div>

                <div class="detail-divider"></div>

                <!-- الحالة والمعرف -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="detail-label">الحالة</div>
                        <div class="detail-value">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_StatusBadge.cshtml",
                            new StatusBadgeViewModel
                            {
                                Text = Model.IsActive ? "نشط" : "موقوف",
                                CssClass = Model.IsActive ? "status-success" : "status-danger"
                            })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-label">معرف العميل</div>
                        <div class="detail-value">#@Model.UserId</div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ملخص التعامل مع المصنع -->
        <div class="col-lg-5">
            <div class="erp-section-card h-100">

                <h5 class="erp-section-title mb-3">
                    <i class="bi bi-clipboard-data"></i>
                    ملخص التعامل مع المصنع
                </h5>

                <div class="row">
                    <div class="col-md-6 col-lg-12 mb-3">
                        <div class="detail-label">عدد الطلبات</div>
                        <div class="detail-value">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_StatusBadge.cshtml",
                            new StatusBadgeViewModel
                            {
                                Text = Model.OrdersCount.ToString(),
                                CssClass = "status-info"
                            })
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-12 mb-3">
                        <div class="detail-label">إجمالي الكمية</div>
                        <div class="detail-value fw-bold">@Model.TotalQuantity.ToString("N2") م³</div>
                    </div>

                    <div class="col-lg-12">
                        <div class="detail-label">آخر طلب</div>
                        <div class="detail-value">
                            @(Model.LastOrderDate.HasValue
                                ? Model.LastOrderDate.Value.ToString("yyyy-MM-dd HH:mm")
                                : "لا يوجد طلبات سابقة")
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- العودة إلى القائمة -->
    <div class="d-flex gap-2 mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> العودة إلى القائمة
        </a>
    </div>

</div>