@using Kharasana.Web.ViewModels.Clients
@using Kharasana.Web.Models.Components

@model IEnumerable<ClientListItemViewModel>

<div class="form-card">
    <div class="table-responsive">
        <table class="erp-table erp-table--sticky-cols">
            <thead>
                <tr>
                    <th class="col-index text-nowrap">#</th>
                    <th class="text-nowrap">العميل</th>
                    <th class="text-nowrap">الهاتف</th>
                    <th class="text-nowrap">عدد الطلبات</th>
                    <th class="text-nowrap">الكمية (م³)</th>
                    <th class="text-nowrap">آخر طلب</th>
                    <th class="text-center col-actions text-nowrap">الإجراءات</th>
                </tr>
            </thead>

            <tbody>
                @{
                    var index = 1;
                }

                @foreach (var client in Model)
                {
                    <tr>
                        <!-- رقم تسلسلي -->
                        <td class="text-muted fw-bold">
                            @(index++)
                        </td>

                        <!-- اسم العميل مع avatar -->
                        <td>
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_UserCell.cshtml",
                                new UserCellViewModel
                                {
                                    FullName = client.FullName,
                                    AvatarCssClass = "avatar-client"
                                })
                        </td>

                        <!-- الهاتف مع خيارات التواصل السريع والنسخ -->
                        <td dir="ltr">
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_PhoneActions.cshtml",
                                new PhoneActionsViewModel
                                {
                                    Phone = client.Phone ?? string.Empty,
                                    ContactName = client.FullName,
                                    ContactLabel = "العميل",
                                    // العملاء لا يُتصل بهم هاتفياً من الجدول (لا سياق للاتصال)
                                    ShowCall = false
                                })
                        </td>

                        <!-- عدد الطلبات -->
                        <td>
                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                new StatusBadgeViewModel
                                                {
                                                    Text = client.OrdersCount.ToString(),
                                                    CssClass = "status-info"
                                                })
                    </td>

                    <!-- إجمالي الكمية -->
                    <td>
                        @client.TotalQuantity.ToString("N2")
                    </td>

                    <!-- آخر طلب -->
                    <td>
                        @client.LastOrderDate.FormatDate()
                    </td>

                        <!-- الإجراءات -->
                        <td class="text-center">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_ActionButtons.cshtml",
                                                new ActionButtonsViewModel
                                                {
                                                    Id = client.UserId,

                                                    // مهم جدًا:
                                                    // تحديد Controller العملاء صراحةً
                                                    ControllerName = "Clients",

                                                    // التفاصيل
                                                    ShowDetails = true,
                                                    DetailsAction = "Details",

                                                    // التعديل
                                                    ShowEdit = true,
                                                    EditAction = "Edit",

                                                    // الحذف غير مطلوب
                                                    ShowDelete = false
                                                })
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>