@model Kharasana.Web.ViewModels.Users.DriverReportViewModel
@using Kharasana.Web.Helpers
@using Kharasana.Domain.Enums

@{
    ViewData["Title"] = "تقرير طلبات السائق";
}

@* تنسيقات هذا التقرير في wwwroot/css/driver-report.css، تُحمَّل عبر قسم Styles
   في _Layout.cshtml — كانت كتلة <style> هنا وهي الوحيدة في المشروع. *@

<div class="dashboard-page">

    <!-- شريط الأدوات: يظهر على الشاشة فقط ويختفي عند الطباعة -->
    <div class="driver-report__toolbar no-print">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right"></i>
            العودة للمستخدمين
        </a>

        @* data-print هو نمط التطبيق الموحّد لأزرار الطباعة (site.js)، بديل عن
           معرف خاص بهذا الزر ومعالج آخر له في site.js. *@
        <button type="button"
                class="btn btn-primary btn-sm"
                data-print>
            <i class="bi bi-printer"></i>
            طباعة التقرير
        </button>
    </div>

    <!-- التقرير -->
    <div class="driver-report">

        <!-- ترويسة التقرير -->
        <div class="driver-report__header">
            <div class="driver-report__title">
                <span class="driver-report__brand">Kharasana</span>
                — تقرير طلبات السائق
            </div>
            <div class="row g-3 mt-0">
                <div class="col-md-4">
                    <div class="detail-label">اسم السائق</div>
                    <div class="detail-value fw-bold">@Model.DriverName</div>
                </div>
                <div class="col-md-4">
                    <div class="detail-label">المصنع</div>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.FactoryName) ? "-" : Model.FactoryName)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-label">تاريخ التقرير</div>
                    <div class="detail-value">@Model.ReportDate.FormatDate()</div>
                </div>
                <div class="col-md-4">
                    <div class="detail-label">رقم الهاتف</div>
                    <div class="detail-value" dir="ltr">
                        @(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-label">رقم الرخصة</div>
                    <div class="detail-value">
                        @(string.IsNullOrWhiteSpace(Model.LicenseNumber) ? "-" : Model.LicenseNumber)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-label">إجمالي الطلبات</div>
                    <div class="detail-value fw-bold">@Model.OrderCount</div>
                </div>
            </div>
        </div>

        <!-- جدول الطلبات -->
        @if (!Model.Orders.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                لا توجد طلبات مسندة لهذا السائق
            </div>
        }
        else
        {
            <div class="form-card">
                <div class="table-responsive">
                    <table class="erp-table" id="driverReportTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الطلب</th>
                                <th>اسم العميل</th>
                                <th>التاريخ</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowIndex = 1;
                            }

                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(rowIndex++)</td>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.ClientName</td>
                                    <td>@order.CreatedAt.FormatDate()</td>
                                    <td>
                                        <span class="status-badge @order.Status.GetCssClass()">
                                            @order.Status.GetArabicName()
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver-report.css" asp-append-version="true" />
}