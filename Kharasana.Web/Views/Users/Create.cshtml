@model Kharasana.Web.ViewModels.Users.CreateUserViewModel
@using Kharasana.Domain.Enums
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إضافة مستخدم جديد";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-person-plus",
            Title = "إضافة مستخدم جديد",
            Description = "إنشاء حساب موظف مصنع أو سائق جديد وتحديد دوره مباشرة."
        })

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    يرجى تصحيح الأخطاء أدناه.
                </div>
            }

            @* أخطاء النموذج ككل (AddModelError بمفتاح فارغ في UsersController) لا يطبعها
               أي `asp-validation-for`؛ فبلا هذا الملخّص كان فشل الإنشاء ورسالة الـ API
               تختفي ولا يبقى إلا تنبيه «يرجى تصحيح الأخطاء أدناه» بلا خطأ تحته.
               ModelOnly حتى لا تتكرّر أخطاء الحقول المعروضة أصلاً بجانب كل حقل. *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <!-- الاسم الكامل -->
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold">
                        <span class="text-danger">*</span> <i class="bi bi-person me-2"></i>@Html.DisplayNameFor(m => m.FullName)
                    </label>
                    <input asp-for="FullName" class="form-control" placeholder="أدخل الاسم الكامل" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- البريد الإلكتروني -->
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>@Html.DisplayNameFor(m => m.Email)</label>
                    <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- كلمة المرور -->
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-bold">
                        <span class="text-danger">*</span> <i class="bi bi-lock me-2"></i>@Html.DisplayNameFor(m => m.Password)
                    </label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="******" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <small class="text-muted">يجب أن تكون 8 أحرف على الأقل.</small>
                </div>

                <!-- تأكيد كلمة المرور -->
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold">
                        <span class="text-danger">*</span> <i class="bi bi-lock me-2"></i>@Html.DisplayNameFor(m => m.ConfirmPassword)
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="******" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <!-- رقم الهاتف -->
                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label fw-bold"><i class="bi bi-telephone me-2"></i>@Html.DisplayNameFor(m => m.Phone)</label>
                    <input asp-for="Phone" class="form-control" placeholder="777123456" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <!-- رقم الواتساب -->
                <div class="col-md-4">
                    <label asp-for="WhatsApp" class="form-label fw-bold"><i class="bi bi-whatsapp me-2"></i>@Html.DisplayNameFor(m => m.WhatsApp)</label>
                    <input asp-for="WhatsApp" class="form-control" placeholder="777123456" />
                    <span asp-validation-for="WhatsApp" class="text-danger small"></span>
                </div>

                <!-- الدور -->
                <div class="col-md-4">
                    <label asp-for="Role" class="form-label fw-bold">
                        <span class="text-danger">*</span> <i class="bi bi-person-badge me-2"></i>@Html.DisplayNameFor(m => m.Role)
                    </label>
                    <select asp-for="Role" class="form-select"
                            asp-items="Html.GetEnumSelectList<UserRole>().Where(r => r.Value != ((int)UserRole.None).ToString())">
                        <option value="">-- اختر الدور --</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <!-- رقم الرخصة -->
                <div class="col-md-6" id="licenseNumberGroup" style="display: none;">
                    <label asp-for="LicenseNumber" class="form-label fw-bold"><i class="bi bi-card-text me-2"></i>@Html.DisplayNameFor(m => m.LicenseNumber)</label>
                    <input asp-for="LicenseNumber" class="form-control" placeholder="رقم الرخصة" />
                    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                </div>

                <!-- حالة السائق -->
                <div class="col-md-6" id="driverStatusGroup" style="display: none;">
                    <label asp-for="DriverStatus" class="form-label fw-bold"><i class="bi bi-toggle-on me-2"></i>@Html.DisplayNameFor(m => m.DriverStatus)</label>
                    <select asp-for="DriverStatus" class="form-select"
                            asp-items="Html.GetEnumSelectList<DriverStatus>().Where(s => s.Value != ((int)DriverStatus.Unset).ToString())">
                        <option value="">-- اختر الحالة --</option>
                    </select>
                    <span asp-validation-for="DriverStatus" class="text-danger small"></span>
                </div>

                <!-- المصنع -->
                <div class="col-md-6" id="factoryGroup" style="display: none;">
                    <label asp-for="FactoryId" class="form-label fw-bold">
                        <span class="text-danger" id="factoryRequired" style="display: none;">*</span>
                        <i class="bi bi-building me-2"></i>@Html.DisplayNameFor(m => m.FactoryId)
                    </label>
                    <input asp-for="FactoryId" class="form-control" type="number" placeholder="أدخل معرف المصنع" />
                    <span asp-validation-for="FactoryId" class="text-danger small"></span>
                </div>

            </div>

            <!-- أزرار التحكم -->
            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-save me-1"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script nonce="@ViewBag.CspNonce">
        $(document).ready(function () {
            function toggleFields(role) {
                var isDriver = role === '@UserRole.Driver.ToString()';
                var isEmployee = role === '@UserRole.FactoryEmployee.ToString()';

                $('#licenseNumberGroup').toggle(isDriver);
                $('#driverStatusGroup').toggle(isDriver);
                $('#factoryGroup').toggle(isDriver || isEmployee);

                if (isDriver || isEmployee) {
                    $('#factoryRequired').show();
                    $('#factoryNote').show();
                } else {
                    $('#factoryRequired').hide();
                    $('#factoryNote').hide();
                }
            }

            $('#Role').change(function () {
                toggleFields($(this).val());
            });

            toggleFields($('#Role').val());
        });
    </script>
}