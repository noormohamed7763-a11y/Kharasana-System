@model Kharasana.Web.ViewModels.Users.UsersIndexViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using System.Linq

@{
    ViewData["Title"] = "إدارة المستخدمين";
    var totalUsers = Model.PagedUsers?.TotalCount ?? 0;
}

<!-- تم حذف هذه الكتلة: كانت تعيد تعريف .erp-table/.form-card/.pagination
     بألوان Bootstrap الرمادية الافتراضية (--bs-gray-*) بدل الهوية البرتقالية.
     كل هذه الكلاسات معرّفة مركزيًا في tables.css / forms.css الآن. -->
<div class="dashboard-page">

    <!-- رأس الصفحة -->
    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-people",
            Title = "إدارة المستخدمين",
            Description = "إدارة جميع حسابات المستخدمين داخل النظام.",
            ActionText = "مستخدم جديد",
            ActionController = "Users",
            ActionMethod = "Create"
        })

    <!-- بطاقات الإحصائيات -->
    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي المستخدمين",
                            Value = totalUsers.ToString(),
                            Icon = "bi-people",
                            IconClass = "kpi-icon-primary"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "المديرون",
                            Value = Model.PagedUsers?.Items.Count(x => x.Role == "Admin").ToString() ?? "0",
                            Icon = "bi-shield-lock",
                            IconClass = "kpi-icon-danger"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "موظفو المصانع",
                            Value = Model.PagedUsers?.Items.Count(x => x.Role == "FactoryEmployee").ToString() ?? "0",
                            Icon = "bi-building",
                            IconClass = "kpi-icon-info"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "السائقون",
                            Value = Model.PagedUsers?.Items.Count(x => x.Role == "Driver").ToString() ?? "0",
                            Icon = "bi-truck",
                            IconClass = "kpi-icon-warning"
                        })
    </div>

    <!-- شريط الأدوات -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_Toolbar.cshtml",
        new ToolbarViewModel
        {
            ShowAddButton = true,
            AddButtonText = "مستخدم جديد",
            AddButtonController = "Users",
            AddButtonAction = "Create",
            ShowExport = false
        })

    <!-- نموذج البحث -->
    <form method="get" asp-action="Index" class="mb-3">
        <div class="row align-items-center">
            <div class="col-lg-6">
                @await Html.PartialAsync(
                                "~/Views/Shared/Components/_SearchBox.cshtml",
                                new SearchBoxViewModel
                                {
                                    InputId = "search",
                                    Placeholder = "ابحث بالاسم أو الهاتف",
                                    Value = Model.Search ?? string.Empty
                                })
            </div>

            <div class="col-lg-2">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
            </div>

            <div class="col-lg-2">
                <button class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                    بحث
                </button>
            </div>

            <div class="col-lg-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary w-100">
                    إعادة تعيين
                </a>
            </div>
        </div>
    </form>

    <!-- جدول المستخدمين -->
    @if (Model.PagedUsers == null || !Model.PagedUsers.Items.Any())
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_EmptyState.cshtml",
        new EmptyStateViewModel
        {
            Title = "لا يوجد مستخدمون لعرضهم",
            Message = "قم بإضافة أول مستخدم للبدء.",
            ShowActionButton = true,
            ActionController = "Users",
            ActionAction = "Create",
            ActionText = "مستخدم جديد"
        })
    }
    else
    {
        <div class="form-card">
            <div class="table-responsive">
                <table class="erp-table erp-table--sticky-cols">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الاسم</th>
                            <th>الدور</th>
                            <th>الهاتف</th>
                            <th>البريد الإلكتروني</th>
                            <th>الحالة</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }

                        @foreach (var user in Model.PagedUsers.Items)
                        {
                            <tr>
                                <td class="text-muted fw-bold">@(index++)</td>

                                <td>
                                    <div class="fw-semibold">
                                        @user.FullName
                                    </div>
                                </td>

                                <td>
                                    @{
                                        var css = user.Role switch
                                        {
                                            "Admin" => "status-danger",
                                            "FactoryEmployee" => "status-primary",
                                            "Driver" => "status-warning",
                                            "Client" => "status-success",
                                            _ => "status-secondary"
                                        };

                                        var roleName = user.Role switch
                                        {
                                            "Admin" => "مدير النظام",
                                            "FactoryEmployee" => "موظف مصنع",
                                            "Driver" => "سائق",
                                            "Client" => "عميل",
                                            _ => user.Role
                                        };
                                    }

                                    @await Html.PartialAsync(
                                    "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                        new StatusBadgeViewModel
                                                        {
                                                            Text = roleName,
                                                            CssClass = css
                                                        })
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(user.Phone) ? "-" : user.Phone)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)
                        </td>

                        <td>
                            @await Html.PartialAsync(
                                                        "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                        new StatusBadgeViewModel
                                                        {
                                                            Text = user.IsActive ? "نشط" : "موقوف",
                                                            CssClass = user.IsActive ? "status-success" : "status-danger"
                                                        })
                        </td>

                        <td class="text-center">
                            @await Html.PartialAsync(
                                                        "~/Views/Shared/Components/_ActionButtons.cshtml",
                                                        new ActionButtonsViewModel
                                                        {
                                                            Id = user.UserId,
                                                            ControllerName = "Users",

                                                            ShowDetails = true,
                                                            DetailsAction = "Details",

                                                            ShowEdit = true,
                                                            EditAction = "Edit",

                                                            // TODO: تأكيد وجود UsersController.Delete(int id) [POST] فعليًا
                                                            // قبل تفعيل هذا الزر — كان يستدعي سابقًا confirmDelete()
                                                            // وهي دالة غير معرّفة في أي ملف JS بالمشروع (زر معطّل فعليًا).
                                                            ShowDelete = false
                                                        })
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- الترقيم -->
    @if (Model.PagedUsers != null && Model.PagedUsers.TotalCount > 0)
    {
        var pageCount = (int)Math.Ceiling(Model.PagedUsers.TotalCount / (double)Model.PageSize);

        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.PageNumber > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }

                @for (int p = 1; p <= pageCount; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@p"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search">
                            @p
                        </a>
                    </li>
                }

                @if (Model.PageNumber < pageCount)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>