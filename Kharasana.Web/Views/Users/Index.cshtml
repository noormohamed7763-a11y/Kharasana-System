@model Kharasana.Web.ViewModels.Users.UsersIndexViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.ViewModels.Components
@using System.Linq

@{
    ViewData["Title"] = "إدارة المستخدمين";

    // الإنشاء والتعديل والحذف مقيّدة في UsersController بـ Roles.Admin — تُخفى للأدوار الأخرى
    var isAdmin = (string?)ViewBag.UserRole == Roles.Admin;
}

<!-- تم حذف هذه الكتلة: كانت تعيد تعريف .erp-table/.form-card/.pagination
     بألوان Bootstrap الرمادية الافتراضية (--bs-gray-*) بدل الهوية البرتقالية.
     كل هذه الكلاسات معرّفة مركزيًا في tables.css / forms.css الآن. -->
<div class="dashboard-page">

    <!-- رأس الصفحة -->
    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-people",
            Title = "إدارة المستخدمين",
            Description = "إدارة جميع حسابات المستخدمين داخل النظام.",
            ActionText = isAdmin ? "مستخدم جديد" : null,
            ActionController = "Users",
            ActionMethod = "Create"
        })

    <!-- بطاقات الإحصائيات -->
    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي المستخدمين",
                            Value = Model.TotalUsers.ToString(),
                            Icon = "bi-people",
                            IconClass = "kpi-icon-primary"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "المديرون",
                            Value = Model.AdminsCount.ToString(),
                            Icon = "bi-shield-lock",
                            IconClass = "kpi-icon-danger"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "موظفو المصانع",
                            Value = Model.FactoryEmployeesCount.ToString(),
                            Icon = "bi-building",
                            IconClass = "kpi-icon-info"
                        })

            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "السائقون",
                            Value = Model.DriversCount.ToString(),
                            Icon = "bi-truck",
                            IconClass = "kpi-icon-warning"
                        })
    </div>

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            ControllerName = "Users",
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث بالاسم أو الهاتف",
                Value = Model.Search ?? string.Empty
            }
        })

    <!-- جدول المستخدمين -->
    @if (Model.PagedUsers == null || !Model.PagedUsers.Items.Any())
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_EmptyState.cshtml",
        new EmptyStateViewModel
        {
            Title = "لا يوجد مستخدمون لعرضهم",
            Message = "قم بإضافة أول مستخدم للبدء.",
            ShowActionButton = isAdmin,
            ActionController = "Users",
            ActionAction = "Create",
            ActionText = "مستخدم جديد"
        })
    }
    else
    {
        <div class="form-card">
            <div class="table-responsive">
                <table class="erp-table erp-table--sticky-cols">
                    <caption class="visually-hidden">قائمة المستخدمين — الاسم، الدور، الهاتف، الحالة، الإجراءات</caption>
                    <thead>
                        <tr>
                            <th class="col-index text-nowrap">#</th>
                            <th class="text-nowrap">المستخدم</th>
                            <th class="text-nowrap">الدور</th>
                            <th class="text-nowrap">الهاتف</th>
                            <th class="text-nowrap">الحالة</th>
                            <th class="text-center col-actions text-nowrap">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // ترقيم متصل عبر الصفحات — يبدأ من ((صفحة-1) × حجم الصفحة) + 1
                            var index = (Model.PageNumber - 1) * Model.PageSize + 1;
                        }

                        @foreach (var user in Model.PagedUsers.Items)
                        {
                            var avatarCss = user.Role switch
                            {
                                Roles.Admin           => "avatar-admin",
                                Roles.FactoryEmployee => "avatar-employee",
                                Roles.Driver          => "avatar-driver",
                                Roles.Client          => "avatar-client",
                                _                     => "avatar-default"
                            };

                            <tr>
                                <td class="text-muted fw-bold">@(index++)</td>

                                <td>
                                    @await Html.PartialAsync(
                                        "~/Views/Shared/Components/_UserCell.cshtml",
                                        new UserCellViewModel
                                        {
                                            FullName = user.FullName,
                                            SubText = user.Email,
                                            AvatarCssClass = avatarCss
                                        })
                                </td>

                                <td>
                                    @{
                                        var css = user.Role switch
                                        {
                                            Roles.Admin => "status-danger",
                                            Roles.FactoryEmployee => "status-primary",
                                            Roles.Driver => "status-warning",
                                            Roles.Client => "status-success",
                                            _ => "status-secondary"
                                        };

                                        var roleName = user.Role switch
                                        {
                                            Roles.Admin => "مدير النظام",
                                            Roles.FactoryEmployee => "موظف مصنع",
                                            Roles.Driver => "سائق",
                                            Roles.Client => "عميل",
                                            _ => user.Role
                                        };
                                    }

                                    @await Html.PartialAsync(
                                    "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                        new StatusBadgeViewModel
                                                        {
                                                            Text = roleName,
                                                            CssClass = css
                                                        })
                        </td>

                        <td dir="ltr" class="text-start">
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_PhoneActions.cshtml",
                                new PhoneActionsViewModel
                                {
                                    Phone = user.Phone ?? string.Empty,
                                    ContactName = user.FullName,
                                    ContactLabel = "المستخدم",
                                    // أرقام المستخدمين للإدارة والرجوع إليها، لا للاتصال السريع
                                    ShowCall = false,
                                    ShowWhatsApp = false,
                                    AlignEnd = false
                                })
                        </td>

                        <td>
                            @await Html.PartialAsync(
                                                        "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                        new StatusBadgeViewModel
                                                        {
                                                            Text = user.IsActive ? "نشط" : "موقوف",
                                                            CssClass = user.IsActive ? "status-success" : "status-danger"
                                                        })
                        </td>

                        <td class="text-center">
                            @await Html.PartialAsync(
                                                        "~/Views/Shared/Components/_ActionButtons.cshtml",
                                                        new ActionButtonsViewModel
                                                        {
                                                            Id = user.UserId,
                                                            ControllerName = "Users",

                                                            ShowDetails = true,
                                                            DetailsAction = "Details",

                                                            ShowEdit = isAdmin,
                                                            EditAction = "Edit",

                                                            ShowDelete = isAdmin,
                                                            DeleteAction = "Delete"
                                                        })
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- الترقيم — المكون الموحّد: نطاق محدود (±2 صفحة) بدل كل الأرقام،
         مع aria-current="page" للصفحة الحالية -->
    @if (Model.PagedUsers != null && Model.PagedUsers.TotalCount > 0)
    {
        @await Html.PartialAsync(
            "~/Views/Shared/Components/_Pagination.cshtml",
            new PaginationViewModel
            {
                CurrentPage = Model.PageNumber,
                TotalPages = (int)Math.Ceiling(Model.PagedUsers.TotalCount / (double)Model.PageSize),
                PageSize = Model.PageSize,
                TotalCount = Model.PagedUsers.TotalCount,
                AspAction = "Index",
                RouteValues = new Dictionary<string, string>
                {
                    ["search"] = Model.Search ?? string.Empty
                }
            })
    }

</div>