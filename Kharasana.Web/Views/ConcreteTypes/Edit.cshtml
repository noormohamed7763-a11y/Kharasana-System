@model Kharasana.Web.ViewModels.ConcreteTypes.UpdateConcreteTypeViewModel

@{
    ViewData["Title"] = "تعديل نوع خرسانة";
}

<div class="container-fluid">

    <h2 class="mb-3">
        تعديل نوع الخرسانة
    </h2>

    <form asp-action="Edit"
          asp-route-id="@Model.ConcreteTypeId"
          method="post">

        <partial name="_EditForm" model="Model" />

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                حفظ التعديلات
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                رجوع
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}