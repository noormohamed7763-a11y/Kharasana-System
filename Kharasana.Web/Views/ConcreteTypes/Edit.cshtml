@model Kharasana.Web.ViewModels.ConcreteTypes.UpdateConcreteTypeViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "تعديل نوع خرسانة";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-pencil-square",
            Title = "تعديل نوع خرسانة",
            Description = $"تعديل بيانات نوع الخرسانة: {Model.Name}"
        })

    <div class="form-card shadow-sm">
        <form asp-action="Edit" asp-route-id="@Model.ConcreteTypeId" method="post" id="editConcreteTypeForm">
            @Html.AntiForgeryToken()

            @* ملخّص التحقق موضعه داخل `_EditForm` (كما في `_CreateForm` و`_FactoryForm`)،
               فوجود نسخة ثانية هنا كان يعرض قائمة الأخطاء نفسها مرتين في النموذج. *@
            <partial name="_EditForm" model="Model" />

            <hr class="my-4" />

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-check-circle"></i> حفظ التعديلات
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/concrete-type.js" asp-append-version="true"></script>
}