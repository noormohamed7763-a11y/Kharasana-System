@model Kharasana.Web.ViewModels.ConcreteTypes.CreateConcreteTypeViewModel

<div class="row g-3">

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <!-- معاينة مباشرة -->
    <div class="col-12">
        <div class="erp-section-card text-center py-3">
            <div class="d-inline-flex align-items-center gap-4 flex-wrap justify-content-center">
                <img id="previewImage"
                     src="~/images/default-concrete.png"
                     asp-append-version="true"
                     alt="معاينة"
                     class="concrete-preview-img--thumb" />
                <div class="text-end">
                    <div id="previewName" class="fw-bold fs-5 text-dark">لم يتم اختيار نوع</div>
                    <div id="previewUsage" class="text-muted">اختر نوع الخرسانة</div>
                    <div class="d-flex gap-3 mt-1">
                        <div><small class="text-muted">المقاومة</small> <span id="previewStrength" class="fw-bold">-</span></div>
                        <div><small class="text-muted">السعر</small>      <span id="previewPrice"   class="fw-bold text-primary">0 ر.ي</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- المعلومات الأساسية -->
    <div class="col-12">
        <div class="erp-section-title">
            <i class="bi bi-box-seam"></i>
            <span>المعلومات الأساسية</span>
        </div>
    </div>

    @if ((string?)ViewBag.UserRole == Roles.Admin)
    {
        <div class="col-md-6">
            <label asp-for="FactoryId" class="form-label fw-bold"><i class="bi bi-building me-2"></i>@Html.DisplayNameFor(m => m.FactoryId)</label>

            <select asp-for="FactoryId"
                    asp-items="Model.Factories"
                    class="form-select">
                <option value="">اختر المصنع</option>
            </select>

            <span asp-validation-for="FactoryId" class="text-danger"></span>
        </div>
    }

    <!-- خيار التبديل (Switch) -->
    <div class="col-12 mb-3">
        <div class="form-check form-switch form-switch-lg d-flex align-items-center gap-2">
            <input class="form-check-input" type="checkbox" role="switch" id="typeSwitchToggle">
            <label class="form-check-label fw-bold form-switch-label" for="typeSwitchToggle">إنشاء نوع خرسانة مخصص</label>
        </div>
        <small class="text-muted ms-5">قم بتفعيل هذا الخيار لإدخال نوع خرسانة جديد غير موجود في القائمة القياسية.</small>
    </div>

    <!-- النوع القياسي -->
    <div id="standardConcreteSection">
        <div class="row">

            <div class="col-md-6">

                <label asp-for="SelectedConcreteCode"
                       class="form-label fw-bold"><i class="bi bi-box-seam me-2"></i>@Html.DisplayNameFor(m => m.SelectedConcreteCode)</label>

                <select asp-for="SelectedConcreteCode"
                        class="form-select"
                        id="concreteTypeSelect">

                    <option value="">-- اختر نوع الخرسانة --</option>

                    @foreach (var item in Model.ConcreteCatalog)
                    {
                        <option value="@item.Code"
                                data-strength="@item.Strength"
                                data-usage="@item.Usage"
                                selected="@(Model.SelectedConcreteCode == item.Code ? "selected" : null)">

                            @item.Code - @item.Usage

                        </option>
                    }

                </select>

                <span asp-validation-for="SelectedConcreteCode"
                      class="text-danger"></span>

            </div>
        </div>

        <div class="col-12 mt-3">

            <div class="card shadow-sm border-info">

                <div class="card-body">

                    <h6 class="fw-bold mb-3">

                        <i class="bi bi-info-circle"></i>

                        معلومات النوع

                    </h6>

                    <div class="row">

                        <div class="col-md-6">

                            <strong>الاستخدام</strong>

                            <div id="usageText"
                                 class="text-muted mt-1">

                                اختر نوع الخرسانة لعرض الاستخدام

                            </div>

                        </div>

                        <div class="col-md-6">

                            <strong>المقاومة</strong>

                            <div id="strengthText"
                                 class="text-muted mt-1">

                                -

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- النوع المخصص -->
    <div id="customConcreteSection" class="d-none">
        <div class="row">

            <div class="col-md-6">

                <label asp-for="CustomName"
                       class="form-label fw-bold"><i class="bi bi-pencil me-2"></i>@Html.DisplayNameFor(m => m.CustomName)</label>

                <input asp-for="CustomName"
                       class="form-control"
                       placeholder="مثال: خرسانة مقاومة للأملاح" />

                <span asp-validation-for="CustomName"
                      class="text-danger"></span>

            </div>

            <div class="col-md-6">

                <label asp-for="CustomStrength"
                       class="form-label fw-bold"><i class="bi bi-rulers me-2"></i>@Html.DisplayNameFor(m => m.CustomStrength)</label>

                <div class="input-group">

                    <input asp-for="CustomStrength"
                           class="form-control"
                           placeholder="35" />

                    <span class="input-group-text">
                        MPa
                    </span>

                </div>

                <span asp-validation-for="CustomStrength"
                      class="text-danger"></span>

            </div>

        </div>
    </div>

    <!-- الحقول المخفية -->
    <input asp-for="Name" type="hidden" />
    <input asp-for="Strength" type="hidden" />
    <input asp-for="IsCustomType"
           type="hidden"
           id="IsCustomType" />

    <!-- بيانات السعر -->
    <div class="col-12 mt-3">

        <div class="erp-section-title">

                            <i class="bi bi-cash-stack"></i>

                            <span>بيانات السعر</span>

                        </div>

    </div>

    <div class="col-md-6">

        <label asp-for="UnitPrice"
               class="form-label fw-bold"><i class="bi bi-cash-stack me-2"></i>@Html.DisplayNameFor(m => m.UnitPrice)</label>

        <div class="input-group">

            <input asp-for="UnitPrice"
                   class="form-control"
                   placeholder="35000" />

            <span class="input-group-text">
                ر.ي
            </span>

        </div>

        <span asp-validation-for="UnitPrice"
              class="text-danger"></span>

        <small class="text-muted">

            السعر لكل متر مكعب

        </small>

    </div>

    <!-- الصورة -->
    <div class="col-12 mt-3">

        <div class="erp-section-title">

                            <i class="bi bi-image"></i>

                            <span>الصورة والوصف</span>

                        </div>

    </div>

    <div class="col-12">

        <label asp-for="ImageUrl"
               class="form-label fw-bold"><i class="bi bi-image me-2"></i>@Html.DisplayNameFor(m => m.ImageUrl)</label>

        <input asp-for="ImageUrl"
               class="form-control"
               placeholder="https://example.com/image.jpg" />

        <span asp-validation-for="ImageUrl"
              class="text-danger"></span>

    </div>

    <div class="col-12">

        <label asp-for="Description"
               class="form-label fw-bold"><i class="bi bi-text-paragraph me-2"></i>@Html.DisplayNameFor(m => m.Description)</label>

        <textarea asp-for="Description"
                  rows="4"
                  class="form-control"
                  placeholder="أدخل وصفاً مختصراً لنوع الخرسانة..."></textarea>

        <span asp-validation-for="Description"
              class="text-danger"></span>

    </div>

</div>