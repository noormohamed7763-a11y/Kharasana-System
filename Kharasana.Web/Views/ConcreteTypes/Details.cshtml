@model Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = $"تفاصيل نوع الخرسانة - {Model.Name}";

    var statusCss = Model.IsActive ? "status-success" : "status-danger";
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-box-seam",
            Title = "تفاصيل نوع الخرسانة",
            Description = Model.Name
        })

    <div class="erp-section-card">

        <!-- رأس البطاقة: الصورة، الاسم، المقاومة، الحالة -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 pb-3 border-bottom gap-3">
            <div class="d-flex align-items-center gap-3">
                @{
                    var previewSrc = string.IsNullOrWhiteSpace(Model.ImageUrl)
                        ? Url.Content("~/images/default-concrete.png")
                        : Model.ImageUrl;
                }
                <img src="@previewSrc"
                     asp-append-version="true"
                     alt="@Model.Name"
                     style="width:88px; height:88px; object-fit:cover; border-radius:var(--radius-md); border:2px solid var(--border-main); background:var(--surface-alt);" />
                <div>
                    <h3 class="fw-bold mb-1 text-dark">@Model.Name</h3>
                    <span class="text-muted"><i class="bi bi-box-seam me-1"></i> خرسانة بقوة @Model.Strength MPa</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @await Html.PartialAsync(
                "~/Views/Shared/Components/_StatusBadge.cshtml",
                    new StatusBadgeViewModel
                    {
                        Text = Model.IsActive ? "نشط" : "متوقف",
                        CssClass = statusCss
                    })
                <a asp-action="Edit" asp-route-id="@Model.ConcreteTypeId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i> تعديل
                </a>
            </div>
        </div>

        <!-- شبكة البيانات التفصيلية -->
        <div class="row g-3">

            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-muted d-block small mb-1">سعر المتر المكعب</span>
                    <h6 class="fw-bold mb-0 text-dark">@Model.UnitPrice.ToString("N0") ر.ي</h6>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-muted d-block small mb-1">المصنع</span>
                    <h6 class="fw-bold mb-0 text-dark">@Model.FactoryName</h6>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <span class="text-muted d-block small mb-1">معرف النوع</span>
                    <h6 class="fw-bold mb-0 text-dark">#@Model.ConcreteTypeId</h6>
                </div>
            </div>

        </div>

        <!-- الوصف -->
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mt-3 p-3 bg-light rounded-3 border">
                <span class="text-muted d-block small mb-1">الوصف</span>
                <p class="mb-0 fw-semibold text-dark">@Model.Description</p>
            </div>
        }

        <!-- أزرار الإجراءات السفلية -->
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
            </a>
        </div>

    </div>

    <!-- العودة إلى القائمة -->
    <div class="d-flex gap-2 mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right"></i> العودة إلى القائمة
        </a>
    </div>

</div>