@model Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeViewModel

@{
    ViewData["Title"] = "تفاصيل نوع الخرسانة";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <nav aria-label="breadcrumb">

                <ol class="breadcrumb mb-2">

                    <li class="breadcrumb-item">
                        <a asp-controller="Home" asp-action="Index">
                            الرئيسية
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-action="Index">
                            أنواع الخرسانة
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        التفاصيل
                    </li>

                </ol>

            </nav>

            <h2 class="fw-bold">

                <i class="bi bi-box-seam text-warning"></i>

                تفاصيل نوع الخرسانة

            </h2>

            <p class="text-muted">

                عرض جميع بيانات نوع الخرسانة.

            </p>

        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.ConcreteTypeId"
               class="btn btn-warning text-white">

                <i class="bi bi-pencil"></i>

                تعديل

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-right"></i>

                رجوع

            </a>

        </div>

    </div>

    <div class="row g-3">

        <!-- Preview -->

        <div class="col-lg-4">

            <div class="card">

                <div class="card-body text-center">

                    <img id="detailsImage"
                         src="~/images/default-concrete.png"
                         asp-append-version="true"
                         data-record-image="@Model.ImageUrl"
                         class="concrete-preview-img rounded mb-3"
                         alt="Concrete Image" />

                    <h3 class="fw-bold">

                        @Model.Name

                    </h3>

                    <p class="text-muted">

                        خرسانة بقوة
                        @Model.Strength MPa

                    </p>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success fs-6">

                            نشط

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">

                            متوقف

                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- Details -->

        <div class="col-lg-8">

            <div class="card">

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label fw-bold">

                                اسم النوع

                            </label>

                            <input class="form-control"
                                   readonly
                                   value="@Model.Name" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-bold">

                                المقاومة

                            </label>

                            <input class="form-control"
                                   readonly
                                   value="@Model.Strength MPa" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-bold">

                                سعر المتر المكعب

                            </label>

                            <input class="form-control"
                                   readonly
                                   value="@Model.UnitPrice.ToString("N0") ر.ي" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-bold">

                                الحالة

                            </label>

                            <input class="form-control"
                                   readonly
                                   value="@(Model.IsActive ? "نشط" : "متوقف")" />

                        </div>

                        <div class="col-12">

                            <label class="form-label fw-bold">

                                رابط الصورة

                            </label>

                            <input class="form-control"
                                   readonly
                                   value="@Model.ImageUrl" />

                        </div>

                        <div class="col-12">

                            <label class="form-label fw-bold">

                                الوصف

                            </label>

                            <textarea class="form-control"
                                      rows="6"
                                      readonly>@Model.Description</textarea>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var img = document.getElementById("detailsImage");
            var record = img && img.getAttribute("data-record-image");
            if (record) img.src = record;
        });
    </script>
}