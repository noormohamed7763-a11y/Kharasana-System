@model Kharasana.Application.Common.PagedResult<Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeListItemViewModel>
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.ViewModels.Components

@{
    ViewData["Title"] = "أنواع الخرسانة";

    var total = Model.TotalCount;
    var active = Model.Items.Count(x => x.IsActive);
    var factories = Model.Items.Select(x => x.FactoryId).Distinct().Count();
    var avgPrice = Model.Items.Any()
        ? Model.Items.Average(x => x.UnitPrice)
        : 0;
}

<div class="dashboard-page">

    @{
        var role = (string?)ViewBag.UserRole;
        var factoryInactive = role == Roles.FactoryEmployee && ViewBag.FactoryIsActive == false;

        // الإنشاء للمدير وموظف المصنع فقط — مطابقةً لصلاحية الـ API (Create: AdminOrFactoryEmployee).
        // العميل يرى القائمة وحدها، فلا يُعرض له زر إضافة يفشل بـ 403.
        var canManage = role == Roles.Admin || role == Roles.FactoryEmployee;
    }

    @if (factoryInactive)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            مصنعك غير نشط حالياً، لذا لا يمكنك إضافة أو تعديل أنواع الخرسانة.
        </div>
    }

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-box-seam",
            Title = "أنواع الخرسانة",
            Description = "إدارة جميع أنواع الخرسانة داخل النظام",
            ActionText = canManage && !factoryInactive ? "إضافة نوع خرسانة" : string.Empty,
            ActionController = "ConcreteTypes",
            ActionMethod = "Create"
        })

    @if (canManage)
    {
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="nav nav-pills">
                <a asp-action="Index" class="nav-link active">
                    <i class="bi bi-box-seam me-1"></i> الأنواع النشطة
                </a>
                <a asp-action="Archived" class="nav-link">
                    <i class="bi bi-archive me-1"></i> الأنواع المؤرشفة
                </a>
            </div>
        </div>
    }

    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
            "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي الأنواع",
                            Value = total.ToString(),
                            Icon = "bi-grid-3x3-gap-fill",
                            IconClass = "kpi-icon-primary"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "الأنواع النشطة",
                            Value = active.ToString(),
                            Icon = "bi-check-circle-fill",
                            IconClass = "kpi-icon-success"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "عدد المصانع",
                            Value = factories.ToString(),
                            Icon = "bi-building",
                            IconClass = "kpi-icon-info"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "متوسط السعر",
                            Value = avgPrice.ToString("N0") + " ر.ي",
                            Icon = "bi-currency-exchange",
                            IconClass = "kpi-icon-warning"
                        })
    </div>

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث باسم النوع أو المصنع...",
                Value = (string?)ViewBag.Search ?? string.Empty
            }
        })

    @if (Model.Items == null || !Model.Items.Any())
    {
        @await Html.PartialAsync(
            "~/Views/Shared/Components/_EmptyState.cshtml",
            new EmptyStateViewModel
            {
                ImageUrl = "/images/empty-concrete.png",
                Title = "لا توجد أنواع خرسانة",
                Message = "لم يتم العثور على أي أنواع خرسانة تطابق معايير البحث.",
                ShowActionButton = canManage && !factoryInactive,
                ActionController = "ConcreteTypes",
                ActionAction = "Create",
                ActionText = "إضافة نوع خرسانة"
            })
    }
    else
    {
        ViewData["RowOffset"] = (Model.PageNumber - 1) * Model.PageSize;
        <partial name="_ConcreteTypeTable" model="Model.Items" />
    }

    <!-- الترقيم -->
    @await Html.PartialAsync("~/Views/Shared/Components/_Pagination.cshtml", new PaginationViewModel
    {
        CurrentPage = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = new Dictionary<string, string>
        {
            { "search", (string?)ViewBag.Search ?? string.Empty }
        }
    })

</div>

@section Scripts {
    <script src="~/js/concrete-type.js" asp-append-version="true"></script>
}