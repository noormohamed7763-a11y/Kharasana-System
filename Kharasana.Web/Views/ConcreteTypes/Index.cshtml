@model IEnumerable<Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeListItemViewModel>
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search

@{
    ViewData["Title"] = "أنواع الخرسانة";

    var total = Model.Count();
    var active = Model.Count(x => x.IsActive);
    var factories = Model.Select(x => x.FactoryId).Distinct().Count();
    var avgPrice = Model.Any()
        ? Model.Average(x => x.UnitPrice)
        : 0;
}

<div class="dashboard-page">

    @{
        var factoryInactive = (string?)ViewBag.UserRole == "FactoryEmployee" && ViewBag.FactoryIsActive == false;
    }

    @if (factoryInactive)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            مصنعك غير نشط حالياً، لذا لا يمكنك إضافة أو تعديل أنواع الخرسانة.
        </div>
    }

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-box-seam",
            Title = "أنواع الخرسانة",
            Description = "إدارة جميع أنواع الخرسانة داخل النظام",
            ActionText = factoryInactive ? string.Empty : "إضافة نوع خرسانة",
            ActionController = "ConcreteTypes",
            ActionMethod = "Create"
        })

    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
            "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي الأنواع",
                            Value = total.ToString(),
                            Icon = "bi-grid-3x3-gap-fill",
                            IconClass = "kpi-icon-primary"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "الأنواع النشطة",
                            Value = active.ToString(),
                            Icon = "bi-check-circle-fill",
                            IconClass = "kpi-icon-success"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "عدد المصانع",
                            Value = factories.ToString(),
                            Icon = "bi-building",
                            IconClass = "kpi-icon-info"
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "متوسط السعر",
                            Value = avgPrice.ToString("N0") + " ر.ي",
                            Icon = "bi-currency-exchange",
                            IconClass = "kpi-icon-warning"
                        })
    </div>

    @await Html.PartialAsync(
        "~/Views/Shared/Components/_Toolbar.cshtml",
        new ToolbarViewModel
        {
            ShowAddButton = !factoryInactive,
            AddButtonText = "إضافة نوع خرسانة",
            AddButtonAction = "Create",
            AddButtonController = "ConcreteTypes",
            ShowExport = false
        })

    <!-- Search -->
    <div class="mb-3">
        <div class="row align-items-center">
            <div class="col-lg-5">
                @await Html.PartialAsync(
                                "~/Views/Shared/Components/_SearchBox.cshtml",
                                new SearchBoxViewModel
                                {
                                    InputId = "tableSearch",
                                    Placeholder = "ابحث باسم النوع أو المصنع..."
                                })
            </div>
        </div>
    </div>

    <partial name="_ConcreteTypeTable" model="Model" />

</div>

@section Scripts {
    <script>
        document.getElementById("tableSearch").addEventListener("keyup", function () {
            const value = this.value.toLowerCase();
            document.querySelectorAll("tbody tr").forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
            });
        });
    </script>
}