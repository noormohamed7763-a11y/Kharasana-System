@model IEnumerable<Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeListItemViewModel>
@using Kharasana.Web.Models.Components
@{
    var role = (string?)ViewBag.UserRole;

    var factoryInactive = role == Roles.FactoryEmployee && ViewBag.FactoryIsActive == false;

    // من يملك التحرير: المدير وموظف المصنع — مطابقةً لصلاحيات الـ API
    // (Create/Update/Delete كلها AdminOrFactoryEmployee). العميل يرى القائمة
    // و«التفاصيل» فقط؛ وكانت أزرار التعديل والحذف تظهر له فيفشل بـ 403 من الـ API.
    var canManage = role == Roles.Admin || role == Roles.FactoryEmployee;
}

<div class="form-card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover erp-table erp-table--sticky-cols align-middle mb-0">

            <thead>

                <tr>

                    <th class="col-index">#</th>

                    <th>النوع</th>

                    <th>المقاومة</th>

                    <th>السعر</th>

                    <th>الحالة</th>

                    <th class="text-center col-actions col-actions--lg">
                        الإجراءات
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    var index = 1;

                    foreach (var item in Model)
                    {

                        <tr>

                            <td>

                                <span class="fw-bold text-secondary">
                                    @index
                                </span>

                            </td>

                            <td>

                                <div class="concrete-name">

                                    <div class="concrete-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    <div>

                                        <div class="concrete-title">
                                            @item.Name
                                        </div>

                                        <div class="concrete-subtitle">
                                            <i class="bi bi-building"></i>
                                            @item.FactoryName
                                        </div>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="strength-badge">
                                    <i class="bi bi-speedometer2"></i>
                                    @item.Strength MPa
                                </span>

                            </td>

                            <td>

                                <div class="price-display">
                                    <span class="price-value">@item.UnitPrice.ToString("N0")</span>
                                    <span class="price-unit">ر.ي / م³</span>
                                </div>

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-success">

                                        <i class="bi bi-check-circle-fill"></i>

                                        نشط

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-danger">

                                        <i class="bi bi-x-circle-fill"></i>

                                        متوقف

                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.ConcreteTypeId"
                                   class="btn btn-light action-btn"
                                   aria-label="التفاصيل">

                                    <i class="bi bi-eye"></i>

                                </a>

                                @if (canManage && !factoryInactive)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ConcreteTypeId"
                                       class="btn btn-warning text-white action-btn"
                                       aria-label="تعديل">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @* الأرشفة (حذف ناعم) متاحة لموظف المصنع كما للمدير — عقد الـ API
                                       نفسه، وصفحة الأرشيف تعيده. وقبل ذلك كان الزر للمدير وحده
                                       فتبقى صفحة الأرشيف فارغة أبداً للموظف. *@
                                    <form asp-action="Delete"
                                      asp-route-id="@item.ConcreteTypeId"
                                      method="post"
                                      class="d-inline"
                                       data-confirm="هل أنت متأكد من حذف نوع الخرسانة؟">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger action-btn"
                                            aria-label="حذف">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                    </form>
                                }

                            </td>

                        </tr>

                        index++;
                    }
                }
                else
                {

                    <tr>

                        <td colspan="6">

                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_EmptyState.cshtml",
                            new EmptyStateViewModel
                            {
                                ImageUrl = "/images/empty-concrete.png",
                                Title = "لا توجد أنواع خرسانة",
                                Message = "قم بإضافة أول نوع خرسانة ليظهر هنا.",
                                ShowActionButton = canManage && !factoryInactive,
                                ActionController = "ConcreteTypes",
                                ActionAction = "Create",
                                ActionText = "إضافة نوع خرسانة"
                            })

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>