@model IEnumerable<Kharasana.Web.ViewModels.ConcreteTypes.ConcreteTypeListItemViewModel>
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.Helpers

@{
    ViewData["Title"] = "أنواع الخرسانة المؤرشفة";
}

<div class="dashboard-page">

    @await Html.PartialAsync(
        "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-archive",
            Title = "أنواع الخرسانة المؤرشفة",
            Description = "أنواع الخرسانة المحذوفة، مع إمكانية استعادتها إلى القائمة النشطة."
        })

    <!-- Navigation Pills -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="nav nav-pills">
            <a asp-action="Index" class="nav-link">
                <i class="bi bi-box-seam me-1"></i> الأنواع النشطة
            </a>
            <a asp-action="Archived" class="nav-link active">
                <i class="bi bi-archive me-1"></i> الأنواع المؤرشفة
            </a>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
        </a>
    </div>

    @if (Model.Any())
    {
        <!-- Search & Toolbar -->
        <div class="erp-section-card mb-3 p-3 shadow-sm">
            <div class="row g-2 align-items-center">
                <div class="col-lg-6">
                    @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SearchBox.cshtml",
                        new SearchBoxViewModel
                        {
                            InputId = "tableSearch",
                            Placeholder = "ابحث باسم النوع أو المصنع..."
                        })
                </div>
                <div class="col-auto ms-auto d-flex align-items-center gap-3">
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        البحث يعمل داخل الصفحة الحالية
                    </span>
                </div>
            </div>
        </div>
    }

    <div class="erp-section-card p-0 shadow-sm mb-4">
        <!-- Desktop Table View (>= 768px) -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover erp-table erp-table--sticky-cols align-middle mb-0">
                <caption class="visually-hidden">أصناف الخرسانة المؤرشفة</caption>
                <thead>
                    <tr>
                        <th class="col-index">#</th>
                        <th>النوع والمصنع</th>
                        <th>المقاومة</th>
                        <th>السعر</th>
                        <th class="col-date">تاريخ الأرشفة</th>
                        <th class="text-center col-actions col-actions--lg">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-secondary">@index</span>
                                </td>
                                <td>
                                    <div class="concrete-name d-flex align-items-center gap-2">
                                        <div class="concrete-icon">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div>
                                            <div class="concrete-title fw-bold">@item.Name</div>
                                            <div class="concrete-subtitle text-muted small">
                                                <i class="bi bi-building me-1"></i>@item.FactoryName
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="strength-badge">
                                        <i class="bi bi-speedometer2 me-1"></i>@item.Strength MPa
                                    </span>
                                </td>
                                <td>
                                    <div class="price-display">
                                        <span class="price-value fw-bold">@item.UnitPrice.ToString("N0")</span>
                                        <span class="price-unit text-muted small">ر.ي / م³</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @item.UpdatedAt.FormatDate()
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="Restore"
                                          asp-route-id="@item.ConcreteTypeId"
                                          method="post"
                                          class="d-inline"
                                          data-confirm="هل أنت متأكد من استعادة نوع الخرسانة هذا؟ سيظهر مجدداً في قائمة الأنواع النشطة.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-success btn-sm"
                                                title="استعادة"
                                                aria-label="استعادة">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> استعادة
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                @await Html.PartialAsync(
                                    "~/Views/Shared/Components/_EmptyState.cshtml",
                                    new EmptyStateViewModel
                                    {
                                        Icon = "bi-archive",
                                        Title = "لا توجد أنواع خرسانة مؤرشفة",
                                        Message = "أنواع الخرسانة التي تُحذف ستظهر هنا لإمكانية استعادتها."
                                    })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards View (< 768px) -->
        <div class="d-md-none p-3">
            @if (Model.Any())
            {
                var mIndex = 1;
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model)
                    {
                        <div class="card border rounded-3 shadow-none p-3 position-relative">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-dark fw-bold">#@mIndex</span>
                                    <h6 class="mb-0 fw-bold">@item.Name</h6>
                                </div>
                                <span class="badge bg-secondary">مؤرشف</span>
                            </div>
                            <div class="text-muted small mb-2">
                                <i class="bi bi-building me-1"></i>@item.FactoryName
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <span class="strength-badge me-2">
                                        <i class="bi bi-speedometer2 me-1"></i>@item.Strength MPa
                                    </span>
                                    <span class="fw-bold text-primary">
                                        @item.UnitPrice.ToString("N0") <small class="text-muted">ر.ي/م³</small>
                                    </span>
                                </div>
                                <div>
                                    <form asp-action="Restore"
                                          asp-route-id="@item.ConcreteTypeId"
                                          method="post"
                                          class="d-inline"
                                          data-confirm="هل أنت متأكد من استعادة نوع الخرسانة هذا؟ سيظهر مجدداً في قائمة الأنواع النشطة.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                aria-label="استعادة">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> استعادة
                                        </button>
                                    </form>
                                </div>
                            </div>
                            @if (item.UpdatedAt.HasValue)
                            {
                                <div class="text-muted smaller text-end mt-2 pt-1 border-top">
                                    <i class="bi bi-clock me-1"></i>أُرشف في: @item.UpdatedAt.FormatDate()
                                </div>
                            }
                        </div>
                        mIndex++;
                    }
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/concrete-type.js" asp-append-version="true"></script>
}
