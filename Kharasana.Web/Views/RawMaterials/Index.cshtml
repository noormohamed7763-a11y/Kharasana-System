@model Kharasana.Application.Common.PagedResult<Kharasana.Web.ViewModels.RawMaterials.RawMaterialViewModel>
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.ViewModels.Components

@{
    ViewData["Title"] = "إدارة المخزون";
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-box-seam",
            Title = "إدارة المخزون",
            Description = "متابعة وإدارة المواد الخام المتوفرة",
            ActionText = "إضافة مادة خام",
            ActionController = "RawMaterials",
            ActionMethod = "Create"
        })

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث باسم المادة...",
                Value = (string?)ViewBag.SearchTerm ?? string.Empty
            }
        })

    @if (Model.Items == null || !Model.Items.Any())
    {
        @await Html.PartialAsync(
            "~/Views/Shared/Components/_EmptyState.cshtml",
            new EmptyStateViewModel
            {
                Title = "لا توجد مواد خام",
                Message = "لم يتم العثور على أي مواد خام تطابق معايير البحث.",
                ShowActionButton = true,
                ActionController = "RawMaterials",
                ActionAction = "Create",
                ActionText = "إضافة مادة خام"
            })
    }
    else
    {
        <div class="erp-section-card p-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="erp-table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>اسم المادة</th>
                            <th>الرصيد المخزني الحالي</th>
                            <th>الوحدة</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <i class="bi bi-layers text-secondary me-2"></i>@item.Name
                                </td>
                                <td dir="ltr" class="text-end fw-semibold">@item.CurrentStock.ToString("N2")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@item.Unit</span></td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.RawMaterialId" class="btn btn-sm btn-outline-secondary px-3">
                                        <i class="bi bi-eye me-1"></i>التفاصيل
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- الترقيم -->
    @await Html.PartialAsync("~/Views/Shared/Components/_Pagination.cshtml", new PaginationViewModel
    {
        CurrentPage = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = new Dictionary<string, string>
        {
            { "searchTerm", (string?)ViewBag.SearchTerm ?? string.Empty }
        }
    })

</div>
