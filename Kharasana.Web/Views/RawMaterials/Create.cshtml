@model Kharasana.Web.ViewModels.RawMaterials.CreateRawMaterialViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إضافة مادة خام";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-plus-circle",
            Title = "إضافة مادة خام",
            Description = "إضافة مادة خام جديدة إلى مخزون المصنع."
        })

    <div class="form-card shadow-sm">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label">اسم المادة</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="InitialStock" class="form-label">الكمية الأولية</label>
                <input asp-for="InitialStock" type="number" step="0.001" class="form-control" />
                <span asp-validation-for="InitialStock" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Unit" class="form-label">الوحدة</label>
                <input asp-for="Unit" class="form-control" />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-check-circle"></i> حفظ المادة
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
