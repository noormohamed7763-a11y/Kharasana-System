@model Kharasana.Web.ViewModels.Settings.FactorySettingsViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إعدادات المصنع";
}

<div class="dashboard-page dashboard-page--narrow">

    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "إعدادات المصنع",
                 Description = "عرض بيانات مصنعك وإدارة شعاره"
             }' />

    @if (Model == null)
    {
        <div class="erp-section-card text-center text-muted">
            <i class="bi bi-exclamation-triangle display-6 d-block mb-2"></i>
            تعذر تحميل بيانات المصنع الخاص بك.
        </div>
    }
    else
    {
        <!-- 1. بيانات المصنع (للعرض فقط) -->
        <div class="erp-section-card">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                بيانات المصنع
            </h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="detail-group">
                        <span class="detail-label"><i class="bi bi-building me-1"></i>اسم المصنع</span>
                        <div class="detail-value fw-bold">@Model.FactoryName</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-group">
                        <span class="detail-label"><i class="bi bi-person me-1"></i>اسم المالك</span>
                        <div class="detail-value fw-bold">@(string.IsNullOrEmpty(Model.OwnerName) ? "-" : Model.OwnerName)</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-group">
                        <span class="detail-label"><i class="bi bi-telephone me-1"></i>رقم الهاتف</span>
                        <div class="detail-value fw-bold" dir="ltr">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-group">
                        <span class="detail-label"><i class="bi bi-geo-alt me-1"></i>المنطقة</span>
                        <div class="detail-value fw-bold">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-group">
                        <span class="detail-label"><i class="bi bi-activity me-1"></i>الحالة</span>
                        <div class="detail-value">
                            <span class="status-badge @(Model.IsActive ? "status-success" : "status-danger")">
                                <span class="status-dot"></span>
                                @(Model.IsActive ? "نشط" : "متوقف")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-3 mb-0 small text-muted">
                <i class="bi bi-lock me-1"></i>
                هذه البيانات لا يمكن تعديلها إلا من قِبل إدارة النظام.
            </div>
        </div>

        <!-- 2. إدارة الشعار -->
        <div class="erp-section-card">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-image text-primary me-2"></i>
                شعار المصنع
            </h5>

            <div class="row g-3 align-items-end">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="شعار المصنع"
                             data-name="@Model.FactoryName"
                             id="logoPreview"
                             class="logo-preview"
                             data-img-error="logo" />
                    }
                    else
                    {
                        <div class="logo-preview--empty">
                            <i class="bi bi-building fs-1 text-muted"></i>
                            <span class="text-muted small mt-2">لا يوجد شعار</span>
                        </div>
                    }
                </div>

                <div class="col-md-5">
                    <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" id="uploadLogoForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="logoFile" class="form-label fw-bold">اختر ملف الشعار الجديد</label>
                            <input type="file"
                                   class="form-control"
                                   id="logoFile"
                                   name="logoFile"
                                   accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                الصيغ المدعومة: JPG, PNG, WEBP. الحد الأقصى: 5 ميجابايت.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="uploadLogoBtn" disabled>
                            <i class="bi bi-upload me-1"></i>
                            رفع الشعار
                        </button>
                    </form>
                </div>

                <div class="col-md-4 text-md-end">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <form asp-action="DeleteLogo" method="post" id="deleteLogoForm" data-confirm="هل أنت متأكد من حذف شعار المصنع؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>
                                حذف الشعار الحالي
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="mt-3 text-muted small">
                <i class="bi bi-lightbulb me-1"></i>
                عند رفع شعار جديد، سيتم حذف الشعار القديم تلقائياً.
            </div>
        </div>

        <!-- 3. تنظيف ملفات الصور اليتيمة -->
        <div class="erp-section-card">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-trash text-primary me-2"></i>
                تنظيف ملفات الصور
            </h5>

            <p class="text-muted small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                مع مرور الوقت، قد تبقى ملفات صور غير مرتبطة بأي مصنع أو مستخدم
                (بعد حذف شعار أو صورة حساب). هذا الإجراء يفحص مجلد الصور ويحذف
                الملفات اليتيمة فقط — لا يمس أي ملف مستخدم حالياً.
            </p>

            <form asp-action="CleanupImages" method="post" id="cleanupImagesForm"
                  data-confirm="هل أنت متأكد من تشغيل تنظيف ملفات الصور؟ سيتم حذف الملفات غير المرتبطة فقط.">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary" id="cleanupImagesBtn">
                    <i class="bi bi-broom me-1"></i>
                    تشغيل التنظيف الآن
                </button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/factories.js" asp-append-version="true"></script>
}