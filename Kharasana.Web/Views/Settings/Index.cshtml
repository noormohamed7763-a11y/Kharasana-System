@model Kharasana.Web.Models.Settings.FactorySettingsViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إعدادات المصنع";
}

<div class="dashboard-page">

    <partial name="Components/_PageHeader"
             model='new PageHeaderViewModel
             {
                 Title = "إعدادات المصنع",
                 Description = "عرض بيانات مصنعك وإدارة شعاره"
             }' />

    @if (Model == null)
    {
        <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4 text-center text-muted">
            <i class="bi bi-exclamation-triangle display-6 d-block mb-2"></i>
            تعذر تحميل بيانات المصنع الخاص بك.
        </div>
    }
    else
    {
        <!-- 1. بيانات المصنع (للعرض فقط) -->
        <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                بيانات المصنع
            </h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted d-block small mb-1">اسم المصنع</span>
                        <h6 class="fw-bold mb-0 text-dark">@Model.FactoryName</h6>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted d-block small mb-1">اسم المالك</span>
                        <h6 class="fw-bold mb-0 text-dark">@(string.IsNullOrEmpty(Model.OwnerName) ? "-" : Model.OwnerName)</h6>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted d-block small mb-1">رقم الهاتف</span>
                        <h6 class="fw-bold mb-0 text-dark" dir="ltr">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</h6>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted d-block small mb-1">المنطقة</span>
                        <h6 class="fw-bold mb-0 text-dark">@(string.IsNullOrEmpty(Model.Area) ? "-" : Model.Area)</h6>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted d-block small mb-1">الحالة</span>
                        <h6 class="fw-bold mb-0 @(Model.IsActive ? "text-success" : "text-danger")">
                            @(Model.IsActive ? "نشط" : "متوقف")
                        </h6>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-3 mb-0 small text-muted">
                <i class="bi bi-lock me-1"></i>
                هذه البيانات لا يمكن تعديلها إلا من قِبل إدارة النظام.
            </div>
        </div>

        <!-- 2. إدارة الشعار -->
        <div class="erp-section-card bg-white p-4 rounded-3 shadow-sm border mt-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-image text-primary me-2"></i>
                شعار المصنع
            </h5>

            <div class="row g-3 align-items-end">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="شعار المصنع"
                             data-name="@Model.FactoryName"
                             id="logoPreview"
                             style="width:120px; height:120px; object-fit:cover; border-radius:50%; border:3px solid #dee2e6; background:#f8f9fa;"
                             onerror="handleLogoError(this);" />
                    }
                    else
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center bg-light rounded-circle border"
                             style="width:120px; height:120px; margin:0 auto;">
                            <i class="bi bi-building fs-1 text-muted"></i>
                            <span class="text-muted small mt-2">لا يوجد شعار</span>
                        </div>
                    }
                </div>

                <div class="col-md-5">
                    <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" id="uploadLogoForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="logoFile" class="form-label fw-bold">اختر ملف الشعار الجديد</label>
                            <input type="file"
                                   class="form-control"
                                   id="logoFile"
                                   name="logoFile"
                                   accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text text-muted small">
                                <i class="bi bi-info-circle me-1"></i>
                                الصيغ المدعومة: JPG, PNG, WEBP. الحد الأقصى: 5 ميجابايت.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary" id="uploadLogoBtn" disabled>
                            <i class="bi bi-upload me-1"></i>
                            رفع الشعار
                        </button>
                    </form>
                </div>

                <div class="col-md-4 text-md-end">
                    @if (!string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <form asp-action="DeleteLogo" method="post" id="deleteLogoForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirmDeleteLogo();">
                                <i class="bi bi-trash me-1"></i>
                                حذف الشعار الحالي
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="mt-3 text-muted small">
                <i class="bi bi-lightbulb me-1"></i>
                عند رفع شعار جديد، سيتم حذف الشعار القديم تلقائياً.
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/factories.js" asp-append-version="true"></script>
}