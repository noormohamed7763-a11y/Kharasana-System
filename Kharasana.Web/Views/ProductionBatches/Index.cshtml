@model Kharasana.Application.Common.PagedResult<Kharasana.Web.ViewModels.ProductionBatches.ProductionBatchViewModel>
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search
@using Kharasana.Web.ViewModels.Components

@{
    ViewData["Title"] = "إدارة الإنتاج";
}

<div class="dashboard-page">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-gear-wide-connected",
            Title = "إدارة الإنتاج",
            Description = "متابعة دفعات الإنتاج",
            ActionText = "إضافة دفعة إنتاج",
            ActionController = "ProductionBatches",
            ActionMethod = "Create"
        })

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث برقم الدفعة...",
                Value = (string?)ViewBag.SearchTerm ?? string.Empty
            }
        })

    @if (Model.Items == null || !Model.Items.Any())
    {
        @await Html.PartialAsync(
            "~/Views/Shared/Components/_EmptyState.cshtml",
            new EmptyStateViewModel
            {
                Title = "لا توجد دفعات إنتاج",
                Message = "لم يتم العثور على أي دفعات إنتاج تطابق معايير البحث.",
                ShowActionButton = true,
                ActionController = "ProductionBatches",
                ActionAction = "Create",
                ActionText = "إضافة دفعة إنتاج"
            })
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الدفعة</th>
                            <th>تاريخ الإنتاج</th>
                            <th>نوع الخرسانة</th>
                            <th>الكمية المخططة</th>
                            <th>الكمية الفعلية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.BatchNumber</td>
                                <td>@item.ProductionDate.ToShortDateString()</td>
                                <td>@item.ConcreteTypeName</td>
                                <td>@item.PlannedQuantity</td>
                                <td>@item.ActualQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- الترقيم -->
    @await Html.PartialAsync("~/Views/Shared/Components/_Pagination.cshtml", new PaginationViewModel
    {
        CurrentPage = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = new Dictionary<string, string>
        {
            { "searchTerm", (string?)ViewBag.SearchTerm ?? string.Empty }
        }
    })

</div>
