@model Kharasana.Web.ViewModels.ProductionBatches.CreateProductionBatchViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "إضافة دفعة إنتاج";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-plus-circle",
            Title = "إضافة دفعة إنتاج",
            Description = "إضافة دفعة إنتاج جديدة."
        })

    <div class="form-card shadow-sm">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="BatchNumber" class="form-label">رقم الدفعة</label>
                <input asp-for="BatchNumber" class="form-control" />
                <span asp-validation-for="BatchNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProductionDate" class="form-label">تاريخ الإنتاج</label>
                <input asp-for="ProductionDate" type="date" class="form-control" />
                <span asp-validation-for="ProductionDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConcreteTypeId" class="form-label">نوع الخرسانة</label>
                <select asp-for="ConcreteTypeId" class="form-select">
                    <option value="">-- اختر نوع الخرسانة --</option>
                </select>
                <span asp-validation-for="ConcreteTypeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PlannedQuantity" class="form-label">الكمية المخططة</label>
                <input asp-for="PlannedQuantity" type="number" step="0.001" class="form-control" />
                <span asp-validation-for="PlannedQuantity" class="text-danger"></span>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> إلغاء
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-check-circle"></i> حفظ الدفعة
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}