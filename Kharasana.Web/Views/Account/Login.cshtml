@model Kharasana.Web.ViewModels.Auth.LoginViewModel
@using Kharasana.Web.Controllers

@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kharasana ERP | تسجيل الدخول</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" integrity="sha384-dpuaG1suU0eT09tx5plTaGMLBsfDLzUCCUXOY2j/LSvXYuG6Bqs43ALlhIqAJVRb" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <div class="login-wrapper">
        <div class="login-card">

            <!-- ========== القسم الأيمن: نموذج تسجيل الدخول (فاتح) ========== -->
            <section class="login-panel">
                <div class="login-box">

                    <div class="login-header">
                        <h2>تسجيل الدخول</h2>
                        <p>أدخل بياناتك للوصول إلى لوحة التحكم.</p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          autocomplete="off"
                          novalidate>

                        @Html.AntiForgeryToken()

                        @if (TempData[BaseController.TempDataError] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                                <i class="bi bi-shield-lock"></i>
                                <span>@TempData[BaseController.TempDataError]</span>
                            </div>
                        }
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <!-- حقل المستخدم -->
                        <div class="form-group mb-3">
                            <label asp-for="EmailOrPhone" class="form-label">البريد الإلكتروني أو الهاتف</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="EmailOrPhone"
                                       class="form-control"
                                       placeholder="أدخل البريد الإلكتروني أو رقم الهاتف"
                                       required />
                            </div>
                            <span asp-validation-for="EmailOrPhone" class="text-danger"></span>
                        </div>

                        <!-- حقل كلمة المرور -->
                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label">كلمة المرور</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password"
                                       id="passwordInput"
                                       class="form-control"
                                       placeholder="********"
                                       required />
                                <button type="button"
                                        id="togglePassword"
                                        class="btn btn-outline-secondary password-toggle"
                                        aria-label="إظهار أو إخفاء كلمة المرور">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- تذكرني -->
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                            <label asp-for="RememberMe" class="form-check-label" for="rememberMe">
                                تذكرني على هذا الجهاز
                            </label>
                        </div>

                        <!-- زر الدخول -->
                        <button type="submit" class="btn btn-login w-100" id="loginButton">
                            <span id="loginText">
                                <i class="bi bi-box-arrow-in-left ms-2"></i>
                                دخول إلى النظام
                            </span>
                            <span id="loadingText" class="d-none">
                                <span class="spinner-border spinner-border-sm ms-2"></span>
                                جاري التحقق من البيانات...
                            </span>
                        </button>

                    </form>
                </div>
            </section>

            <!-- ========== القسم الأيسر: الهوية المؤسسية والشعار (داكن) ========== -->
            <section class="brand-panel">
                <div class="brand-content">

                    <div class="brand-logo">
                        <img src="~/images/logo.png" alt="Kharasana ERP" class="brand-logo-img" asp-append-version="true" />
                    </div>

                    <h2 class="brand-name">Kharasana ERP</h2>
                    <p class="brand-description">نظام إدارة المصانع المتكامل</p>

                    <div class="brand-divider"></div>

                    <div class="features-list">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="feature-text">
                                <h5>إدارة الطلبات</h5>
                                <span>متابعة وإدارة جميع الطلبات بسهولة وكفاءة عالية.</span>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="feature-text">
                                <h5>إدارة المصانع</h5>
                                <span>متابعة الإنتاج وإدارة بيانات المصانع بدقة.</span>
                            </div>
                        </div>

                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div class="feature-text">
                                <h5>إدارة السائقين</h5>
                                <span>إدارة المركبات وخطوط التوصيل بفعالية.</span>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>