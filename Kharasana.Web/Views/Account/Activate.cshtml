@model Kharasana.Web.ViewModels.Auth.ActivateAccountViewModel

@{
    Layout = null;
    ViewData["Title"] = "تفعيل الحساب وتعيين كلمة المرور";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Kharasana ERP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" integrity="sha384-dpuaG1suU0eT09tx5plTaGMLBsfDLzUCCUXOY2j/LSvXYuG6Bqs43ALlhIqAJVRb" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <div class="login-wrapper">
        <div class="card shadow-lg border-0" style="width: 520px; max-width: 100%; border-radius: var(--radius); background: #ffffff; overflow: hidden;">
            <div class="p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: rgba(194, 65, 12, 0.1); color: var(--primary);">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h2 class="fw-bold mb-1" style="color: var(--text-light); font-size: 1.6rem;">تفعيل الحساب</h2>
                    <p class="text-muted small mb-0">يرجى تعيين كلمة مرور جديدة لتفعيل حسابك والبدء باستخدام النظام.</p>
                </div>

                <form asp-action="Activate" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="TokenHash" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold small text-dark">
                            <i class="bi bi-lock me-1"></i> كلمة المرور الجديدة
                        </label>
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" required style="height: 46px; border-radius: 8px;" />
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small text-dark">
                            <i class="bi bi-shield-check me-1"></i> تأكيد كلمة المرور
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required style="height: 46px; border-radius: 8px;" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-4 small text-muted">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        يجب أن تتكون كلمة المرور من 8 خانات على الأقل وتحتوي على حرف كبير ورقم.
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="border-radius: 8px; font-size: 1rem; background-color: var(--primary); border-color: var(--primary);">
                        <i class="bi bi-check-circle me-1"></i> تفعيل وتعيين كلمة المرور
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-right me-1"></i> العودة لتسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>