@model Kharasana.Web.ViewModels.Dashboard.DashboardViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Domain.Enums

@{
    // ===== رسم "توزيع الطلبات النشطة" =====
    // الحالات الثلاث التي يبقى فيها الطلب منتظراً إجراءً، ويُحصيها الـ API كعدّادات
    // تراكمية. لا شريحة رابعة باسم "جديدة": كل مسارات الإنشاء تُنشئ بحالة Pending
    // و OrderStatus.New لا يُسنَد أبداً — وكانت تُستعار لها قيمة «طلبات اليوم»
    // (كل الحالات) فيظهر في الرسم ما لا وجود له في البيانات.
    var factoryOrdersJson = System.Text.Json.JsonSerializer.Serialize(new[]
    {
        new { label = "قيد التنفيذ", count = Model.InProgressOrdersCount },
        new { label = "جاهزة للتسليم", count = Model.ReadyOrdersCount },
        new { label = "قيد النقل", count = Model.OnTheWayOrders }
    });

    // ===== حسابات بطاقة "تقدم تشغيل اليوم" =====
    // حجم العمل المفتوح الآن = الحالات الثلاث.
    // ⚠️ لا يدخل فيه Model.TodayOrdersCount: ذاك عدّاد زمني (طلبات أُنشئت اليوم بأي
    //    حالة) وهذه عدّادات حالة تراكمية بلا حدّ زمني، فجمعهما كان يُحصي مرتين كل
    //    طلب أُنشئ اليوم وما زال مفتوحاً — فيتضخّم "قيد المعالجة" والنسبة والأشرطة.
    var activeOrdersCount = Model.InProgressOrdersCount + Model.ReadyOrdersCount + Model.OnTheWayOrders;

    // مقام النسبة: المفتوح الآن + ما سُلِّم اليوم. هذا مجموع «ما اشتغل عليه المصنع»،
    // وليس «طلبات اليوم» — فلا يُعرض تحت ذلك العنوان.
    var workloadToday = activeOrdersCount + Model.DeliveredToday;
    var progressPercent = workloadToday > 0 ? (int)Math.Round((double)Model.DeliveredToday / workloadToday * 100) : 0;
}

<div class="dashboard-page">

    <!-- T1. Page Header Component -->
    <partial name="Components/_PageHeader" model='new PageHeaderViewModel { Title = "لوحة تشغيل المصنع", Description = $"{Kharasana.Web.Helpers.GreetingHelper.Greeting()}، {ViewBag.UserName} — متابعة العمليات وإدارة الطلبات اليومية" }' />

    <!-- T2. Operational Summary Cards Component (قابلة للنقر → قوائم العمل) -->
    <div class="summary-cards-grid mb-4">
        <partial name="Components/_SummaryCard" model='new SummaryCardViewModel { Title = "طلبات اليوم", Value = Model.TodayOrdersCount.ToString(), Icon = "bi-calendar-check", IconClass = "kpi-icon-primary", LinkUrl = Url.Action("Index", "Orders") }' />
        <partial name="Components/_SummaryCard" model='new SummaryCardViewModel { Title = "قيد التنفيذ", Value = Model.InProgressOrdersCount.ToString(), Icon = "bi-hourglass-split", IconClass = "kpi-icon-warning", LinkUrl = Url.Action("Index", "Orders", new { status = (int)OrderStatus.Pending }) }' />
        <partial name="Components/_SummaryCard" model='new SummaryCardViewModel { Title = "جاهزة للتسليم", Value = Model.ReadyOrdersCount.ToString(), Icon = "bi-check2-all", IconClass = "kpi-icon-success", LinkUrl = Url.Action("Index", "Orders", new { status = (int)OrderStatus.Approved }) }' />
        <partial name="Components/_SummaryCard" model='new SummaryCardViewModel { Title = "السائقون المتاحون", Value = Model.AvailableDrivers.ToString(), Icon = "bi-truck", IconClass = "kpi-icon-info", LinkUrl = Url.Action("Index", "Drivers") }' />
    </div>

    <!-- T2.5. Order Status Chart + Operational Progress -->
    <div class="row g-4 mb-4">
        <!-- حالة الطلبات النشطة (Doughnut) -->
        <div class="col-xl-7 col-lg-12">
            <div class="erp-section-card">
                <div class="mb-3">
                    <h5 class="erp-section-title"><i class="bi bi-pie-chart-fill"></i>توزيع الطلبات النشطة</h5>
                </div>
                <div class="chart-container d-flex align-items-center justify-content-center">
                    <canvas id="factoryOrdersChart"
                            role="img"
                            aria-label="رسم بياني دائري لتوزيع الطلبات النشطة: قيد التنفيذ وجاهزة للتسليم وقيد النقل"
                            aria-describedby="factoryOrdersDataTable"
                            data-chart-values='@Html.Raw(factoryOrdersJson)'></canvas>
                    @* جدول بديل لقارئات الشاشة *@
                    <table id="factoryOrdersDataTable" class="visually-hidden">
                        <caption>توزيع الطلبات النشطة</caption>
                        <thead>
                            <tr><th scope="col">الحالة</th><th scope="col">العدد</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>قيد التنفيذ</td><td>@Model.InProgressOrdersCount</td></tr>
                            <tr><td>جاهزة للتسليم</td><td>@Model.ReadyOrdersCount</td></tr>
                            <tr><td>قيد النقل</td><td>@Model.OnTheWayOrders</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- تقدم تشغيل اليوم -->
        <div class="col-xl-5 col-lg-12">
            <div class="erp-section-card">
                <div class="mb-3">
                    <h5 class="erp-section-title"><i class="bi bi-graph-up-arrow"></i>تقدم تشغيل اليوم</h5>
                </div>
                <div class="progress-overview">
                    <div class="progress-metric">
                        <span class="progress-metric-label">طلبات قيد المعالجة</span>
                        <strong class="progress-metric-value">@activeOrdersCount</strong>
                    </div>
                    <div class="progress-metric">
                        <span class="progress-metric-label">تم التسليم اليوم</span>
                        <strong class="progress-metric-value progress-metric-success">@Model.DeliveredToday</strong>
                    </div>
                    <div class="progress-metric">
                        <span class="progress-metric-label">السائقون المتاحون</span>
                        <strong class="progress-metric-value progress-metric-info">@Model.AvailableDrivers</strong>
                    </div>
                    <div class="progress-track">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="progress-percent">@progressPercent%</span>
                            <span class="progress-caption">@Model.DeliveredToday مُسلَّم من @workloadToday (مفتوح + مُسلَّم اليوم)</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @progressPercent%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- T3. Operational Quick Actions -->
    <div class="erp-section-card mb-3">
        <div class="mb-3">
            <h5 class="erp-section-title">
                <i class="bi bi-lightning-charge"></i>
                الإجراءات السريعة للتشغيل
            </h5>
        </div>

        <div class="summary-cards-grid">

            <partial name="Components/_QuickActionButton"
                     model='new QuickActionButtonViewModel
                     {
                         Text = "إنشاء طلب جديد",
                         Description = "إضافة طلب خرسانة جديد",
                         Icon = "bi-plus-circle",
                         CssClass = "quick-action-primary",
                         Controller = "Orders",
                         Action = "Create"
                     }' />

            <partial name="Components/_QuickActionButton"
                     model='new QuickActionButtonViewModel
                     {
                         Text = "إنشاء طلب هاتفي",
                         Description = "استقبال طلب عبر الاتصال",
                         Icon = "bi-telephone-plus",
                         CssClass = "quick-action-success",
                         Controller = "Orders",
                         Action = "Create"
                     }' />

            <partial name="Components/_QuickActionButton"
                     model='new QuickActionButtonViewModel
                     {
                         Text = "تعيين سائق",
                         Description = "ربط الشاحنات بالطلبات",
                         Icon = "bi-truck",
                         CssClass = "quick-action-warning",
                         Controller = "Orders",
                         Action = "Index"
                     }' />

            <partial name="Components/_QuickActionButton"
                     model='new QuickActionButtonViewModel
                     {
                         Text = "تحديث الحالة",
                         Description = "متابعة مسار وتطور الطلب",
                         Icon = "bi-arrow-repeat",
                         CssClass = "quick-action-neutral",
                         Controller = "Orders",
                         Action = "Index"
                     }' />

        </div>
    </div>

    <!-- T4. Today's Operational Orders Table -->
    <div class="erp-section-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="erp-section-title">
                <i class="bi bi-clipboard-check"></i>
                أحدث طلبات المصنع
            </h5>

            <a asp-controller="Orders"
               asp-action="Index"
               class="btn-erp-outline">
                إدارة كافة الطلبات
            </a>
        </div>

        @{
            // الشرائح هي الحالات الثلاث نفسها، فمجموعها 100% من الشريط بلا شريحة زائدة.
            var totalOps = activeOrdersCount;
            var pPending = totalOps > 0 ? (double)Model.InProgressOrdersCount / totalOps * 100 : 0;
            var pApproved = totalOps > 0 ? (double)Model.ReadyOrdersCount / totalOps * 100 : 0;
            var pOnWay = totalOps > 0 ? (double)Model.OnTheWayOrders / totalOps * 100 : 0;
        }

        <!-- حالة الطلبات — شريط بصري -->
        <div class="order-status-bar mb-3" title="توزيع الطلبات حسب الحالة">
            <div class="order-status-segment" style="width: @pPending.ToString("0")%; background: var(--warning);"></div>
            <div class="order-status-segment" style="width: @pApproved.ToString("0")%; background: var(--success);"></div>
            <div class="order-status-segment" style="width: @pOnWay.ToString("0")%; background: var(--info);"></div>
        </div>

        <!-- فلاتر سريعة للحالة -->
        <div class="d-flex gap-2 mb-3 flex-wrap order-filter-buttons">
            <button type="button" class="btn btn-sm btn-primary order-filter-btn active" data-filter="All">الكل</button>
            <button type="button" class="btn btn-sm btn-outline-primary order-filter-btn" data-filter="New">جديدة</button>
            <button type="button" class="btn btn-sm btn-outline-warning order-filter-btn" data-filter="Pending">قيد التنفيذ</button>
            <button type="button" class="btn btn-sm btn-outline-success order-filter-btn" data-filter="Approved">جاهزة للتسليم</button>
            <button type="button" class="btn btn-sm btn-outline-info order-filter-btn" data-filter="OnTheWay">قيد النقل</button>
        </div>

        <div class="table-responsive">
            <table class="table erp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>الحالة</th>
                        <th>السائق المسند</th>
                        <th>تاريخ الإنشاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody id="factoryOrdersTableBody">

                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr data-status="@order.Status">

                                <td class="fw-bold">
                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="order-number-chip"
                                       title="@order.OrderNumber">
                                        <span class="order-number-seq">#@order.OrderNumberSeq</span>
                                        <span class="order-number-date">@order.OrderNumberDate</span>
                                    </a>
                                </td>

                                <td>
                                    @order.ClientName
                                </td>

                                <td>
                                    <partial name="Components/_StatusBadge"
                                             model='new StatusBadgeViewModel
                                             {
                                                 Text = order.StatusDisplay,
                                                 CssClass = $"status-{order.StatusCssClass}"
                                             }' />
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(order.DriverName)
                                                                ? "غير مسند"
                                                                : order.DriverName)
                                </td>

                                <td class="text-muted small">
                                    @order.OrderDate.FormatDateTime()
                                </td>

                                <td>
                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                        عرض
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                لا توجد طلبات مسجلة لهذا المصنع بعد
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </div>

</div>