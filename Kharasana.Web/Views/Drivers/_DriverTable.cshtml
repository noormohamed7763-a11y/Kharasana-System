@using Kharasana.Web.ViewModels.Drivers
@using Kharasana.Web.Models.Components
@using Kharasana.Domain.Enums
@model IEnumerable<DriverListItemViewModel>

<div class="form-card">
    <div class="table-responsive">
        <table class="erp-table erp-table--sticky-cols">
            <thead>
                <tr>
                    <th class="col-index text-nowrap">#</th>
                    <th class="text-nowrap">السائق</th>
                    <th class="text-nowrap">الهاتف</th>
                    <th class="text-nowrap">رقم الرخصة</th>
                    <th class="text-nowrap">الحالة</th>
                    <th class="text-nowrap">الحساب</th>
                    <th class="text-center col-actions col-actions--md text-nowrap">الإجراءات</th>
                </tr>
            </thead>
                    <tbody id="driverTableBody">
                @{
                    // ترقيم متصل عبر الصفحات — يبدأ من ((صفحة-1) × حجم الصفحة) + 1
                    var index = ((int)(ViewData["RowOffset"] ?? 0)) + 1;
                }
                @foreach (var driver in Model)
                {
                    var statusText = driver.DriverStatus switch
                    {
                        DriverStatus.Available => "متاح",
                        DriverStatus.Busy => "مشغول",
                        DriverStatus.Offline => "غير متصل",
                        _ => "-"
                    };
                    var statusCss = driver.DriverStatus switch
                    {
                        DriverStatus.Available => "status-success",
                        DriverStatus.Busy => "status-warning",
                        DriverStatus.Offline => "status-secondary",
                        _ => "status-secondary"
                    };
                    <tr data-status="@driver.DriverStatus">
                        <td class="text-muted fw-bold">@(index++)</td>
                        <td>
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_UserCell.cshtml",
                                new UserCellViewModel
                                {
                                    FullName = driver.FullName,
                                    AvatarCssClass = "avatar-driver"
                                })
                        </td>
                        <td dir="ltr">
                            @await Html.PartialAsync(
                                "~/Views/Shared/Components/_PhoneActions.cshtml",
                                new PhoneActionsViewModel
                                {
                                    Phone = driver.Phone ?? string.Empty,
                                    ContactName = driver.FullName,
                                    ContactLabel = "السائق"
                                })
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(driver.LicenseNumber))
                            {
                                <span class="badge bg-light text-muted">لا توجد رخصة</span>
                            }
                            else
                            {
                                @driver.LicenseNumber
                            }
                        </td>
                        <td>
                            <div class="dropdown">
                                @await Html.PartialAsync(
                                "~/Views/Shared/Components/_StatusBadge.cshtml",
                                                        new StatusBadgeViewModel { Text = statusText, CssClass = statusCss })
                            <button class="btn btn-sm btn-link dropdown-toggle p-0 ms-1"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            </button>
                            <ul class="dropdown-menu">
                                @* الحالات الثلاث الفعلية فقط: `DriverStatus.Unset = 0` قيمة حارسة تعني
                                   «لم تُمرَّر الحالة» في الـ DTO (UserService يسقطها إلى Offline)، وليست
                                   حالة سائق. عرضها هنا كان يتيح اختيارها فيصير السائق بحالة لا يعرضها
                                   الجدول (statusText = "-") ولا تحسبها اللوحة، وبنصّها الإنجليزي. *@
                                @foreach (var status in new[] { DriverStatus.Available, DriverStatus.Busy, DriverStatus.Offline })
                                    {
                                        <li>
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()  <!-- ✅ إضافة رمز الحماية -->
                                                <input type="hidden" name="id" value="@driver.UserId" />
                                                <input type="hidden" name="driverStatus" value="@((int)status)" />
                                                <button type="submit" class="dropdown-item">
                                                    @(status switch
                                                    {
                                                        DriverStatus.Available => "متاح",
                                                        DriverStatus.Busy => "مشغول",
                                                        DriverStatus.Offline => "غير متصل",
                                                        _ => status.ToString()
                                                    })
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(driver.IsActive ? "bg-success" : "bg-secondary")">
                                @(driver.IsActive ? "مُفعّل" : "معطّل")
                            </span>
                        </td>
                        <td class="text-center">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Components/_ActionButtons.cshtml",
                                                new ActionButtonsViewModel
                                                {
                                                    Id = driver.UserId,
                                                    ControllerName = "Drivers",
                                                    ShowDetails = true,
                                                    ShowEdit = true,
                                                    ShowDelete = true
                                                })

                            @* إيقاف/تفعيل حساب السائق — تحديث فوري بدون Modal *@
                            <button type="button"
                                    class="btn btn-light border btn-toggle-active @(driver.IsActive ? "text-danger" : "text-success")"
                                    title="@(driver.IsActive ? "إيقاف السائق" : "تفعيل السائق")"
                                    aria-label="@(driver.IsActive ? "إيقاف السائق" : "تفعيل السائق")"
                                    data-driver-id="@driver.UserId"
                                    data-is-active="@driver.IsActive"
                                    data-bs-toggle="tooltip">
                                <i class="bi @(driver.IsActive ? "bi-stop-circle" : "bi-play-circle")"></i>
                            </button>
                        </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>