@model Kharasana.Web.ViewModels.Drivers.EditDriverViewModel
@using Kharasana.Web.Models.Components

@{
    ViewData["Title"] = "تعديل بيانات السائق";
}

<div class="dashboard-page dashboard-page--narrow">

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-person-gear",
            Title = "تعديل بيانات السائق",
            Description = Model.FullName
        })

    <div class="form-card">
        <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="ProfileImage" />
            <input type="hidden" asp-for="FactoryId" />
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FullName" class="form-label fw-bold"><i class="bi bi-person me-2"></i>الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LicenseNumber" class="form-label fw-bold"><i class="bi bi-card-text me-2"></i>رقم رخصة القيادة</label>
                    <input asp-for="LicenseNumber" class="form-control" placeholder="اختياري" />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-bold"><i class="bi bi-telephone me-2"></i>رقم الهاتف</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" placeholder="اختياري" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-bold"><i class="bi bi-toggle-on me-2"></i>نشط في النظام</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-save me-1"></i> حفظ التعديلات
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                    <i class="bi bi-x-circle me-1"></i> إلغاء
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}