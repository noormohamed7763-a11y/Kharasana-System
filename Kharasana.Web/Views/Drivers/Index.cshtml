@model Kharasana.Web.ViewModels.Drivers.DriversIndexViewModel
@using Kharasana.Web.Models.Components
@using Kharasana.Web.Models.Components.Search

@{
    ViewData["Title"] = "إدارة السائقين";

    // إضافة السائق مقيّدة في DriversController بـ Roles.FactoryEmployee — تُخفى للأدوار الأخرى
    var canCreateDriver = (string?)ViewBag.UserRole == Roles.FactoryEmployee;
}

<div class="dashboard-page">
    @Html.AntiForgeryToken()

    @await Html.PartialAsync(
    "~/Views/Shared/Components/_PageHeader.cshtml",
        new PageHeaderViewModel
        {
            Icon = "bi-truck",
            Title = "إدارة السائقين",
            Description = "عرض وإدارة سائقي المصنع، حالتهم، وبيانات رخصهم.",
            ActionText = canCreateDriver ? "إضافة سائق" : null,
            ActionController = "Drivers",
            ActionMethod = "Create"
        })

    <div class="summary-cards-grid mb-3">
            @await Html.PartialAsync(
            "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "إجمالي السائقين",
                            Value = Model.TotalDrivers.ToString(),
                            Icon = "bi-people",
                            IconClass = "kpi-icon-primary",
                            LinkUrl = Url.Action("Index", "Drivers")
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "متاحون",
                            Value = Model.AvailableDrivers.ToString(),
                            Icon = "bi-person-check",
                            IconClass = "kpi-icon-success",
                            LinkUrl = Url.Action("Index", "Drivers")
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "مشغولون",
                            Value = Model.BusyDrivers.ToString(),
                            Icon = "bi-truck",
                            IconClass = "kpi-icon-warning",
                            LinkUrl = Url.Action("Index", "Drivers")
                        })
            @await Html.PartialAsync(
                        "~/Views/Shared/Components/_SummaryCard.cshtml",
                        new SummaryCardViewModel
                        {
                            Title = "غير متصلين",
                            Value = Model.OfflineDrivers.ToString(),
                            Icon = "bi-power",
                            IconClass = "kpi-icon-neutral",
                            LinkUrl = Url.Action("Index", "Drivers")
                        })
    </div>

    <!-- Status Bar — توزيع حالات السائقين -->
    <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded flex-wrap">
        <span class="text-muted small fw-bold d-flex align-items-center gap-1">
            <i class="bi bi-bar-chart-line"></i> توزيع الحالات
        </span>
        <div class="progress progress--status-bar flex-1">
            <div class="progress-bar bg-success" style="width: @(Model.TotalDrivers > 0 ? (int)((double)Model.AvailableDrivers / Model.TotalDrivers * 100) : 0)%"></div>
            <div class="progress-bar bg-warning" style="width: @(Model.TotalDrivers > 0 ? (int)((double)Model.BusyDrivers / Model.TotalDrivers * 100) : 0)%"></div>
            <div class="progress-bar bg-secondary" style="width: @(Model.TotalDrivers > 0 ? (int)((double)Model.OfflineDrivers / Model.TotalDrivers * 100) : 0)%"></div>
        </div>
        <span class="small"><span class="text-success">●</span> متاح <strong>@Model.AvailableDrivers</strong></span>
        <span class="small"><span class="text-warning">●</span> مشغول <strong>@Model.BusyDrivers</strong></span>
        <span class="small"><span class="text-secondary">●</span> غير متصل <strong>@Model.OfflineDrivers</strong></span>
    </div>

    <!-- Quick Filters — فلاتر سريعة -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <button type="button" class="btn btn-sm btn-outline-primary driver-filter-btn active" data-filter="All">الكل <span class="badge bg-light text-dark">@Model.TotalDrivers</span></button>
        <button type="button" class="btn btn-sm btn-outline-success driver-filter-btn" data-filter="Available">متاح <span class="badge bg-light text-dark">@Model.AvailableDrivers</span></button>
        <button type="button" class="btn btn-sm btn-outline-warning driver-filter-btn" data-filter="Busy">مشغول <span class="badge bg-light text-dark">@Model.BusyDrivers</span></button>
        <button type="button" class="btn btn-sm btn-outline-secondary driver-filter-btn" data-filter="Offline">غير متصل <span class="badge bg-light text-dark">@Model.OfflineDrivers</span></button>
    </div>

    <!-- شريط البحث الموحّد -->
    @await Html.PartialAsync(
        "~/Views/Shared/Components/_ListToolbar.cshtml",
        new ListToolbarViewModel
        {
            PageSize = Model.PageSize,
            Search = new SearchBoxViewModel
            {
                InputId = "search",
                Placeholder = "ابحث بالاسم أو رقم الهاتف",
                Value = Model.Search ?? string.Empty
            }
        })

    @if (Model.PagedDrivers == null || !Model.PagedDrivers.Items.Any())
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Components/_EmptyState.cshtml",
        new EmptyStateViewModel
        {
            ImageUrl = "/images/empty-drivers.png",
            Title = "لا يوجد سائقون لعرضهم حاليًا.",
            Message = "مصنعك جاهز! ابدأ بإضافة سائقينك الأوائل.",
            ShowActionButton = canCreateDriver,
            ActionText = "إضافة سائق"
        })
    }
    else
    {
        ViewData["RowOffset"] = (Model.PageNumber - 1) * Model.PageSize;
        <partial name="_DriverTable" model="Model.PagedDrivers.Items" />
    }

    @if (Model.PagedDrivers != null && Model.PagedDrivers.TotalCount > 0)
    {
        var pageCount = (int)Math.Ceiling(Model.PagedDrivers.TotalCount / (double)Model.PageSize);

        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int p = 1; p <= pageCount; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@p"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@Model.Search">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>